{%- doc -%}
  Divider wrapper for spacing; no visible line (`.divider__line` removed).

  @param {string} id - Unique ID for the divider instance.
  @param {object} settings - Block/section settings (padding via spacing-style; thickness/width settings ignored).
  @param {boolean} [attributes] - When true, renders `block.shopify_attributes` on the container.
{%- enddoc -%}

<div
  class="divider divider-{{ id }} spacing-style"
  style="
    {% render 'spacing-style', settings: settings %}
  "
  {% if attributes %}
    {{- block.shopify_attributes -}}
  {% endif %}
>
</div>

{% stylesheet %}
  .divider {
    align-self: stretch;
  }
{% endstylesheet %}
