{{ 'overflow-list.css' | asset_url | preload_tag: as: 'style' }}
{{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'custom.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'custom-article.css' | asset_url | stylesheet_tag: preload: true }}


<style>
  /*
    Collection + list-collections (all viewports): base color + repeating pattern on main.
    Section surfaces transparent so the wallpaper shows (text still uses scheme foreground vars).
  */
  main.content-for-layout[data-template='list-collections'] {
    background-color: #f4ece6 !important;
    background-image: url({{ 'mobile-bg.png' | asset_url }}) !important;
    background-repeat: repeat !important;
    background-position: top left !important;
  }

  main.content-for-layout[data-template^='collection'] .section-background,
  main.content-for-layout[data-template^='collection'] results-list.product-grid-container {
    background-color: transparent !important;
    background-image: none !important;
  }

  main.content-for-layout[data-template='list-collections'] .section-background,
  main.content-for-layout[data-template='list-collections']
    .section.section-resource-list.custom-list-collections-page {
    background-color: transparent !important;
    background-image: none !important;
  }

  /* Mobile-only: same wallpaper on body for other templates; main stays transparent there */
  @media screen and (max-width: 749px) {
    body,
    body.article-page-bg {
      background-color: #f4ece6;
      background-image: url({{ 'mobile-bg.png' | asset_url }});
      background-repeat: repeat;
      background-position: top left;
    }

    main.content-for-layout {
      background: transparent !important;
    }

    /*
      Blog post (article): section + inner wrapper use flat #f4ece6, which hides the repeating pattern.
      Let the wallpaper show through like other mobile pages.
    */
    body.article-page-bg #MainContent .shopify-section > .section-background,
    body.article-page-bg #MainContent .shopify-section > .section {
      background-color: transparent !important;
      background-image: none !important;
    }

    body.article-page-bg #MainContent .blog-post-article-background {
      background: transparent !important;
    }
  }
</style>
