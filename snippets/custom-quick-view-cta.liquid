<div class="custom-quick-view">
    <div 
      class="custom-quick-view-cta" 
      data-handle="{{ product.handle }}" 
      data-category="{{ product.metafields.custom.category | escape }}"
      data-price="{{ product.price | money_with_currency }}"
    >
        QUICK VIEW
    </div>
</div>

{% style %}
  .custom-quick-view {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 2;
    width: 100%;
  }
  .custom-quick-view-cta {
    padding: 6.4cqw 0;
    margin: 0 21.44cqw 15cqw 21.5cqw;
    text-align: center;
    background: #B7A160;
    color: #ffffff;
  }
{% endstyle %}