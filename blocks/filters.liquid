
{%- doc -%}
  Renders the facet filtering component

  @param {object} results - The search results object
  @param {number} results_size - The number of products in the search results
  @param {object} [filters] - The filters object
{%- enddoc -%}

<script
  src="{{ 'facets.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<script
  src="{{ 'scrolling.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>


{%- liquid
  assign block_settings = block.settings
  assign products_count = results_size
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign filters = filters | default: results.filters
  assign total_active_values = 0
  assign custom_filters_enabled = block_settings.custom_filters_enabled
  assign custom_filters_only = block_settings.custom_filters_only
  assign custom_filters_show_placeholders = block_settings.custom_filters_show_placeholders
  assign custom_type_filter_param = block_settings.custom_type_filter_param | default: 'filter.p.product_type'
  assign custom_color_filter_keyword = block_settings.custom_color_filter_keyword | default: 'color'
  assign custom_material_filter_keyword = block_settings.custom_material_filter_keyword | default: 'material'
  assign custom_artisans_filter_keyword = block_settings.custom_artisans_filter_keyword | default: 'artisan'

  # Calculate facets margin style
  capture facets_margin_style
    echo '--facets-margin: 0px '
    if block_settings.filter_style == 'vertical'
      echo block_settings.facets_margin_right | append: 'px' | append: ' 0px'
    else
      echo ' 0px ' | append: block_settings.facets_margin_bottom | append: 'px'
    endif
    echo ' 0px;'
  endcapture

  for filter in filters
    case filter.type
      when 'price_range'
        if filter.min_value.value != null or filter.max_value.value != null
          assign total_active_values = total_active_values | plus: 1
        endif
      when 'boolean'
        if filter.active_values[0].value
          assign total_active_values = total_active_values | plus: 1
        endif
      else
        assign active_value_count = filter.active_values | size
        assign total_active_values = total_active_values | plus: active_value_count
    endcase
  endfor

  if results.url
    assign results_url = results.url
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif

  assign is_active = false
  assign should_show_pane = true
  if block_settings.filter_style == 'vertical'
    assign should_show_pane = block_settings.enable_filtering
  endif

  assign should_use_select_on_mobile = true
  if block_settings.enable_filtering == false and block_settings.enable_sorting
    assign should_use_select_on_mobile = false
  endif
-%}

{% if block_settings.enable_filtering or block_settings.enable_sorting or block_settings.enable_grid_density %}
  {% if block_settings.filter_style == 'vertical' %}
    {% # These elements are always rendered in the horizontal bar that's why we apply the .facets--horizontal class %}
    <div
      class="facets facets--horizontal facets-controls-wrapper spacing-style"
      style="{% render 'spacing-style', settings: block_settings %}{% if block_settings.text_label_case == 'uppercase' %} --facet-label-transform: uppercase;{% endif %}"
    >
      <h4 class="facets--filters-title">gift picks</h4>

      <div
        class="products-count-wrapper"
        data-testid="products-count"
      >
        <span title="{{ 'content.product_count' | t }}">
          {% if products_count > 25000 %}
            {{- 'content.item_count_cutoff' | t: count: 25000 -}}
          {% else %}
            {{- 'content.item_count' | t: count: products_count -}}
          {% endif %}
        </span>
      </div>

      {% if block_settings.enable_sorting %}
        <div class="mobile:hidden">
          {% render 'sorting',
            results: results,
            sort_by: sort_by,
            filter_style: block_settings.filter_style,
            suffix: 'desktop',
            sort_position: 'desktop',
            should_use_select_on_mobile: false,
            section_id: section.id
          %}
        </div>
      {% endif %}

      
    </div>
  {% endif %}

  <div
    class="
      {% if should_show_pane == false %}
        hidden
      {% endif %}
      facets-block-wrapper
      facets-block-wrapper--{{ block_settings.filter_style }}
      {%- if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}
      {%- if block_settings.filter_width == 'full-width' %} facets-block-wrapper--full-width{% endif %}
    "
    style="
      --grid-column--desktop:
        {%- if block_settings.filter_style == 'horizontal' -%}
          var(--{{ block_settings.filter_width }})
        {%- else -%}
          2 / var(--facets-vertical-col-width)
        {%- endif -%};
      {{ facets_margin_style }}
      --facets-inner-padding-block: {{ block_settings.padding-block-start }}px {{ block_settings.padding-block-end }}px;
      --facets-inner-padding-inline: var(--padding-lg);
    "
    {{ block.shopify_attributes }}
  >
    <div
      class="facets facets--{{ block_settings.filter_style }} spacing-style"
      style="{% render 'spacing-style', settings: block_settings %}{% if block_settings.text_label_case == 'uppercase' %} --facet-label-transform: uppercase;{% endif %}"
      aria-label="{{ 'accessibility.filters' | t }}"
    >
      {% if block_settings.enable_filtering %}
        <h5 class="facets--filters-subtitle">
          {{ 'content.filters' | t | upcase }}
        </h5>

        {% if total_active_values > 0 %}
          <div class="active-filter-badges">
            {%- for filter in filters -%}
              {%- liquid
                assign filter_has_active = false
                assign filter_remove_url = ''
              -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                  {%- assign filter_has_active = true -%}
                  {%- assign filter_remove_url = filter.url_to_remove -%}
                {%- endif -%}
              {%- else -%}
                {%- if filter.active_values.size > 0 -%}
                  {%- assign filter_has_active = true -%}
                  {%- assign filter_remove_url = filter.active_values.first.url_to_remove -%}
                  {%- for value in filter.active_values -%}
                    {%- unless forloop.first -%}
                      {%- assign encoded_val = value.value | url_encode -%}
                      {%- assign param_pair = filter.param_name | append: '=' | append: encoded_val -%}
                      {%- assign filter_remove_url = filter_remove_url | remove: param_pair -%}
                    {%- endunless -%}
                  {%- endfor -%}
                  {%- assign filter_remove_url = filter_remove_url | replace: '&&', '&' | replace: '?&', '?' -%}
                  {%- assign url_last_char = filter_remove_url | slice: -1 -%}
                  {%- if url_last_char == '?' or url_last_char == '&' -%}
                    {%- assign url_length = filter_remove_url | size | minus: 1 -%}
                    {%- assign filter_remove_url = filter_remove_url | truncate: url_length, '' -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endif -%}
              {%- if filter_has_active -%}
                <a class="active-filter-badge" href="{{ filter_remove_url }}" role="button">
                  <span class="active-filter-badge__label">
                    {%- if filter.type == 'price_range' -%}
                      {{ 'content.price_range' | t }}
                    {%- else -%}
                      {{ filter.label | escape }}
                    {%- endif -%}
                  </span>
                  <span class="svg-wrapper svg-wrapper--smaller" aria-hidden="true">
                    {{- 'icon-filters-close.svg' | inline_asset_content -}}
                  </span>
                  <span class="visually-hidden">
                    {{ 'actions.remove' | t }}
                    {%- if filter.type == 'price_range' -%}
                      {{ 'content.price_range' | t }}
                    {%- else -%}
                      {{ filter.label | escape }}
                    {%- endif -%}
                  </span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {% endif %}
      {% endif %}

      <facets-form-component
        class="facets__form-wrapper"
        section-id="{{ section.id }}"
        form-style="{{ block_settings.filter_style }}"
      >
        <form
          action="{{ results_url }}"
          id="FacetFiltersForm--{{ section.id }}-desktop"
          class="facets__form"
          ref="facetsForm"
        >
          {% if should_show_pane %}
            {% if block_settings.enable_filtering %}
              {% assign total_active_values = 0 %}

              {% capture rendered_filters %}
                {%- liquid
                  assign rendered_param_names = '|'
                  if block_settings.filter_style != 'vertical'
                    assign should_render_clear = true
                  else
                    assign should_render_clear = false
                  endif
                  assign custom_rendered_price = false
                  assign custom_rendered_type = false
                  assign custom_rendered_color = false
                  assign custom_rendered_material = false
                  assign custom_rendered_artisans = false
                -%}

                {% if custom_filters_enabled %}
                  {%- comment -%} Price range first {%- endcomment -%}
                  {%- for filter in filters -%}
                    {% if filter.type == 'price_range' %}
                      {%- liquid
                        if filter.min_value.value != null or filter.max_value.value != null
                          assign total_active_values = total_active_values | plus: 1
                          assign is_active = true
                        endif
                        render 'price-filter', filter: filter, filter_style: block_settings.filter_style, should_render_clear: should_render_clear
                        assign rendered_param_names = rendered_param_names | append: filter.param_name | append: '|'
                        assign custom_rendered_price = true
                      -%}
                    {% endif %}
                  {%- endfor -%}

                  {%- comment -%} Type + Color + Material + Artisans (list/swatches) {%- endcomment -%}
                  {%- for filter in filters -%}
                    {%- liquid
                      assign already_rendered = false
                      assign rendered_token = '|' | append: filter.param_name | append: '|'
                      if rendered_param_names contains rendered_token
                        assign already_rendered = true
                      endif
                    -%}
                    {% unless already_rendered %}
                      {%- liquid
                        assign label_downcase = filter.label | downcase
                        assign is_type_filter = false
                        assign is_color_filter = false
                        assign is_material_filter = false
                        assign is_artisans_filter = false

                        if filter.param_name == custom_type_filter_param or filter.param_name contains 'product_type'
                          assign is_type_filter = true
                        endif

                        if filter.param_name contains custom_color_filter_keyword or label_downcase contains custom_color_filter_keyword
                          assign is_color_filter = true
                        endif

                        if filter.param_name contains custom_material_filter_keyword or label_downcase contains custom_material_filter_keyword
                          assign is_material_filter = true
                        endif

                        if filter.param_name contains custom_artisans_filter_keyword or label_downcase contains custom_artisans_filter_keyword
                          assign is_artisans_filter = true
                        endif
                      -%}

                      {% if filter.type != 'price_range' %}
                        {% if is_type_filter or is_color_filter or is_material_filter or is_artisans_filter %}
                          {% liquid
                              if filter.active_values.size > 0
                                assign is_active = true
                              endif
                              assign active_value_count = filter.active_values | size
                              assign total_active_values = total_active_values | plus: active_value_count
                              render 'list-filter', filter: filter, filter_style: block_settings.filter_style, active_value_count: active_value_count, should_render_clear: should_render_clear, show_swatch_label: block_settings.show_swatch_label, sectionId: section.id
                              assign rendered_param_names = rendered_param_names | append: filter.param_name | append: '|'
                              if is_type_filter
                                assign custom_rendered_type = true
                              endif
                              if is_color_filter
                                assign custom_rendered_color = true
                              endif
                              if is_material_filter
                                assign custom_rendered_material = true
                              endif
                              if is_artisans_filter
                                assign custom_rendered_artisans = true
                              endif
                          %}
                        {% endif %}
                      {% endif %}
                    {% endunless %}
                  {%- endfor -%}

                  {% if custom_filters_show_placeholders %}
                    {% unless custom_rendered_price %}
                      <accordion-custom class="facets__item" aria-disabled="true">
                        <details class="facets__panel" open>
                          <summary class="facets__summary">
                            <span class="facets__label">Price Range</span>
                            <span class="svg-wrapper icon-caret icon-animated facets__toggle-icon" aria-hidden="true">
                              <span class="facets__toggle-icon-plus">
                                {{- 'icon-plus.svg' | inline_asset_content -}}
                              </span>
                              <span class="facets__toggle-icon-minus">
                                {{- 'icon-minus.svg' | inline_asset_content -}}
                              </span>
                            </span>
                          </summary>
                          <div class="facets__panel-content details-content" aria-hidden="true">
                            <script
                              src="{{ 'price-range-slider.js' | asset_url }}"
                              type="module"
                              fetchpriority="low"
                            ></script>
                            <link
                              rel="stylesheet"
                              href="{{ 'price-range-slider.css' | asset_url }}"
                              media="all"
                            >

                            <price-facet-component
                              class="price-facet price-facet--slider-ui"
                              data-money-format="{{ shop.money_format | strip_html }}"
                              data-currency="{{ localization.country.currency.iso_code }}"
                              data-currency-symbol="{{ cart.currency.symbol | escape }}"
                            >
                              <div
                                class="price-facet__slider"
                                data-price-range-slider
                                aria-hidden="true"
                              >
                                <div class="price-facet__track">
                                  <span class="price-facet__fill" data-price-range-fill></span>
                                </div>
                                <input
                                  type="range"
                                  class="price-facet__range price-facet__range--min"
                                  data-price-min
                                  aria-label="Minimum price"
                                >
                                <input
                                  type="range"
                                  class="price-facet__range price-facet__range--max"
                                  data-price-max
                                  aria-label="Maximum price"
                                >
                              </div>

                              <div class="price-facet__values" aria-hidden="true">
                                <span class="price-facet__value" data-price-min-label></span>
                                <span class="price-facet__value" data-price-max-label></span>
                              </div>

                              <div class="facets__inputs facets__inputs-wrapper facets__inputs-wrapper--row" style="opacity: 0.8;">
                                <div class="field" style="min-width: 120px;">
                                  <input class="field__input price-facet__input" type="text" inputmode="decimal" placeholder="0" data-min="0" data-max="5000" ref="minInput" autocomplete="off">
                                </div>
                                <div class="field" style="min-width: 120px;">
                                  <input class="field__input price-facet__input" type="text" inputmode="decimal" placeholder="5000" data-min="0" data-max="5000" ref="maxInput" autocomplete="off">
                                </div>
                              </div>
                            </price-facet-component>
                          </div>
                        </details>
                      </accordion-custom>
                    {% endunless %}

                    {% unless custom_rendered_type %}
                      <accordion-custom class="facets__item" aria-disabled="true" data-preview-group="Type">
                        <details class="facets__panel" open>
                          <summary class="facets__summary">
                            <span class="facets__label">Type</span>
                            <span class="svg-wrapper icon-caret icon-animated facets__toggle-icon" aria-hidden="true">
                              <span class="facets__toggle-icon-plus">
                                {{- 'icon-plus.svg' | inline_asset_content -}}
                              </span>
                              <span class="facets__toggle-icon-minus">
                                {{- 'icon-minus.svg' | inline_asset_content -}}
                              </span>
                            </span>
                          </summary>
                          <div class="facets__panel-content details-content" aria-hidden="true" style="opacity: 0.8;">
                            <div class="facets__inputs facets__inputs-wrapper">
                              <ul class="facets__inputs-list list-unstyled"></ul>
                            </div>
                          </div>
                        </details>
                      </accordion-custom>
                    {% endunless %}

                    {% unless custom_rendered_color %}
                      <accordion-custom class="facets__item" aria-disabled="true" data-preview-group="Color">
                        <details class="facets__panel" open>
                          <summary class="facets__summary">
                            <span class="facets__label">Color</span>
                            <span class="svg-wrapper icon-caret icon-animated facets__toggle-icon" aria-hidden="true">
                              <span class="facets__toggle-icon-plus">
                                {{- 'icon-plus.svg' | inline_asset_content -}}
                              </span>
                              <span class="facets__toggle-icon-minus">
                                {{- 'icon-minus.svg' | inline_asset_content -}}
                              </span>
                            </span>
                          </summary>
                          <div class="facets__panel-content details-content" aria-hidden="true" style="opacity: 0.8;">
                            <div class="facets__inputs facets__inputs-wrapper">
                              <ul class="facets__inputs-list list-unstyled"></ul>
                            </div>
                          </div>
                        </details>
                      </accordion-custom>
                    {% endunless %}

                    {% unless custom_rendered_material %}
                      <accordion-custom class="facets__item" aria-disabled="true" data-preview-group="Material">
                        <details class="facets__panel" open>
                          <summary class="facets__summary">
                            <span class="facets__label">Material</span>
                            <span class="svg-wrapper icon-caret icon-animated facets__toggle-icon" aria-hidden="true">
                              <span class="facets__toggle-icon-plus">
                                {{- 'icon-plus.svg' | inline_asset_content -}}
                              </span>
                              <span class="facets__toggle-icon-minus">
                                {{- 'icon-minus.svg' | inline_asset_content -}}
                              </span>
                            </span>
                          </summary>
                          <div class="facets__panel-content details-content" aria-hidden="true" style="opacity: 0.8;">
                            <div class="facets__inputs facets__inputs-wrapper">
                              <ul class="facets__inputs-list list-unstyled"></ul>
                            </div>
                          </div>
                        </details>
                      </accordion-custom>
                    {% endunless %}

                    {% unless custom_rendered_artisans %}
                      <accordion-custom class="facets__item" aria-disabled="true" data-preview-group="Artisans">
                        <details class="facets__panel" open>
                          <summary class="facets__summary">
                            <span class="facets__label">Artisans</span>
                            <span class="svg-wrapper icon-caret icon-animated facets__toggle-icon" aria-hidden="true">
                              <span class="facets__toggle-icon-plus">
                                {{- 'icon-plus.svg' | inline_asset_content -}}
                              </span>
                              <span class="facets__toggle-icon-minus">
                                {{- 'icon-minus.svg' | inline_asset_content -}}
                              </span>
                            </span>
                          </summary>
                          <div class="facets__panel-content details-content" aria-hidden="true" style="opacity: 0.8;">
                            <div class="facets__inputs facets__inputs-wrapper">
                              <ul class="facets__inputs-list list-unstyled"></ul>
                            </div>
                          </div>
                        </details>
                      </accordion-custom>
                    {% endunless %}
                  {% endif %}

                  {% unless custom_filters_only %}
                    {%- for filter in filters -%}
                      {%- liquid
                        assign already_rendered = false
                        assign rendered_token = '|' | append: filter.param_name | append: '|'
                        if rendered_param_names contains rendered_token
                          assign already_rendered = true
                        endif
                      -%}
                      {% unless already_rendered %}
                        {% case filter.type %}
                          {% when 'price_range' %}
                            {%- liquid
                              if filter.min_value.value != null or filter.max_value.value != null
                                assign total_active_values = total_active_values | plus: 1
                                assign is_active = true
                              endif
                              render 'price-filter', filter: filter, filter_style: block_settings.filter_style, should_render_clear: should_render_clear
                            -%}
                          {% else %}
                            {% liquid
                              if filter.active_values.size > 0
                                assign is_active = true
                              endif
                              assign active_value_count = filter.active_values | size
                              assign total_active_values = total_active_values | plus: active_value_count
                              render 'list-filter', filter: filter, filter_style: block_settings.filter_style, active_value_count: active_value_count, should_render_clear: should_render_clear, show_swatch_label: block_settings.show_swatch_label, sectionId: section.id
                            %}
                        {% endcase %}
                      {% endunless %}
                    {%- endfor -%}
                  {% endunless %}
                {% else %}
                  {%- for filter in filters -%}
                    {% case filter.type %}
                      {% when 'price_range' %}
                        {%- liquid
                          if filter.min_value.value != null or filter.max_value.value != null
                            assign total_active_values = total_active_values | plus: 1
                            assign is_active = true
                          endif
                          render 'price-filter', filter: filter, filter_style: block_settings.filter_style, should_render_clear: should_render_clear
                        -%}
                      {% else %}
                        {% liquid
                          if filter.active_values.size > 0
                            assign is_active = true
                          endif
                          assign active_value_count = filter.active_values | size
                          assign total_active_values = total_active_values | plus: active_value_count
                          render 'list-filter', filter: filter, filter_style: block_settings.filter_style, active_value_count: active_value_count, should_render_clear: should_render_clear, show_swatch_label: block_settings.show_swatch_label, sectionId: section.id
                        %}
                    {% endcase %}
                  {%- endfor -%}
                {% endif %}
              {% endcapture %}

              <div class="facets__filters-wrapper">
                {% if block_settings.filter_style == 'horizontal' %}
                  {% liquid
                    assign more_attributes = 'on:click="#filters-drawer/showDialog"'
                    if block_settings.text_label_case == 'uppercase'
                      assign more_attributes = more_attributes | append: ' style="--text-transform: uppercase;"'
                    endif
                  %}
                  {% render 'overflow-list',
                    class: 'facets__overflow-list',
                    children: rendered_filters,
                    more-attributes: more_attributes,
                    minimum-items: 2,
                    data-testid: 'horizontal-filters-overflow-list'
                  %}
                {% else %}
                  {{ rendered_filters }}
                {% endif %}
              </div>

              {% if block_settings.filter_style == 'horizontal' %}
                <facet-remove-component
                  class="facets-horizontal-remove {% if is_active %}facets-horizontal-remove--active{% endif %}"
                  active-class="facets__clear-all-link--active"
                  data-url="{{ results_url }}"
                >
                  <button
                    type="button"
                    class="button-unstyled facets__clear-all-link facets__clear-all-link--horizontal {% if is_active %}facets__clear-all-link--active{% endif %}"
                    ref="clearButton"
                    on:click="/removeFilter?form="
                    on:keydown="/removeFilter?form="
                  >
                    {{- 'actions.clear_all' | t -}}
                  </button>
                </facet-remove-component>
              {% endif %}
            {% endif %}
            {% if block_settings.filter_style == 'horizontal' %}
              <div
                class="products-count-wrapper"
                data-testid="products-count"
              >
                <span title="{{ 'content.product_count' | t }}">
                  {% if products_count > 25000 %}
                    {{- 'content.item_count_cutoff' | t: count: 25000 -}}
                  {% else %}
                    {{- 'content.item_count' | t: count: products_count -}}
                  {% endif %}
                </span>
              </div>

              {% if block_settings.enable_sorting %}
                <div class="mobile:hidden">
                  {% render 'sorting',
                    results: results,
                    sort_by: sort_by,
                    filter_style: block_settings.filter_style,
                    suffix: 'desktop',
                    sort_position: 'desktop',
                    should_use_select_on_mobile: false,
                    section_id: section.id
                  %}
                </div>
              {% endif %}

              
            {% endif %}
          {% endif %}
        </form>
      </facets-form-component>
    </div>
  </div>

  <h4 class="facets-mobile-gift-picks">gift picks</h4>

  <div
    class="facets-toggle{% if block_settings.enable_filtering == false %} facets-toggle--no-filters{% endif %}{% if block_settings.filter_style == 'horizontal' and block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}"
    style="
      --facets-inner-padding-block: {{ block_settings.padding-block-start }}px {{ block_settings.padding-block-end }}px; --facets-inner-padding-inline: var(--padding-lg);
      {{ facets_margin_style }}
    "
  >
    {% if block_settings.enable_sorting %}
      <div class="facets-toggle__sort-wrapper">
        <facets-form-component
          section-id="{{ section.id }}"
          id="FacetFiltersFormMobile--{{ section.id }}"
        >
          <form
            action="{{ results_url }}"
            id="FacetFiltersForm--{{ section.id }}-mobile"
            ref="facetsForm"
          >
            {% render 'sorting',
              results: results,
              sort_by: sort_by,
              filter_style: block_settings.filter_style,
              suffix: 'mobile',
              sort_position: 'mobile',
              should_use_select_on_mobile: false,
              hide_sort_status_on_mobile: true,
              section_id: section.id
            %}
          </form>
        </facets-form-component>
      </div>
    {% endif %}

    {% if block_settings.enable_filtering %}
      <button
        class="facets-toggle__filter-btn"
        on:click="#filters-drawer/showDialog"
        type="button"
      >
        <span class="facets-toggle__filter-text">{{ 'blocks.filter' | t | upcase }}</span>
        <span class="svg-wrapper facets-toggle__filter-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 4h18l-7 9.3V19l-4 2v-7.7L3 4Z" stroke="#686A54" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </span>
      </button>
    {% endif %}

    
  </div>
{% else %}
  <div></div>
{% endif %}

{% if block_settings.enable_filtering %}
  <dialog-component
    id="filters-drawer"
    class="facets-block-wrapper facets-block-wrapper--vertical color-{{ settings.drawer_color_scheme }}"
  >
    <dialog
      ref="dialog"
      class="facets facets--drawer dialog-modal dialog-drawer spacing-style"
      style="{% render 'spacing-style', settings: block_settings %}"
      scroll-lock
      aria-labelledby="filters-drawer-heading"
    >
      {% assign form_component = 'FacetFiltersFormComponent--' | append: section.id | append: '-overflow' %}
      <facets-form-component
        class="facets__form-wrapper facets-drawer__form-wrapper"
        section-id="{{ section.id }}"
        id="{{ form_component }}"
      >
        <form
          action="{{ results_url }}"
          id="FacetFiltersForm--{{ section.id }}-overflow"
          class="facets__form"
          ref="facetsForm"
        >
          <div
            class="facets__title-wrapper"
            style="--color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));"
          >
            <h2
              id="filters-drawer-heading"
              class="facets-drawer__title"
            >
              {{ 'content.filters' | t | upcase }}
            </h2>
            <button
              class="button facets-drawer__close button-unstyled close-button"
              on:click="dialog-component/closeDialog"
              type="button"
            >
              <span
                class="svg-wrapper svg-wrapper--small"
                title="{{ 'actions.close' | t }}"
              >
                {{ 'icon-close.svg' | inline_asset_content }}
              </span>
            </button>
          </div>

          <scroll-hint
            class="facets-drawer__filters"
          >
            {% if block_settings.enable_filtering %}
              {% if total_active_values > 0 %}
                <div class="active-filter-badges active-filter-badges--drawer">
                  {%- for filter in filters -%}
                    {%- liquid
                      assign drawer_badge_active = false
                      assign drawer_badge_url = ''
                    -%}
                    {%- if filter.type == 'price_range' -%}
                      {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                        {%- assign drawer_badge_active = true -%}
                        {%- assign drawer_badge_url = filter.url_to_remove -%}
                      {%- endif -%}
                    {%- else -%}
                      {%- if filter.active_values.size > 0 -%}
                        {%- assign drawer_badge_active = true -%}
                        {%- assign drawer_badge_url = filter.active_values.first.url_to_remove -%}
                        {%- for value in filter.active_values -%}
                          {%- unless forloop.first -%}
                            {%- assign encoded_val = value.value | url_encode -%}
                            {%- assign param_pair = filter.param_name | append: '=' | append: encoded_val -%}
                            {%- assign drawer_badge_url = drawer_badge_url | remove: param_pair -%}
                          {%- endunless -%}
                        {%- endfor -%}
                        {%- assign drawer_badge_url = drawer_badge_url | replace: '&&', '&' | replace: '?&', '?' -%}
                        {%- assign url_last_char = drawer_badge_url | slice: -1 -%}
                        {%- if url_last_char == '?' or url_last_char == '&' -%}
                          {%- assign url_length = drawer_badge_url | size | minus: 1 -%}
                          {%- assign drawer_badge_url = drawer_badge_url | truncate: url_length, '' -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endif -%}
                    {%- if drawer_badge_active -%}
                      <a class="active-filter-badge" href="{{ drawer_badge_url }}" role="button">
                        <span class="active-filter-badge__label">
                          {%- if filter.type == 'price_range' -%}
                            {{ 'content.price_range' | t }}
                          {%- else -%}
                            {{ filter.label | escape }}
                          {%- endif -%}
                        </span>
                        <span class="svg-wrapper svg-wrapper--smaller" aria-hidden="true">
                          {{- 'icon-filters-close.svg' | inline_asset_content -}}
                        </span>
                        <span class="visually-hidden">
                          {{ 'actions.remove' | t }}
                          {%- if filter.type == 'price_range' -%}
                            {{ 'content.price_range' | t }}
                          {%- else -%}
                            {{ filter.label | escape }}
                          {%- endif -%}
                        </span>
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {% endif %}

              <div class="facets__filters-wrapper">
                {% assign total_active_values = 0 %}
                {% assign is_active = false %}

                {% if custom_filters_enabled %}
                  {%- liquid
                    assign rendered_param_names = '|'
                    assign custom_rendered_price = false
                    assign custom_rendered_type = false
                    assign custom_rendered_color = false
                    assign custom_rendered_material = false
                    assign custom_rendered_artisans = false
                  -%}

                  {%- comment -%} Price range first {%- endcomment -%}
                  {%- for filter in filters -%}
                    {% if filter.type == 'price_range' %}
                      {%- liquid
                        if filter.min_value.value != null or filter.max_value.value != null
                          assign total_active_values = total_active_values | plus: 1
                          assign is_active = true
                        endif
                        render 'price-filter', filter: filter, filter_style: 'vertical', should_render_clear: false
                        assign rendered_param_names = rendered_param_names | append: filter.param_name | append: '|'
                        assign custom_rendered_price = true
                      -%}
                    {% endif %}
                  {%- endfor -%}

                  {%- comment -%} Type + Color + Material + Artisans (list/swatches) {%- endcomment -%}
                  {%- for filter in filters -%}
                    {%- liquid
                      assign already_rendered = false
                      assign rendered_token = '|' | append: filter.param_name | append: '|'
                      if rendered_param_names contains rendered_token
                        assign already_rendered = true
                      endif
                    -%}
                    {% unless already_rendered %}
                      {%- liquid
                        assign label_downcase = filter.label | downcase
                        assign is_type_filter = false
                        assign is_color_filter = false
                        assign is_material_filter = false
                        assign is_artisans_filter = false

                        if filter.param_name == custom_type_filter_param or filter.param_name contains 'product_type'
                          assign is_type_filter = true
                        endif

                        if filter.param_name contains custom_color_filter_keyword or label_downcase contains custom_color_filter_keyword
                          assign is_color_filter = true
                        endif

                        if filter.param_name contains custom_material_filter_keyword or label_downcase contains custom_material_filter_keyword
                          assign is_material_filter = true
                        endif

                        if filter.param_name contains custom_artisans_filter_keyword or label_downcase contains custom_artisans_filter_keyword
                          assign is_artisans_filter = true
                        endif
                      -%}

                      {% if filter.type != 'price_range' %}
                        {% if is_type_filter or is_color_filter or is_material_filter or is_artisans_filter %}
                          {% liquid
                            if filter.active_values.size > 0
                              assign is_active = true
                            endif
                            assign active_value_count = filter.active_values | size
                            assign total_active_values = total_active_values | plus: active_value_count
                            render 'list-filter', filter: filter, filter_style: 'vertical', active_value_count: active_value_count, should_render_clear: false, in_drawer: true, sectionId: section.id
                            assign rendered_param_names = rendered_param_names | append: filter.param_name | append: '|'
                            if is_type_filter
                              assign custom_rendered_type = true
                            endif
                            if is_color_filter
                              assign custom_rendered_color = true
                            endif
                            if is_material_filter
                              assign custom_rendered_material = true
                            endif
                            if is_artisans_filter
                              assign custom_rendered_artisans = true
                            endif
                          %}
                        {% endif %}
                      {% endif %}
                    {% endunless %}
                  {%- endfor -%}

                  {% if custom_filters_show_placeholders %}
                    {% unless custom_rendered_price %}
                      <accordion-custom class="facets__item" aria-disabled="true">
                        <details class="facets__panel" open>
                          <summary class="facets__summary">
                            <span class="facets__label">Price range</span>
                            <span class="svg-wrapper icon-caret icon-animated facets__toggle-icon" aria-hidden="true">
                              <span class="facets__toggle-icon-plus">
                                {{- 'icon-plus.svg' | inline_asset_content -}}
                              </span>
                              <span class="facets__toggle-icon-minus">
                                {{- 'icon-minus.svg' | inline_asset_content -}}
                              </span>
                            </span>
                          </summary>
                          <div class="facets__panel-content details-content" aria-hidden="true">
                            <div class="facets__inputs facets__inputs-wrapper facets__inputs-wrapper--row" style="opacity: 0.6; pointer-events: none;">
                              <div class="field" style="min-width: 120px;">
                                <input class="field__input" type="text" inputmode="decimal" placeholder="0" disabled>
                              </div>
                              <div class="field" style="min-width: 120px;">
                                <input class="field__input" type="text" inputmode="decimal" placeholder="0" disabled>
                              </div>
                            </div>
                          </div>
                        </details>
                      </accordion-custom>
                    {% endunless %}

                    {% unless custom_rendered_type %}
                      <accordion-custom class="facets__item" aria-disabled="true">
                        <details class="facets__panel" open>
                          <summary class="facets__summary">
                            <span class="facets__label">Type</span>
                            <span class="svg-wrapper icon-caret icon-animated facets__toggle-icon" aria-hidden="true">
                              <span class="facets__toggle-icon-plus">
                                {{- 'icon-plus.svg' | inline_asset_content -}}
                              </span>
                              <span class="facets__toggle-icon-minus">
                                {{- 'icon-minus.svg' | inline_asset_content -}}
                              </span>
                            </span>
                          </summary>
                          <div class="facets__panel-content details-content" aria-hidden="true" style="opacity: 0.6; pointer-events: none;">
                            <div class="facets__inputs facets__inputs-wrapper">
                              <ul class="facets__inputs-list list-unstyled"></ul>
                            </div>
                          </div>
                        </details>
                      </accordion-custom>
                    {% endunless %}

                    {% unless custom_rendered_color %}
                      <accordion-custom class="facets__item" aria-disabled="true">
                        <details class="facets__panel" open>
                          <summary class="facets__summary">
                            <span class="facets__label">Color</span>
                            <span class="svg-wrapper icon-caret icon-animated facets__toggle-icon" aria-hidden="true">
                              <span class="facets__toggle-icon-plus">
                                {{- 'icon-plus.svg' | inline_asset_content -}}
                              </span>
                              <span class="facets__toggle-icon-minus">
                                {{- 'icon-minus.svg' | inline_asset_content -}}
                              </span>
                            </span>
                          </summary>
                          <div class="facets__panel-content details-content" aria-hidden="true" style="opacity: 0.6; pointer-events: none;">
                            <div class="facets__inputs facets__inputs-wrapper">
                              <ul class="facets__inputs-list list-unstyled"></ul>
                            </div>
                          </div>
                        </details>
                      </accordion-custom>
                    {% endunless %}

                    {% unless custom_rendered_material %}
                      <accordion-custom class="facets__item" aria-disabled="true">
                        <details class="facets__panel" open>
                          <summary class="facets__summary">
                            <span class="facets__label">Material</span>
                            <span class="svg-wrapper icon-caret icon-animated facets__toggle-icon" aria-hidden="true">
                              <span class="facets__toggle-icon-plus">
                                {{- 'icon-plus.svg' | inline_asset_content -}}
                              </span>
                              <span class="facets__toggle-icon-minus">
                                {{- 'icon-minus.svg' | inline_asset_content -}}
                              </span>
                            </span>
                          </summary>
                          <div class="facets__panel-content details-content" aria-hidden="true" style="opacity: 0.6; pointer-events: none;">
                            <div class="facets__inputs facets__inputs-wrapper">
                              <ul class="facets__inputs-list list-unstyled"></ul>
                            </div>
                          </div>
                        </details>
                      </accordion-custom>
                    {% endunless %}

                    {% unless custom_rendered_artisans %}
                      <accordion-custom class="facets__item" aria-disabled="true">
                        <details class="facets__panel" open>
                          <summary class="facets__summary">
                            <span class="facets__label">Artisans</span>
                            <span class="svg-wrapper icon-caret icon-animated facets__toggle-icon" aria-hidden="true">
                              <span class="facets__toggle-icon-plus">
                                {{- 'icon-plus.svg' | inline_asset_content -}}
                              </span>
                              <span class="facets__toggle-icon-minus">
                                {{- 'icon-minus.svg' | inline_asset_content -}}
                              </span>
                            </span>
                          </summary>
                          <div class="facets__panel-content details-content" aria-hidden="true" style="opacity: 0.6; pointer-events: none;">
                            <div class="facets__inputs facets__inputs-wrapper">
                              <ul class="facets__inputs-list list-unstyled"></ul>
                            </div>
                          </div>
                        </details>
                      </accordion-custom>
                    {% endunless %}
                  {% endif %}

                  {% unless custom_filters_only %}
                    {%- for filter in filters -%}
                      {%- liquid
                        assign already_rendered = false
                        assign rendered_token = '|' | append: filter.param_name | append: '|'
                        if rendered_param_names contains rendered_token
                          assign already_rendered = true
                        endif
                      -%}
                      {% unless already_rendered %}
                        {% case filter.type %}
                          {% when 'price_range' %}
                            {%- liquid
                              if filter.min_value.value != null or filter.max_value.value != null
                                assign total_active_values = total_active_values | plus: 1
                                assign is_active = true
                              endif
                              render 'price-filter', filter: filter, filter_style: 'vertical', should_render_clear: false
                            -%}
                          {% else %}
                            {% liquid
                              if filter.active_values.size > 0
                                assign is_active = true
                              endif
                              assign active_value_count = filter.active_values | size
                              assign total_active_values = total_active_values | plus: active_value_count
                              render 'list-filter', filter: filter, filter_style: 'vertical', active_value_count: active_value_count, should_render_clear: false, in_drawer: true, sectionId: section.id
                            %}
                        {% endcase %}
                      {% endunless %}
                    {%- endfor -%}
                  {% endunless %}
                {% else %}
                  {%- for filter in filters -%}
                    {% case filter.type %}
                      {% when 'price_range' %}
                        {%- liquid
                          if filter.min_value.value != null or filter.max_value.value != null
                            assign total_active_values = total_active_values | plus: 1
                            assign is_active = true
                          endif
                          render 'price-filter', filter: filter, filter_style: 'vertical', should_render_clear: false
                        -%}
                      {% else %}
                        {% liquid
                          if filter.active_values.size > 0
                            assign is_active = true
                          endif
                          assign active_value_count = filter.active_values | size
                          assign total_active_values = total_active_values | plus: active_value_count
                          render 'list-filter', filter: filter, filter_style: 'vertical', active_value_count: active_value_count, should_render_clear: false, in_drawer: true, sectionId: section.id
                        %}
                    {% endcase %}
                  {%- endfor -%}
                {% endif %}
              </div>
            {% endif %}

          </scroll-hint>
        </form>
      </facets-form-component>

      <div
        class="facets__drawer-actions"
      >
        <facet-remove-component
          data-url="{{ results_url }}"
          active-class="facets__clear-all--active"
        >
          <button
            type="button"
            class="button-unstyled facets__clear-all facets__clear-all--drawer-btn{% if is_active %} facets__clear-all--active{% endif %}"
            ref="clearButton"
            on:click="/removeFilter?form={{ form_component }}"
            on:keydown="/removeFilter?form={{ form_component }}"
          >
            Clear
          </button>
        </facet-remove-component>

        <button
          class="button facets__see-results facets__see-results--drawer"
          type="button"
          on:click="dialog-component/closeDialog"
        >
          Apply
        </button>
      </div>
    </dialog>
  </dialog-component>
{% endif %}

{% stylesheet %}
  .facets-block-wrapper {
    @media screen and (min-width: 750px) {
      margin: var(--facets-margin);
      grid-column: var(--grid-column--desktop);
    }
.price-facet__value{
  font-size: 16px;
  font-weight: 200;
}
    

  }

  .facets-block-wrapper--vertical {
    @media screen and (min-width: 750px) {
      grid-column: var(--grid-column--desktop);
    }
  }

  /* Prevent empty filter bar from reserving space on mobile (exclude the drawer dialog) */
  div.facets-block-wrapper--horizontal,
  div.facets-block-wrapper--vertical {
    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .facets-toggle {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 24px;
    min-height: var(--minimum-touch-target);
    margin: var(--facets-margin);
    padding-block: var(--facets-inner-padding-block);
    padding-inline: var(--facets-inner-padding-inline);
    width: 100%;
    position: relative;
    z-index: var(--layer-heightened);
    /* sorting-filter__options uses this variable; define it here so mobile dropdown isn't behind product grid */
    --facets-upper-z-index: var(--layer-heightened);

    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  .facets-toggle__sort-wrapper {
    position: relative;
    z-index: var(--layer-heightened);
  }

  /* Ensure the mobile sorting popover renders above product cards */
  .facets-toggle .sorting-filter__options {
    z-index: var(--layer-heightened) !important;
  }

  .facets-toggle__filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-family: Agrandir, var(--font-body--family), sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.18em;
    color: #686A54;
    text-transform: uppercase;
  }

  .facets-toggle__filter-icon {
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
  }

  .facets-toggle__filter-icon svg {
    width: 100%;
    height: 100%;
  }

  .facets-toggle__sort-wrapper .facets__status,
  .facets-toggle .sorting-filter .facets__status {
    display: none !important;
  }

  .facets-toggle .sorting-filter .facets__label {
    font-family: Agrandir, var(--font-body--family), sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #686A54;
    margin: 0;
  }

  .facets-toggle .sorting-filter .facets__summary {
    gap: 8px;
    align-items: center;
    justify-content: flex-start;
  }

  .facets-toggle .sorting-filter .facets__summary .icon-caret {
    color: #686A54;
    opacity: 1;
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
  }

  .facets-toggle .sorting-filter .sorting-filter__options {
    left: 0;
    right: auto;
  }

  .facets-toggle .sorting-filter .facets__panel {
    position: relative;
  }

  .filter-count-bubble {
    position: relative;
    width: 20px;
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    line-height: normal;
    place-content: center;
    color: var(--color-foreground);
    border: var(--icon-stroke-width) solid var(--color-background);
  }

  .facets-mobile__title-wrapper .h3 {
    margin-block-end: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
  }

  .facets-mobile__title-wrapper .filter-count-bubble {
    width: 22px;
    height: 22px;
  }

  .facets-mobile__title-wrapper .filter-count-bubble__text {
    font-size: var(--font-size--xs);
  }

  .filter-count-bubble__background {
    position: absolute;
    inset: 0;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    border-radius: var(--style-border-radius-50);
  }

  .filter-count-bubble__text {
    font-size: 11px;
    font-weight: var(--font-paragraph--weight);
    aspect-ratio: 1 / 1;
  }

  .facets-toggle--no-filters {
    @media screen and (max-width: 749px) {
      justify-content: center;
    }
  }

  .facets-block-wrapper--vertical + .facets-toggle {
    @media screen and (max-width: 749px) {
      margin: 0;
    }
  }

  .facets-mobile-wrapper {
    display: flex;
    align-items: center;
    gap: 20px;
    justify-content: flex-end;
  }

  .facets-mobile-wrapper--multiple-controls {
    justify-content: space-between;
  }

  @media screen and (min-width: 750px) {
    dialog-component.facets-block-wrapper {
      position: absolute;
      width: 0;
      height: 0;
    }
  }

  .facets {
    --facets-form-horizontal-gap: 20px;
    --facets-horizontal-max-input-wrapper-height: 230px;
    --facets-upper-z-index: var(--layer-raised);
    --facets-open-z-index: var(--layer-heightened);
    --facets-sticky-z-index: var(--layer-sticky);
    --facets-panel-min-width: 120px;
    --facets-panel-height: 300px;
    --facets-grid-panel-width: 300px;
    --facets-clear-padding: var(--padding-md);
    --facets-clear-shadow: 0 -4px 14px 0 rgb(var(--color-foreground-rgb) / var(--facets-low-opacity));
    --facets-input-label-color: rgb(var(--color-input-text-rgb) / var(--opacity-60));
    --facets-clear-all-min-width: 120px;
    --facets-see-results-min-width: 55%;
    --facets-mobile-gap: 22px;
    --facets-low-opacity: 10%;
    --facets-hover-opacity: 75%;

    top: auto;
    bottom: 0;
    height: var(--drawer-height);
    max-height: var(--drawer-height);
    width: var(--drawer-width);
    max-width: var(--drawer-max-width);
    box-shadow: none;
    padding-block: 0;

    &.facets--drawer {
      position: fixed;
      top: 0;
      bottom: 0;
      left: auto;
      right: 0;
      margin: 0;
      margin-inline-start: auto;
      height: 100dvh;
      max-height: 100dvh;
    }

    &:not(.facets--drawer) {
      @media screen and (min-width: 750px) {
        padding-inline: var(--padding-inline-start) var(--padding-inline-end);
        width: 100%;
        max-width: 100%;
      }
    }
  }

  .facets--horizontal {
    display: none;

    @media screen and (min-width: 750px) {
      padding-block: var(--padding-block-start) var(--padding-block-end);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      z-index: var(--facets-upper-z-index);
      border: none;
      height: auto;
      top: initial;
      bottom: initial;
      max-height: none;
      width: auto;
      overflow: visible;
    }
  }

  .facets--vertical {
    display: none;

    @media screen and (min-width: 750px) {
      padding-block: 0 var(--padding-block-end);
      display: block;
      position: static;
      top: auto;
      bottom: auto;
      height: auto;
      max-height: none;
      width: auto;
      overflow: visible;
    }
  }

  .facets--drawer {
    border-radius: 0;
    border-right: none;
    border-left: var(--style-border-drawer);
    border-left-color: var(--collection-page-bg, #F4ECE5);
    box-shadow: var(--shadow-drawer);
    padding-inline: 0;
    background-color: var(--collection-page-bg, #F4ECE5);
  }

  /* Side drawer on the right (overrides full-bleed .dialog-modal on small screens) */
  @media screen and (max-width: 749px) {
    .facets.facets--drawer.dialog-modal {
      width: min(var(--drawer-width), 100vw);
      max-width: var(--drawer-max-width);
      padding: 0;
    }
  }

  .facets--drawer[open] {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .facets-drawer__form-wrapper {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .facets-drawer__form-wrapper .facets__form {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .facets-drawer__filters {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    position: relative;
  }

  .facets-drawer__filters .facets__filters-wrapper,
  .facets-drawer__filters .filter-remove-buttons,
  .facets-drawer__filters .sorting-filter-component {
    overflow: visible;
  }

  .facets.facets-controls-wrapper {
    display: none;
    align-items: center;
    @media screen and (min-width: 750px) {
      display: flex;
      grid-column: column-1 / column-12;
      color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
      gap: 0 var(--facets-form-horizontal-gap);
      padding-bottom: 50px;
    }
  }

  /* Push desktop sorting control to the right of the header bar */
  .facets-controls-wrapper .sorting-filter {
    margin-left: auto;
  }

  .facets__inputs {
    display: flex;
    flex-direction: column;
    gap: var(--padding-lg);
    width: 100%;
  }

  :is(.facets--drawer, .facets--vertical) .facets__inputs:not(:has(.show-more)) {
    padding-block-end: var(--padding-sm);
  }

  /* Facets - Form */
  .facets__form-wrapper {
    display: flex;
    flex-direction: column;
    color: var(--color-foreground-muted);
    width: 100%;
  }

  .facets--horizontal .facets__form-wrapper {
    @media screen and (min-width: 750px) {
      flex-direction: row;
      height: auto;
    }
  }

  .facets__form {
    display: flex;
    flex-flow: column;
    width: 100%;
    height: 100%;
  }

  .facets--horizontal .facets__form {
    @media screen and (min-width: 750px) {
      flex-flow: row nowrap;
      height: auto;
    }
  }

  .facets:not(.facets--drawer) .facets__filters-wrapper {
    @media screen and (min-width: 750px) {
      margin-inline-end: var(--margin-md);
    }
  }

  .facets--horizontal .facets__filters-wrapper {
    @media screen and (min-width: 750px) {
      max-width: 60%;
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--gap-xl);
      margin-inline-end: 0;
    }
  }

  :is(.facets--vertical, .facets--drawer) .facets__filters-wrapper {
    border-top: var(--style-border-width) solid var(--color-border);
  }

  /* Facets - Summary */
  .facets__summary {
    --variant-picker-swatch-width: 32px;
    --variant-picker-swatch-height: 32px;
    --icon-opacity: 0.5;

    @media screen and (min-width: 750px) {
      --variant-picker-swatch-width: 26px;
      --variant-picker-swatch-height: 26px;
    }

    font-size: var(--font-h5--size);
    display: flex;
    justify-content: space-between;

    &:hover {
      --icon-opacity: 1;
    }
  }

  .facets__filters-wrapper:hover .facets__summary,
  .facets__filters-wrapper:has(.facets__panel[open]) .facets__summary {
    opacity: var(--facets-hover-opacity);
  }

  .facets__filters-wrapper .facets__summary:hover,
  .facets__filters-wrapper .facets__panel[open] .facets__summary {
    opacity: 1;
  }

  .facets--horizontal .facets__summary {
    @media screen and (min-width: 750px) {
      font-size: var(--font-paragraph--size);
      justify-content: flex-start;
      height: var(--minimum-touch-target);
    }
  }

  .facets__summary .icon-caret {
    height: 16px;
    width: 16px;
    color: rgb(var(--color-foreground-rgb) / var(--icon-opacity));
    margin-block: var(--margin-2xs);
    transition: color var(--animation-speed) var(--animation-easing);
    flex: 0 0 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Plus/minus icons for filter accordions (real SVG icons) */
  .facets__toggle-icon svg {
    display: block;
    width: 16px;
    height: 16px;
  }

  .facets__toggle-icon-minus {
    display: none;
  }

  details[open] > .facets__summary .facets__toggle-icon-plus {
    display: none;
  }

  details[open] > .facets__summary .facets__toggle-icon-minus {
    display: block;
  }

  .sorting-filter .facets__summary .icon-caret,
  .sorting-filter .facets__label-wrapper .icon-caret {
    transition: transform var(--animation-speed) var(--animation-easing);
    transform: rotate(0deg);
  }

  .sorting-filter details[open] > .facets__summary .icon-caret {
    transform: rotate(180deg);
  }

  .facets--drawer .facets__summary .icon-caret {
    margin-inline-start: var(--margin-2xs);
  }

  /* Facets - Bubble */
  .facets__bubble {
    display: inline-flex;
    font-family: var(--font-paragraph--family);
    font-weight: var(--font-paragraph--weight);
    aspect-ratio: 1 / 1;
  }

  /* Facets - Inputs */
  .facets__inputs-wrapper {
    margin-block: var(--padding-xs) var(--padding-xs);
  }

  .facets__inputs .show-more {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    margin-block-end: var(--padding-xl);
  }

  .facets:not(.facets--drawer) .facets__inputs-wrapper {
    @media screen and (min-width: 750px) {
      gap: var(--gap-sm);
    }
  }

  .facets--horizontal .facets__inputs .show-more {
    @media screen and (min-width: 750px) {
      display: contents;
    }
  }

  .facets--horizontal .facets__inputs-wrapper {
    @media screen and (min-width: 750px) {
      max-height: var(--facets-horizontal-max-input-wrapper-height);
      scrollbar-width: none;
      -ms-overflow-style: none;
      overflow-x: auto;
      padding: var(--padding-md);
      margin-block: 0;
    }
  }

  .facets--vertical .facets__inputs:has(.show-more) .facets__inputs-wrapper {
    padding-block: var(--padding-sm);
    padding-inline: var(--padding-sm);
    margin-block: calc(var(--padding-sm) * -1);
    margin-inline: calc(var(--padding-sm) * -1);
  }

  @media screen and (max-width: 749px) {
    .facets__inputs:has(.show-more) .facets__inputs-wrapper {
      padding-block: var(--padding-sm);
      padding-inline: var(--padding-sm);
      margin-block: calc(var(--padding-sm) * -1);
      margin-inline: calc(var(--padding-sm) * -1);
    }
  }

  .facets__inputs-wrapper:not(:has(.facets__inputs-list)),
  .facets__inputs-wrapper .facets__inputs-list {
    display: flex;
    gap: var(--facets-mobile-gap);
    flex-direction: column;

    @media screen and (min-width: 750px) {
      gap: var(--gap-sm);
    }
  }

  @media screen and (min-width: 750px) {
    .facets--vertical .facets__inputs-wrapper .facets__inputs-list--swatches {
      gap: var(--gap-sm);
    }

    .facets--horizontal
      .facets__inputs-wrapper
      .facets__inputs-list--swatches:not(.facets__inputs-list--swatches-grid) {
      display: grid;
      grid-template-columns: repeat(var(--swatch-columns, 4), 1fr);
    }
  }

  .facets__inputs-wrapper .facets__inputs-list--swatches {
    --facets-mobile-gap: var(--gap-sm);
  }

  .facets__inputs-wrapper .facets__inputs-list--grid {
    --min-column-width: 20%;

    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--min-column-width), 1fr));
    gap: 20px;

    @media screen and (min-width: 750px) {
      --min-column-width: 50px;
    }
  }

  .facets-block-wrapper:not(.facets-block-wrapper--vertical) .facets__inputs-list--grid {
    @media screen and (min-width: 750px) {
      width: var(--facets-grid-panel-width);
    }
  }

  .facets__inputs-wrapper--row:not(:has(.facets__inputs-list)),
  .facets__inputs-wrapper--row .facets__inputs-list {
    flex-wrap: wrap;
    flex-direction: row;
  }

  .facets__inputs .show-more__button {
    --show-more-icon-size: 22px;
    --show-more-gap: 8px;

    gap: var(--show-more-gap);

    @media screen and (min-width: 750px) {
      --show-more-icon-size: 16px;
      --show-more-gap: 6px;
    }
  }

  .facets__inputs .show-more__button .icon-plus {
    width: var(--show-more-icon-size);
    height: var(--show-more-icon-size);

    svg {
      width: var(--icon-size-xs);
      height: var(--icon-size-xs);
    }
  }

  /* Facets - Panel */
  .facets__panel {
    padding: 0 var(--drawer-padding);
  }

  /* Extra vertical spacing inside each filter container (above/below label) */
  :is(.facets--drawer, .facets--vertical) :is(.facets__item, .sorting-filter) {
    display: block;
    padding-block: 24px;
    border-radius: 8px;
    padding-inline: var(--drawer-padding);
  }


  .facets:not(.facets--drawer) .facets__panel,
  .facets-controls-wrapper .facets__panel {
    @media screen and (min-width: 750px) {
      padding: 0;
    }
  }

  .facets--horizontal .facets__panel {
    @media screen and (min-width: 750px) {
      position: relative;
    }
  }

  .facets-mobile-wrapper .facets__panel-content {
    border-radius: var(--style-border-radius-popover);
  }

  .facets-mobile-wrapper {
    --facets-upper-z-index: var(--layer-raised);
    --facets-panel-min-width: 120px;
    --facets-panel-height: 300px;
  }

  .facets--horizontal .facets__panel-content {
    @media screen and (min-width: 750px) {
      border-radius: var(--style-border-radius-popover);
      position: absolute;
      top: 100%;
      width: max-content;
      min-width: var(--facets-panel-min-width);
      max-width: var(--facets-panel-width);
      max-height: var(--facets-panel-height);
      z-index: var(--facets-upper-z-index);
      box-shadow: var(--shadow-popover);
      border: var(--style-border-popover);
      background-color: var(--color-background);
      overflow-y: hidden;
      gap: 0;
    }
  }

  /* Use bottom border on filter containers instead of separate separators */
  :is(.facets--drawer, .facets--vertical) :is(.facets__item, .sorting-filter)::before {
    content: none;
  }

  :is(.facets--drawer, .facets--vertical) :is(.facets__item, .sorting-filter) {
    border-bottom: var(--style-border-width) solid var(--color-border);
  }

  @media screen and (min-width: 750px) {
    .facets:not(.facets--drawer) :is(.facets__item, .sorting-filter)::before {
      width: 100%;
    }

    .facets--horizontal .facets__item:not(:first-of-type)::before,
    .facets--horizontal .sorting-filter::before {
      content: none;
    }
  }

  @media screen and (min-width: 750px) {
    .facets--vertical .facets__item:not(:first-of-type)::before,
    .facets--vertical .sorting-filter::before {
      content: '';
    }
  }

  /* Facets - Text */
  .facets__label,
  .facets__clear-all-link,
  .clear-filter {
    text-decoration-color: transparent;
    text-decoration-thickness: 0.075em;
    text-underline-offset: 0.125em;
    transition: text-decoration-color var(--animation-speed) var(--animation-easing);
  }

  .facets__clear-all-link {
    display: none;
    cursor: pointer;
    padding: var(--padding-xs);
    color: var(--button-color);
    transition: text-decoration-color var(--animation-speed) var(--animation-easing),
      color var(--animation-speed) var(--animation-easing);
  }

  .facets__clear-all-link:hover {
    --button-color: var(--color-primary-hover);

    text-decoration: underline;
    text-decoration-color: var(--button-color);
  }

  .facets__clear-all-link--horizontal {
    height: var(--minimum-touch-target);
    padding-inline: var(--facets-form-horizontal-gap);
    min-width: var(--facets-clear-all-min-width);
  }

  .facets__clear-all-link--active {
    display: block;
  }

  .facets__label,
  .products-count-wrapper {
    text-transform: var(--facet-label-transform);
  }

  .clear-filter {
    background-color: transparent;
    box-shadow: none;
    padding: 0;
  }

  .clear-filter:hover {
    text-decoration: underline;
  }

  /* Clear button */
  .facets__clear {
    display: none;
  }

  .facets--horizontal .facets__clear {
    @media screen and (min-width: 750px) {
      width: 100%;
      justify-content: flex-end;
      padding: 0 var(--facets-clear-padding) var(--facets-clear-padding) 0;
      cursor: pointer;
    }
  }

  .facets__clear--active {
    @media screen and (min-width: 750px) {
      display: flex;
    }
  }

  /* Facets - Label */
  .facets__label {
    color: var(--color-foreground);
    cursor: pointer;
    white-space: nowrap;
    font-family: Agrandir, var(--font-body--family), sans-serif;
    font-size: 19px;
    font-weight: 400;
    color: #5D5C5A;

    @media screen and (min-width: 750px) {
      margin-inline-end: var(--margin-2xs);
    }
  }

  /* Products count */
  .products-count-wrapper {
    display: none;
  }

  /* Always hide products count next to sorting */
  .facets--horizontal .products-count-wrapper {
    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  /* Hide grid layout / density controls (mobile + desktop) */
  .facets .column-options-wrapper {
    display: none !important;
  }

  /* Mobile specific components */
  .facets__title-wrapper {
    background-color: var(--collection-page-bg, var(--color-background));
    color: var(--color-foreground);
    position: sticky;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--padding-xs);
    padding-inline-start: var(--drawer-padding);
    padding-inline-end: var(--padding-2xs);
    z-index: var(--facets-sticky-z-index);
  }

  :is(.facets--horizontal, .facets--vertical) .facets__title-wrapper {
    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  .facets-drawer__title {
    margin: 0;
    font-family: Fraunces, var(--font-heading--family), serif;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: #686A54;
  }

  .facets-drawer__close {
    position: relative;
    top: 0;
    right: 0;
    padding: 0;
    cursor: pointer;
  }

  .active-filter-badges--drawer {
    padding-inline: var(--drawer-padding);
    margin-block-start: var(--margin-2xs);
    margin-block-end: var(--margin-sm);
  }

  .facets__clear-all--drawer-btn {
    display: flex !important;
    flex: 1 1 0;
    font-family: Agrandir;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: #5D5C5A;
    background: none;
    border: none;
    border-radius: 0 !important;
    min-width: 0 !important;
    max-width: 100%;
    padding-block: calc(var(--padding-lg) + 4px);
    padding-inline: var(--padding-lg);
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-sizing: border-box;
  }

  .facets__clear-all--drawer-btn:not(.facets__clear-all--active) {
    opacity: 0.4;
    pointer-events: auto;
    width: 140px;
  }

  .facets__see-results--drawer {
    background-color: #686A54;
    color: #fff;
    border: none;
    border-radius: 0 !important;
    flex: 1 1 0;
    min-width: 0 !important;
    max-width: 100%;
    font-family: Agrandir, var(--font-body--family), sans-serif !important;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.12em;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    padding-inline: var(--padding-lg);
    padding-block: calc(var(--padding-lg) + 4px);
    box-sizing: border-box;
  }

  .facets__see-results--drawer:hover {
    background-color: #5a5c48;
  }

  /* Status */
  .facets__status:not(:empty) {
    width: max-content;
    display: flex;
    margin-inline-start: auto;
    font-weight: 500;
    color: var(--color-foreground);
  }

  .facets__panel[open] .facets__status {
    display: none;
  }

  .facets--filters-title {
    margin-block-end: 0;
    color: var(--color-foreground);
    height: fit-content;
    font-family: "SS Bruney", var(--font-heading--family), serif;
    font-size: 48px;
    font-weight: 400;
    color: #686A54;

    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .facets-mobile-gift-picks {
    display: none;
    margin: 0;
    width: 100%;
    text-align: center;
    font-family: "SS Bruney", var(--font-heading--family), serif !important;
    font-size: 32px;
    font-weight: 400;
    color: #686A54;
    line-height: 1.1;

    @media screen and (max-width: 749px) {
      display: block;
      padding-block-start: 2px;
      padding-block-end: 4px;
    }
  }

  .facets--filters-subtitle {
    margin-block-start: var(--padding-sm);
    margin-block-end: var(--padding-xs);
    font-family: Fraunces, var(--font-heading--family), serif;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-foreground);
  }

   .active-filter-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-block-start: 20px;
    padding-block-end: var(--margin-sm);
    margin-block-end: var(--margin-md);
  }

  .active-filter-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    background-color: white;
    border-radius: 999px;
    font-family: var(--font-body--family), sans-serif;
    font-size: 14px;
    line-height: 1.4;
    cursor: pointer;
    border: none;
    color: var(--color-foreground);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .active-filter-badge:hover {
    opacity: 0.7;
  }

  .active-filter-badge .svg-wrapper {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }

  .facets:not(.facets--horizontal):not(.facets--drawer) .facets-remove--mobile-and-vertical {
    display: none !important;
  }

  .facets--horizontal .facets__panel .facets__status:has(:not(:empty)) {
    @media screen and (min-width: 750px) {
      display: flex;
      margin-inline-start: var(--margin-xs);
      margin-inline-end: var(--margin-xs);
    }
  }

  /* Horizontal filter style */
  .facets--horizontal .facets__form {
    @media screen and (min-width: 750px) {
      gap: 0 var(--facets-form-horizontal-gap);
    }
  }

  /* Facets - Actions */
  .facets__drawer-actions {
    --to-top-gradient-background: linear-gradient(
      to top,
      rgb(var(--collection-page-bg-rgb, var(--color-background-rgb)) / var(--opacity-90)),
      rgb(var(--collection-page-bg-rgb, var(--color-background-rgb)) / var(--opacity-80)),
      rgb(var(--collection-page-bg-rgb, var(--color-background-rgb)) / var(--opacity-40)),
      transparent
    );

    position: sticky;
    bottom: 0;
    z-index: var(--facets-sticky-z-index);
    order: 1;
    display: flex;
    flex-shrink: 0;
    justify-content: space-between;
    align-items: stretch;
    gap: 16px;
    padding-block-start: var(--padding-xs);
    padding-block-end: var(--padding-md);
    padding-inline: var(--drawer-padding, var(--padding-lg));
    margin-top: auto;
    background-image: var(--to-top-gradient-background);
    background-color: var(--collection-page-bg, var(--color-background));
    box-sizing: border-box;
    width: 100%;
    overflow: hidden;
  }

  /* The Clear button is wrapped in <facet-remove-component>, which is the flex item. */
  .facets__drawer-actions > facet-remove-component {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
  }

  .facets__drawer-actions > facet-remove-component .facets__clear-all--drawer-btn {
    width: 100%;
    max-width: 100%;
  }

  /* Clear all button */
  .facets__clear-all {
    display: none;
    cursor: pointer;
    min-width: var(--facets-clear-all-min-width);
    flex-grow: 1;
    padding-block: var(--padding-lg);
    color: var(--button-color, inherit);
  }

  .facets__clear-all--active {
    display: block;
    opacity: 1;
    transform: translateY(0);
    transition: transform var(--animation-values), opacity var(--animation-values);
  }

  @starting-style {
    .facets__clear-all--active {
      opacity: 0;
      transform: translateY(100%);
    }
  }

  .facets__see-results {
    min-width: var(--facets-see-results-min-width);
    flex-grow: 1;
    padding-block: var(--padding-lg);
  }

  .facets-horizontal-remove {
    display: flex;
    align-items: center;
  }

  .facets-horizontal-remove--active::before {
    content: '';
    border-inline-start: var(--style-border-width) solid var(--color-border);
    height: var(--font-paragraph--size);
    position: absolute;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.filters",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:settings.enable_filtering",
      "info": "t:info.enable_filtering_info",
      "default": false
    },
    {
      "type": "select",
      "id": "filter_style",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "horizontal",
