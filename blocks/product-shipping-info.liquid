        </svg>
        <div>
            Enjoy flat rate shipping of $9.95
        </div>
    </div>
</div>

{% style %}
.product-shipping-info {
    border: 1px solid #0C0C0D1A;
    padding: 25px;
    display: flex;
    flex-direction: column;
    gap: 10px;

    font-family: Agrandir;
    font-weight: 400;
    font-style: Regular;
    font-size: 14px;
    leading-trim: NONE;
    line-height: 100%;
    letter-spacing: 0%;
    vertical-align: middle;

}
  .product-shipping-info .shipping_info {
    display: grid;
    grid-template-columns: 20px 1fr;
    align-items: center;
    gap: 10px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Shipping Info",
  "tag": null,
