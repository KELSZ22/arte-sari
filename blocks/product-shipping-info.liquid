            <path d="M21 18H23" stroke="#5D5C5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M18.36 11.6407L19.78 10.2207" stroke="#5D5C5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M23 22H1" stroke="#5D5C5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M8 6L12 2L16 6" stroke="#5D5C5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div>
            Ready to ship. Receive in 3-5 business days
        </div>
    </div>
    <div class="shipping_info">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M16 3H1V16H16V3Z" stroke="#5D5C5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M16 8H20L23 11V16H16V8Z" stroke="#5D5C5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M5.5 21C6.88071 21 8 19.8807 8 18.5C8 17.1193 6.88071 16 5.5 16C4.11929 16 3 17.1193 3 18.5C3 19.8807 4.11929 21 5.5 21Z" stroke="#5D5C5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
