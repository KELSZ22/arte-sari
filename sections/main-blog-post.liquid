

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section color-{{ section.settings.color_scheme }}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      blog-post-article-background
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% liquid
      assign hero_image = section.settings.header_image
      if hero_image == blank
        assign hero_image = article.image
      endif
    %}
    {%- if hero_image != blank -%}
      <header class="blog-post-hero">
        {{
          hero_image
          | image_url: width: 2200
          | image_tag:
            class: 'blog-post-hero__image',
            widths: '750, 1100, 1500, 1780, 2000, 2200',
            sizes: '100vw',
            loading: 'eager'
        }}
        <div class="blog-post-hero__overlay">
          <div class="blog-post-hero__content">
            <h1 class="custom-artisan-title">ARTISAN</h1>
            <h2 class="custom-artisan-subtitle">The Genius of Christian Cera</h2>
          </div>
        </div>
      </header>
    {%- else -%}
      <header>
        {%- content_for 'block', id: 'blog-post-title', type: 'text' %}
        {%- content_for 'block', id: 'blog-post-details', type: '_blog-post-info-text' %}
      </header>
    {%- endif -%}

    {%- if article.image and hero_image == blank -%}
      {%- content_for 'block', id: 'blog-post-image', type: '_blog-post-featured-image' %}
    {%- endif -%}

    {% liquid
      assign article_category = article.tags.first
      if article_category == blank
        assign article_category = blog.title
      endif
      assign article_url = shop.url | append: article.url
      assign article_share_instagram_url = section.settings.article_share_instagram_url | default: settings.social_instagram_link
    %}
    <div class="blog-post-meta-bar">
      <div class="blog-post-meta-bar__item">
        <span class="blog-post-meta-bar__label">Date</span>
        <span class="blog-post-meta-bar__value">{{ article.published_at | date: '%m.%d.%y' }}</span>
      </div>
      <div class="blog-post-meta-bar__item">
        <span class="blog-post-meta-bar__label">Category</span>
        <span class="blog-post-meta-bar__value">{{ article_category | upcase }}</span>
      </div>
      <div class="blog-post-meta-bar__item">
        <span class="blog-post-meta-bar__label">Share this story</span>
        <div class="blog-post-meta-bar__share-links">
          <a
            href="https://www.facebook.com/sharer/sharer.php?u={{ article_url | url_encode }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on Facebook"
            class="blog-post-meta-bar__share-link blog-post-meta-bar__share-link--facebook"
          >
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
              <path
                d="M14 9h3V6h-3c-2.21 0-4 1.79-4 4v2H7v3h3v6h3v-6h3l1-3h-4v-2c0-.55.45-1 1-1Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </a>
          <a
            href="{{ article_share_instagram_url | default: 'https://instagram.com' }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit Instagram"
            class="blog-post-meta-bar__share-link"
          >
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
              <rect x="3.5" y="3.5" width="17" height="17" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
              <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
              <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor"></circle>
            </svg>
          </a>
        </div>
      </div>
    </div>
    {%- content_for 'block', id: 'blog-post-content', type: '_blog-post-content' %}

    {% liquid
      comment
        Shopify names the blog post object `article` in Liquid; it is the current blog post.
      endcomment
      assign blog_post_featured_product = blank
      assign featured_mf = article.metafields.custom.featured_product
      if featured_mf != blank
        assign blog_post_featured_product = featured_mf.value
        if featured_mf.list?
          assign blog_post_featured_product = featured_mf.value.first
        endif
      endif
      if blog_post_featured_product == blank
        assign blog_fp_mf = blog.metafields.custom.featured_product
        if blog_fp_mf != blank
          assign blog_post_featured_product = blog_fp_mf.value
          if blog_fp_mf.list?
            assign blog_post_featured_product = blog_fp_mf.value.first
          endif
        endif
      endif
      comment
        Metafields missing in admin: tag the blog post feat_<handle> (product URL slug).
      endcomment
      if blog_post_featured_product == blank
        for tag in article.tags
          assign feat_prefix = tag | slice: 0, 5
          if feat_prefix == 'feat_'
            assign feat_handle = tag | remove_first: 'feat_'
            if feat_handle != blank
              assign blog_post_featured_product = all_products[feat_handle]
              if blog_post_featured_product != blank
                break
              endif
            endif
          endif
        endfor
      endif
      if blog_post_featured_product == blank
        assign blog_post_featured_product = section.settings.article_featured_product_fallback
      endif
    %}
    {% if section.settings.show_article_featured_product %}
      {% render 'custom-article-featured-product',
        featured_product: blog_post_featured_product,
        blog_post: article,
        instagram_url: section.settings.article_share_instagram_url
      %}
    {% endif %}

    {% comment %} Dynamic area for @app blocks only, at the bottom {% endcomment %}
    {% content_for 'blocks' %}

    {% if blog.comments_enabled? %}
      <div class="blog-post-comments-container">
        <h2 class="h3">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

        <div class="blog-post-comments">
          {% paginate article.comments by 10 %}
            {% for comment in article.comments %}
              <div class="blog-post-comment">
                {{ comment.content }}
                <div class="blog-post-comment__author">
                  <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                  <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                  <span class="blog-post-comment__date">
                    {{- comment.created_at | time_tag: format: 'date' -}}
                  </span>
                </div>
              </div>
            {% endfor %}

            <div class="blog-post-comments-pagination">
              {{- paginate | default_pagination -}}
            </div>
          {% endpaginate %}
        </div>

        {% render 'blog-comment-form', article: article, section_id: section.id %}
      </div>
    {% endif %}
  </div>
</div>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% stylesheet %}
  .blog-post-article-background {
    background: #f4ece6;
  }

  .blog-post-hero {
    position: relative;
    width: 100%;
    min-height: 400px;
    margin-bottom: var(--margin-xl);
    overflow: hidden;
  }

  .blog-post-hero__image {
    width: 100%;
    height: 100%;
    min-height: 400px;
    max-height: 560px;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .blog-post-hero__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    gap: var(--gap-2xs);
    text-align: left;
    padding-inline: 0;
    padding-left: clamp(1.25rem, 8vw, 7rem);
    padding-block: var(--padding-xl);
    background: none;
  }

  .blog-post-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    width: fit-content;
    max-width: 100%;
    transform: translateX(50px);
  }

  .blog-post-hero__overlay .custom-artisan-title,
  .blog-post-hero__overlay .custom-artisan-subtitle {
    margin: 0;
    color: #f4ece6;
    text-align: start !important;
  }

  .blog-post-hero__overlay .custom-artisan-title :is(h1, h2, h3, h4, h5, h6, p, span),
  .blog-post-hero__overlay .custom-artisan-subtitle :is(h1, h2, h3, h4, h5, h6, p, span) {
    text-align: start !important;
  }

  .blog-post-hero__overlay .custom-artisan-subtitle {
    max-width: none;
    white-space: nowrap;
  }

  .blog-post-comments-container {
    width: 100%;
    max-width: var(--normal-content-width);
    margin: 0 auto;
  }

  .blog-post-meta-bar {
    width: 100%;
    max-width: var(--normal-content-width);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-lg);
    padding: 0;
    margin: 0 auto;
  }

  .blog-post-meta-bar__item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .blog-post-meta-bar__label {
    font-family: "Agrandir", var(--font-body--family), sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 70%);
  }

  .blog-post-meta-bar__value {
    font-size: 1.125rem;
    line-height: 1.2;
  }

  .blog-post-meta-bar__share-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .blog-post-meta-bar__share-links a {
    color: inherit;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .blog-post-meta-bar__share-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 1.5rem;
  }

  .blog-post-meta-bar__share-link svg {
    width: 1.5rem;
    height: 1.5rem;
    display: block;
    fill: none;
    stroke: currentColor;
  }

  .blog-post-meta-bar__share-link--facebook svg {
    width: 1.65rem;
    height: 1.65rem;
    transform: translateY(-0.9px);
  }

  .blog-post-meta-bar__item:last-child {
    align-items: flex-end;
    text-align: right;
  }

  .blog-post-meta-bar__share-links a:hover {
    text-decoration: underline;
  }

  .blog-post-comments {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .blog-post-comment__author {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin-top: var(--margin-md);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-comments-pagination {
    display: flex;
    justify-content: center;
    gap: var(--gap-2xs);
  }

  .blog-post-comments-pagination,
  .blog-post-comments-pagination a {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a {
    display: block;
    padding: var(--padding-2xs) var(--padding-xs);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a:hover {
    border-bottom: 1px solid var(--color-foreground);
  }

  @media screen and (max-width: 749px) {
    .blog-post-hero,
    .blog-post-hero__image {
      min-height: 280px;
    }

    .blog-post-hero__overlay {
      width: 100%;
      padding-inline: 0;
      padding-left: 0;
      align-items: center;
      justify-content: center;
      padding-bottom: 0;
      background: none;
    }

    .blog-post-hero__content {
      transform: translateX(0);
      width: min(90%, 320px);
      align-items: flex-start;
      justify-content: center;
      margin: 0 auto;
      text-align: start;
      height: 100%;
    }

    .blog-post-hero__overlay .custom-artisan-subtitle {
      white-space: normal;
    }

    .blog-post-meta-bar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
      padding: 0;
    }

    .blog-post-meta-bar__item:last-child {
      align-items: flex-start;
      text-align: left;
    }

    .blog-post-meta-bar__share-links {
      justify-content: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "header_image",
      "label": "Header image"
    },
    {
      "type": "header",
      "content": "Featured product (below blog post)"
    },
    {
      "type": "paragraph",
      "content": "Per blog post: add tag feat_<product-handle> (example: feat_linens-tote). Handle = last part of the product’s admin URL. Or metafield custom.featured_product (Blog posts) under Settings → Custom data → Blog posts (pin definition if needed)."
    },
    {
      "type": "paragraph",
      "content": "If no tag or metafield, Fallback product below applies to every blog post."
    },
    {
      "type": "checkbox",
      "id": "show_article_featured_product",
      "label": "Show featured product card",
      "default": true
    },
    {
      "type": "product",
      "id": "article_featured_product_fallback",
      "label": "Fallback product"
    },
    {
      "type": "url",
      "id": "article_share_instagram_url",
      "label": "Instagram profile URL (share row)",
      "info": "Shown next to Facebook under the product card. Leave blank to hide the Instagram icon."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
