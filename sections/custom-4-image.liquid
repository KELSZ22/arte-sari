{% schema %}
{
  "name": "Genuine Connections",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color (fallback)",
      "default": "#f0ebe3"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LET'S MAKE GENUINE CONNECTIONS"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "@artesari.shop"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "grid_item",
      "name": "Grid Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image Alt Text",
          "default": "Grid image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Genuine Connections",
      "blocks": [
        { "type": "grid_item" },
        { "type": "grid_item" },
        { "type": "grid_item" },
        { "type": "grid_item" }
      ]
    }
  ]
}
{% endschema %}

<style>
  .gc-section {
    position: relative;
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
    overflow: hidden;
  }
  .gc-section__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 0;
  }
  .gc-section__inner {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    padding-right: 0px;
  }
  .gc-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .gc-header__title {
    font-family: 'Facelio';
    font-size: 48px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #3a3530;
    margin: 0;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .gc-header__line {
    flex: 1;
    height: 1.5px;
    background-color: #3a3530;
    min-width: 20px;
  }
  .gc-header__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #B7A160;
    color: #ffffff;
    font-family: 'Agrandir';
    font-size: 20px;
    letter-spacing: 0.05em;
    padding: 4px 20px;
    border-radius: 50px;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background-color 0.2s ease, transform 0.15s ease;
    border: none;
    cursor: pointer;
  }
  .gc-header__btn:hover {
    background-color: #a08e50;
    transform: translateY(-1px);
  }
  .gc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .gc-grid__item {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0;
    box-shadow:
    0px 4px 4px -4px rgba(12, 12, 13, 0.05),
    0px 16px 32px -4px rgba(12, 12, 13, 0.10);
  }
  .gc-grid__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
    transition: transform 0.4s ease;
  }
  .gc-grid__item:hover img {
    transform: scale(1.04);
  }
  .gc-grid__placeholder {
    width: 100%;
    height: 100%;
    background-color: #d8d0c4;
    border-radius: 0;
  }
  @media (max-width: 768px) {
    .gc-header {
      gap: 10px;
      display: block;
    }
    .gc-header__title {
      font-size: 28px;
      white-space: normal;
    }
    .gc-header__line {
      display: none;
    }
    .gc-header__btn {
      font-size: 11px;
      padding: 7px 13px;
      margin-top: 20px;
    }
    .gc-grid {
      display: none;
    }
    .gc-carousel {
      display: block;
    }
  }
  @media (max-width: 480px) {
    .gc-header__title {
      font-size: 28px;
      letter-spacing: 0.06em;
    }
  }
  @media (min-width: 769px) {
    .gc-carousel {
      display: none;
    }
  }
  .gc-carousel {
    position: relative;
    overflow: hidden;
  }
  .gc-carousel__track-wrapper {
    overflow: hidden;
  }
  .gc-carousel__track {
    display: flex;
    gap: 10px;
    transition: transform 0.4s ease;
    will-change: transform;
  }
  .gc-carousel__slide {
    flex: 0 0 calc(78% - 5px);
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0;
    box-shadow:
      0px 4px 4px -4px rgba(12, 12, 13, 0.05),
      0px 16px 32px -4px rgba(12, 12, 13, 0.10);
  }
  .gc-carousel__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }
  .gc-carousel__placeholder {
    width: 100%;
    height: 100%;
    background-color: #d8d0c4;
    border-radius: 0;
  }
  .gc-carousel__dots {
    display: none;
    justify-content: center;
    gap: 6px;
    margin-top: 14px;
  }
  .gc-carousel__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #c8bfb4;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .gc-carousel__dot.is-active {
    background-color: #3a3530;
    transform: scale(1.3);
  }
</style>

<section class="gc-section" id="gc-section-{{ section.id }}">
  {% if section.settings.background_image != blank %}
    <div class="gc-section__bg" style="background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');"></div>
  {% endif %}
  <div class="gc-section__inner">
    <div class="gc-header">
      <h2 class="gc-header__title">{{ section.settings.heading }}</h2>
      <div class="gc-header__line"></div>
      {% if section.settings.button_label != blank %}
        <a class="gc-header__btn" href="{{ section.settings.button_url | default: '#' }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>

    <div class="gc-grid">
      {% for block in section.blocks %}
        {% if block.type == 'grid_item' %}
          <div class="gc-grid__item" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.alt | escape }}" loading="lazy" width="600" height="600">
            {% else %}
              <div class="gc-grid__placeholder"></div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="gc-carousel" id="gc-carousel-{{ section.id }}">
      <div class="gc-carousel__track-wrapper">
        <div class="gc-carousel__track" id="gc-track-{{ section.id }}">
          {% for block in section.blocks %}
            {% if block.type == 'grid_item' %}
              <div class="gc-carousel__slide">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.alt | escape }}" loading="lazy" width="600" height="600">
                {% else %}
                  <div class="gc-carousel__placeholder"></div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="gc-carousel__dots" id="gc-dots-{{ section.id }}">
        {% for block in section.blocks %}
          {% if block.type == 'grid_item' %}
            <button class="gc-carousel__dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}"></button>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var track = document.getElementById('gc-track-' + sectionId);
  var dotsContainer = document.getElementById('gc-dots-' + sectionId);

  if (!track) return;

  var slides = track.querySelectorAll('.gc-carousel__slide');
  var dots = dotsContainer ? dotsContainer.querySelectorAll('.gc-carousel__dot') : [];
  var current = 0;
  var startX = 0;
  var isDragging = false;
  var dragDelta = 0;

  function getSlideWidth() {
    if (!slides[0]) return 0;
    return slides[0].offsetWidth + 10;
  }

  function goTo(index) {
    if (index < 0) index = 0;
    if (index >= slides.length) index = slides.length - 1;
    current = index;
    track.style.transform = 'translateX(-' + (current * getSlideWidth()) + 'px)';
    dots.forEach(function(d, i) {
      d.classList.toggle('is-active', i === current);
    });
  }

  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      goTo(parseInt(this.getAttribute('data-index')));
    });
  });

  track.addEventListener('touchstart', function(e) {
    startX = e.touches[0].clientX;
    isDragging = true;
    dragDelta = 0;
    track.style.transition = 'none';
  }, { passive: true });

  track.addEventListener('touchmove', function(e) {
    if (!isDragging) return;
    dragDelta = e.touches[0].clientX - startX;
    track.style.transform = 'translateX(' + (-current * getSlideWidth() + dragDelta) + 'px)';
  }, { passive: true });

  track.addEventListener('touchend', function() {
    isDragging = false;
    track.style.transition = 'transform 0.4s ease';
    if (dragDelta < -50) {
      goTo(current + 1);
    } else if (dragDelta > 50) {
      goTo(current - 1);
    } else {
      goTo(current);
    }
  });
})();
</script>