{% liquid
  assign slide_count = 0
  for block in section.blocks
    if block.type == 'slide'
      assign slide_count = slide_count | plus: 1
    endif
  endfor
%}

<div
  id="HeroSlider-{{ section.id }}"
  class="hero-slider color-{{ section.settings.color_scheme }}"
  data-hero-slider
  data-autoplay-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
  data-autoplay-enabled="{{ section.settings.enable_autoplay }}"
  style="
    --hero-slider-height: {{ section.settings.slider_height }}vh;
    --hero-slider-height-mobile: {{ section.settings.slider_height_mobile }}vh;
  "
>
  <div class="hero-slider__wrapper">
    <div class="hero-slider__slides" data-slider-track>
      {% assign slide_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          <div
            class="hero-slider__slide{% if slide_index == 0 %} hero-slider__slide--active{% endif %}"
            data-slide="{{ slide_index }}"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag: loading: 'lazy', class: 'hero-slider__image hero-slider__image--desktop', alt: block.settings.image.alt
              }}
            {% else %}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero-slider__image hero-slider__image--desktop' }}
            {% endif %}

            {% if block.settings.image_mobile != blank %}
              {{
                block.settings.image_mobile
                | image_url: width: 1200
                | image_tag: loading: 'lazy', class: 'hero-slider__image hero-slider__image--mobile', alt: block.settings.image_mobile.alt
              }}
            {% elsif block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', class: 'hero-slider__image hero-slider__image--mobile', alt: block.settings.image.alt
              }}
            {% else %}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero-slider__image hero-slider__image--mobile' }}
            {% endif %}

            {% if block.settings.overlay_opacity > 0 %}
              <div
                class="hero-slider__overlay"
                style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
              ></div>
            {% endif %}
          </div>
          {% assign slide_index = slide_index | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>

    <div class="hero-slider__content-wrapper {{ section.settings.section_width }}">
      {% for block in section.blocks %}
        {% if block.type == 'paper_overlay' %}
          {% liquid
            assign heading_font_family = block.settings.heading_font_family
            assign subheading_font_family = block.settings.subheading_font_family
            assign button_font_family = block.settings.button_font_family

            if heading_font_family == 'agrandir'
              assign heading_font_family_value = 'Agrandir'
            elsif heading_font_family == 'ss-bruney'
              assign heading_font_family_value = 'SS Bruney'
            elsif heading_font_family == 'facelio'
              assign heading_font_family_value = 'Facelio'
            elsif heading_font_family == 'fraunces'
              assign heading_font_family_value = 'var(--font-heading-family)'
            else
              assign heading_font_family_value = 'inherit'
            endif

            if subheading_font_family == 'agrandir'
              assign subheading_font_family_value = 'Agrandir'
            elsif subheading_font_family == 'ss-bruney'
              assign subheading_font_family_value = 'SS Bruney'
            elsif subheading_font_family == 'facelio'
              assign subheading_font_family_value = 'Facelio'
            elsif subheading_font_family == 'fraunces'
              assign subheading_font_family_value = 'var(--font-heading-family)'
            else
              assign subheading_font_family_value = 'inherit'
            endif

            if button_font_family == 'agrandir'
              assign button_font_family_value = 'Agrandir'
            elsif button_font_family == 'ss-bruney'
              assign button_font_family_value = 'SS Bruney'
            elsif button_font_family == 'facelio'
              assign button_font_family_value = 'Facelio'
            elsif button_font_family == 'fraunces'
              assign button_font_family_value = 'var(--font-heading-family)'
            else
              assign button_font_family_value = 'inherit'
            endif
          %}
          <div
            class="hero-slider__paper-overlay"
            {{ block.shopify_attributes }}
            style="
              --paper-max-width: {{ block.settings.max_width }}px;
              --paper-max-width-mobile: {{ block.settings.max_width_mobile }}px;
              --heading-font-family: {{ heading_font_family_value }};
              --subheading-font-family: {{ subheading_font_family_value }};
              --button-font-family: {{ button_font_family_value }};
            "
          >
            {% if block.settings.paper_image != blank %}
              {{
                block.settings.paper_image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', class: 'hero-slider__paper-image hero-slider__paper-image--desktop', alt: block.settings.paper_image.alt
              }}
            {% endif %}

            {% if block.settings.paper_image_mobile != blank %}
              {{
                block.settings.paper_image_mobile
                | image_url: width: 800
                | image_tag: loading: 'lazy', class: 'hero-slider__paper-image hero-slider__paper-image--mobile', alt: block.settings.paper_image_mobile.alt
              }}
            {% elsif block.settings.paper_image != blank %}
              {{
                block.settings.paper_image
                | image_url: width: 800
                | image_tag: loading: 'lazy', class: 'hero-slider__paper-image hero-slider__paper-image--mobile', alt: block.settings.paper_image.alt
              }}
            {% endif %}

            <div class="hero-slider__paper-content">
              {% if block.settings.heading != blank %}
                <h2
                  class="hero-slider__heading {{ block.settings.heading_size }}"
                  style="
                    font-family: var(--heading-font-family);
                    font-size: {{ block.settings.heading_font_size }}px;
                    font-weight: {{ block.settings.heading_font_weight }};
                    {% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }};{% endif %}
                  "
                >
                  {{ block.settings.heading }}
                </h2>
              {% endif %}

              {% if block.settings.subheading != blank %}
                <p
                  class="hero-slider__subheading"
                  style="
                    font-family: var(--subheading-font-family);
                    font-size: {{ block.settings.subheading_font_size }}px;
                    font-weight: {{ block.settings.subheading_font_weight }};
                    {% if block.settings.subheading_color != blank %}color: {{ block.settings.subheading_color }};{% endif %}
                  "
                >
                  {{ block.settings.subheading }}
                </p>
              {% endif %}

              {% if block.settings.button_label != blank %}
                
                <a  href="{{ block.settings.button_link }}"
                  class="hero-slider__button button button--{{ block.settings.button_style }}"
                  style="
                    font-family: var(--button-font-family);
                    font-size: {{ block.settings.button_font_size }}px;
                    font-weight: {{ block.settings.button_font_weight }};
                    {% if block.settings.button_color != blank %}color: {{ block.settings.button_color }};{% endif %}
                  "
                  {% if block.settings.button_link == blank %}
                    role="link" aria-disabled="true"
                  {% endif %}
                >
                  {{ block.settings.button_label }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if slide_count > 1 %}
      <div class="hero-slider__dots" data-slider-dots>
        {% assign dot_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'slide' %}
            <button
              type="button"
              class="hero-slider__dot{% if dot_index == 0 %} hero-slider__dot--active{% endif %}"
              data-slide-to="{{ dot_index }}"
              aria-label="Go to slide {{ dot_index | plus: 1 }}"
            >
              <span class="visually-hidden">Slide {{ dot_index | plus: 1 }}</span>
            </button>
            {% assign dot_index = dot_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.show_arrows and slide_count > 1 %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  @font-face {
    font-family: 'Agrandir';
    src: url('https://cdn.shopify.com/s/files/1/0728/1321/5942/files/Agrandir-Regular.woff2?v=1771643523')
      format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'SS Bruney';
    src: url('https://cdn.shopify.com/s/files/1/0728/1321/5942/files/SS_Bruney.woff2?v=1771643523') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Facelio';
    src: url('https://cdn.shopify.com/s/files/1/0728/1321/5942/files/Facelio.woff2?v=1771643523') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  .hero-slider {
    display: block;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .hero-slider__wrapper {
    position: relative;
    height: var(--hero-slider-height-mobile);
    min-height: 700px;
  }

  @media screen and (min-width: 750px) {
    .hero-slider__wrapper {
      height: var(--hero-slider-height);
    }
  }

  .hero-slider__slides {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-slider__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
    pointer-events: none;
    z-index: 1;
  }

  .hero-slider__slide--active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-slider__image {
    width: 100%;
    height: 100%;
    object-fit: fill;
    object-position: center;
    background-size: cover;
  }

  .hero-slider__image--desktop {
    display: none;
  }

  .hero-slider__image--mobile {
    display: block;
  }

  @media screen and (min-width: 750px) {
    .hero-slider__image--desktop {
      display: block;
    }

    .hero-slider__image--mobile {
      display: none;
    }
  }

  .hero-slider__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgb(var(--color-foreground));
    pointer-events: none;
  }

  .hero-slider__content-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    width: 100%;
    max-width: 100%;
    padding: 0 2rem;
    pointer-events: none;
  }

  .hero-slider__content-wrapper.page-width {
    max-width: var(--page-width);
  }

  .hero-slider__paper-overlay {
    position: relative;
    margin: 0 auto;
    max-width: var(--paper-max-width);
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .hero-slider__paper-overlay {
      max-width: var(--paper-max-width-mobile);
    }
  }

  .hero-slider__paper-image {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
  }

  .hero-slider__paper-image--desktop {
    display: none;
  }

  .hero-slider__paper-image--mobile {
    display: block;
    height: 750px;
  }

  @media screen and (min-width: 750px) {
    .hero-slider__paper-image--desktop {
      display: block;
    }

    .hero-slider__paper-image--mobile {
      display: none;
    }
  }

  .hero-slider__paper-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 85%;
    padding: 2rem 1rem;
    pointer-events: auto;
  }

  .hero-slider__heading {
    margin: 0 0 1rem;
    color: rgb(var(--color-foreground));
  }

  .hero-slider__heading.h0 {
    font-size: 3rem;
    line-height: 1.2;
  }

  .hero-slider__heading.h1 {
    font-size: 2.5rem;
    line-height: 1.2;
    max-width: 700px;
    margin: auto;
  }

  .hero-slider__heading.h2 {
    font-size: 2rem;
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .hero-slider__heading.h0 {
      font-size: 2rem;
    }

    .hero-slider__heading.h1 {
      font-size: 1.75rem;
    }

    .hero-slider__heading.h2 {
      font-size: 1.5rem;
    }
  }

  .hero-slider__subheading {
    margin: 0 0 1.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground));
  }

  .hero-slider__button {
    display: flex;
    width: 220px;
    height: 47px;
    padding: 0 16px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    background: #686a54;
    margin: 0 auto;
    border-radius: 0;
    pointer-events: auto;
  }

  .hero-slider__dots {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.75rem;
    z-index: 4;
    pointer-events: auto;
  }

  .hero-slider__dot {
    position: relative;
    z-index: 1;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #969696;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
    pointer-events: auto;
  }

  .hero-slider__dot:hover {
    background: rgba(255, 255, 255, 0.8);
    transform: scale(1.2);
  }

  .hero-slider__dot--active {
    background: #B7A160;
    transform: scale(1.3);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  @media screen and (max-width: 768px) {
    .hero-slider__content-wrapper {
      padding: 0px;
    }

    .hero-slider__paper-overlay {
    margin-left: -40px;
    }

    .hero-slider__paper-content {
      left: 54%;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    function HeroSlider(root) {
      this.root = root;
      if (!this.root) return;

      if (this.root.__heroSliderInstance) {
        this.root.__heroSliderInstance.destroy();
      }

      this.slides = Array.from(this.root.querySelectorAll('[data-slide]'));
      this.dots = Array.from(this.root.querySelectorAll('[data-slide-to]'));
      this.dotsContainer = this.root.querySelector('[data-slider-dots]');
      this.prevButton = this.root.querySelector('[data-slider-prev]');
      this.nextButton = this.root.querySelector('[data-slider-next]');
      this.currentSlide = 0;
      this.autoplayInterval = null;
      this.touchStartX = 0;
      this.touchEndX = 0;

      this.autoplayDelay = parseInt(this.root.getAttribute('data-autoplay-delay'), 10) || 5000;
      this.autoplayEnabled = this.root.getAttribute('data-autoplay-enabled') === 'true';

      for (var i = 0; i < this.slides.length; i++) {
        if (this.slides[i].classList.contains('hero-slider__slide--active')) {
          this.currentSlide = i;
          break;
        }
      }

      var self = this;
      this._onDotClick = function (e) { self.handleDotClick(e); };
      this._onPrevClick = function () { self.prevSlide(); };
      this._onNextClick = function () { self.nextSlide(); };
      this._onKeydown = function (e) { self.handleKeydown(e); };
      this._onMouseEnter = function () { self.stopAutoplay(); };
      this._onMouseLeave = function () { self.startAutoplay(); };
      this._onTouchStart = function (e) { self.touchStartX = e.changedTouches[0].screenX; };
      this._onTouchEnd = function (e) {
        self.touchEndX = e.changedTouches[0].screenX;
        var diff = self.touchStartX - self.touchEndX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) { self.nextSlide(); } else { self.prevSlide(); }
        }
      };

      this.init();
    }

    HeroSlider.prototype.init = function () {
      if (this.slides.length === 0) return;

      this.syncUI(this.currentSlide);

      if (this.dotsContainer) {
        this.dotsContainer.addEventListener('click', this._onDotClick);
      }

      if (this.prevButton) this.prevButton.addEventListener('click', this._onPrevClick);
      if (this.nextButton) this.nextButton.addEventListener('click', this._onNextClick);

      this.root.setAttribute('tabindex', '0');
      this.root.addEventListener('keydown', this._onKeydown);

      if (this.autoplayEnabled && this.slides.length > 1) {
        this.startAutoplay();
        this.root.addEventListener('mouseenter', this._onMouseEnter);
        this.root.addEventListener('mouseleave', this._onMouseLeave);
      }

      this.root.addEventListener('touchstart', this._onTouchStart, { passive: true });
      this.root.addEventListener('touchend', this._onTouchEnd, { passive: true });
    };

    HeroSlider.prototype.destroy = function () {
      this.stopAutoplay();
      if (this.dotsContainer) this.dotsContainer.removeEventListener('click', this._onDotClick);
      if (this.prevButton) this.prevButton.removeEventListener('click', this._onPrevClick);
      if (this.nextButton) this.nextButton.removeEventListener('click', this._onNextClick);
      this.root.removeEventListener('keydown', this._onKeydown);
      this.root.removeEventListener('mouseenter', this._onMouseEnter);
      this.root.removeEventListener('mouseleave', this._onMouseLeave);
      this.root.removeEventListener('touchstart', this._onTouchStart);
      this.root.removeEventListener('touchend', this._onTouchEnd);
      this.root.__heroSliderInstance = null;
    };

    HeroSlider.prototype.handleDotClick = function (event) {
      var dot = event.target.closest('[data-slide-to]');
      if (!dot || !this.root.contains(dot)) return;
      event.preventDefault();
      var index = parseInt(dot.getAttribute('data-slide-to'), 10);
      if (!isNaN(index)) this.goToSlide(index);
    };

    HeroSlider.prototype.handleKeydown = function (event) {
      if (event.key === 'ArrowLeft') this.prevSlide();
      if (event.key === 'ArrowRight') this.nextSlide();
    };

    HeroSlider.prototype.goToSlide = function (index) {
      if (index < 0 || index >= this.slides.length) return;
      if (index === this.currentSlide) return;
      this.currentSlide = index;
      this.syncUI(index);
      if (this.autoplayEnabled) {
        this.stopAutoplay();
        this.startAutoplay();
      }
    };

    HeroSlider.prototype.syncUI = function (activeIndex) {
      for (var i = 0; i < this.slides.length; i++) {
        var isActive = i === activeIndex;
        this.slides[i].classList.toggle('hero-slider__slide--active', isActive);
        this.slides[i].style.zIndex = isActive ? '2' : '1';
        this.slides[i].setAttribute('aria-hidden', isActive ? 'false' : 'true');
      }
      for (var j = 0; j < this.dots.length; j++) {
        var dotActive = j === activeIndex;
        this.dots[j].classList.toggle('hero-slider__dot--active', dotActive);
        this.dots[j].setAttribute('aria-current', dotActive ? 'true' : 'false');
      }
    };

    HeroSlider.prototype.nextSlide = function () {
      this.goToSlide((this.currentSlide + 1) % this.slides.length);
    };

    HeroSlider.prototype.prevSlide = function () {
      this.goToSlide((this.currentSlide - 1 + this.slides.length) % this.slides.length);
    };

    HeroSlider.prototype.startAutoplay = function () {
      if (!this.autoplayEnabled || this.slides.length <= 1) return;
      var self = this;
      this.autoplayInterval = setInterval(function () {
        self.nextSlide();
      }, self.autoplayDelay);
    };

    HeroSlider.prototype.stopAutoplay = function () {
      if (this.autoplayInterval) {
        clearInterval(this.autoplayInterval);
        this.autoplayInterval = null;
      }
    };

    function initSlider(container) {
      var roots = container.querySelectorAll ? Array.from(container.querySelectorAll('[data-hero-slider]')) : [];
      if (container.hasAttribute && container.hasAttribute('data-hero-slider')) {
        roots = [container];
      }
      roots.forEach(function (el) {
        el.__heroSliderInstance = new HeroSlider(el);
      });
    }

    function destroySlider(container) {
      var roots = container.querySelectorAll ? Array.from(container.querySelectorAll('[data-hero-slider]')) : [];
      if (container.hasAttribute && container.hasAttribute('data-hero-slider')) {
        roots = [container];
      }
      roots.forEach(function (el) {
        if (el.__heroSliderInstance && typeof el.__heroSliderInstance.destroy === 'function') {
          el.__heroSliderInstance.destroy();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { initSlider(document); }, { once: true });
    } else {
      initSlider(document);
    }

    document.addEventListener('shopify:section:load', function (e) { initSlider(e.target || document); });
    document.addEventListener('shopify:section:unload', function (e) { destroySlider(e.target || document); });
  })();
</script>

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "hero-slider-wrapper section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "range",
      "id": "slider_height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Slider height (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "slider_height_mobile",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Slider height (mobile)",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay delay",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "",
          "label": "Full width"
        },
        {
          "value": "page-width",
          "label": "Page width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "scheme-1",
          "label": "Scheme 1"
        },
        {
          "value": "scheme-2",
          "label": "Scheme 2"
        },
        {
          "value": "scheme-3",
          "label": "Scheme 3"
        }
      ],
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Background image (mobile)",
          "info": "Shown on screens below 750px. Falls back to desktop image if not set."
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Overlay opacity",
          "default": 0
        }
      ]
    },
    {
      "type": "paper_overlay",
      "name": "Paper Overlay",
