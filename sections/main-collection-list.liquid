

{% liquid
  assign section_collections = collections
  assign max_items = 20
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    custom-list-collections-page
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  <div class="section-resource-list__content">
    {%- content_for 'blocks' -%}
  </div>

  {% render 'custom-shop-by-collections', section: section %}

  {% if section_collections == null %}
    {% for i in (1..max_items) %}
      {% assign section_collections = section_collections | append: ', ' %}
    {% endfor %}

    {% assign section_collections = section_collections | split: ',' %}
  {% endif %}

  {% capture list_items %}
    {% for collection in section_collections limit: max_items %}
      <div class="resource-list__item" data-collection-handle="{{ collection.handle }}">
        {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: collection %}
      </div>
      {% unless forloop.last %}
        <!--@list/split-->
      {% endunless %}
    {% endfor %}
  {% endcapture %}

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    carousel_ref: 'mainCollectionList',
    slide_count: max_items,
    content_type: 'collections',
    test_id: 'collections-list-grid'
  %}

  {% if section.settings.enable_shop_all_button %}
    {% liquid
      assign shop_all_href = section.settings.shop_all_link
      if shop_all_href == blank
        assign shop_all_href = routes.all_products_collection_url
      endif
      assign shop_all_label = section.settings.shop_all_label | strip
      if shop_all_label == blank
        assign shop_all_label = 'SHOP ALL'
      endif
    %}
    <div class="custom-list-collections-shop-all">
      <a href="{{ shop_all_href }}" class="custom-list-collections-shop-all__btn">
        {{- shop_all_label | escape -}}
      </a>
    </div>
  {% endif %}
</div>

{% if section.settings.enable_shop_by %}
  <script src="{{ 'custom-shop-by-collections.js' | asset_url }}" defer></script>
{% endif %}

{% stylesheet %}
  @font-face {
    font-family: 'SS Bruney';
    src: url('https://cdn.shopify.com/s/files/1/0728/1321/5942/files/SS_Bruney.woff2?v=1771643523') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  .custom-list-collections-page .custom-list-collections-heading h1 {
    font-family: 'SS Bruney', sans-serif;
    font-size: 48px;
  }

  .custom-list-collections-page .custom-list-collections-intro,
  .custom-list-collections-page .custom-list-collections-intro :is(p, span) {
    font-family: Fraunces, var(--font-body--family), serif;
    font-size: 20px;
  }

  /* White frame on the image only, inset 10px from image edges */
  .custom-list-collections-page .collection-card__image {
    position: relative;
  }

  .custom-list-collections-page .collection-card__image::after {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid #ffffff;
    border-radius: inherit;
    pointer-events: none;
    z-index: 2;
  }

  .custom-list-collections-page .collection-card__content .text-block,
  .custom-list-collections-page .collection-card__content .text-block :is(p, span, a) {
    font-family: Fraunces, var(--font-body--family), serif;
    font-size: 20px;
    text-transform: uppercase;
  }

  .custom-list-collections-page .custom-shop-by-collections {
    --shop-by-accent: #4e5c2e;

    display: flex;
    justify-content: flex-start;
    width: 100%;
    margin-block-end: 0;
  }

  .custom-list-collections-page > .resource-list {
    margin-block-start: calc(var(--gap, 12px) * -0.45);
  }

  .custom-list-collections-page .custom-shop-by-collections__trigger {
    position: relative;
    display: inline-block;
    width: max-content;
    max-width: 100%;
  }

  .custom-list-collections-page .custom-shop-by-collections__label {
    position: relative;
    z-index: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.35rem 0.15rem;
    font-family: var(--font-body--family), system-ui, sans-serif;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--shop-by-accent);
    cursor: pointer;
    user-select: none;
  }

  .custom-list-collections-page .custom-shop-by-collections__label-text {
    pointer-events: none;
  }

  .custom-list-collections-page .custom-shop-by-collections__chevron {
    display: flex;
    flex-shrink: 0;
    color: var(--shop-by-accent);
    pointer-events: none;
  }

  .custom-list-collections-page .custom-shop-by-collections__select {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    width: 100%;
    height: 100%;
    min-height: 2.75rem;
    cursor: pointer;
    opacity: 0;
    border: none;
    background: transparent;
    font-size: 1rem;
    appearance: none;
    -webkit-appearance: none;
  }

  .custom-list-collections-page .custom-shop-by-collections__trigger:focus-within {
    outline: 2px solid var(--shop-by-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .custom-list-collections-page .custom-shop-by-collections__select:focus {
    outline: none;
  }

  .custom-list-collections-page .custom-shop-by-collections__select option {
    color: var(--color-foreground);
    background-color: var(--color-background);
  }

  .custom-list-collections-page .custom-list-collections-shop-all {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
  }

  .custom-list-collections-page .custom-list-collections-shop-all__btn {
    display: inline-block;
    box-sizing: border-box;
    min-width: min(100%, 17.5rem);
    padding: 0.875rem clamp(2rem, 6vw, 5rem);
    background-color: #5b634e;
    color: #ffffff;
    font-family: var(--font-body--family), system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    border-radius: 0;
    border: none;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .custom-list-collections-page .custom-list-collections-shop-all__btn:hover {
    opacity: 0.93;
  }

  .custom-list-collections-page .custom-list-collections-shop-all__btn:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .custom-list-collections-page .custom-shop-by-collections {
      justify-content: flex-end;
    }

    .custom-list-collections-page .custom-list-collections-heading.spacing-style {
      --padding-block-end: 0px !important;
    }

    .custom-list-collections-page .custom-list-collections-heading h1 {
      font-size: 32px;
    }

    .custom-list-collections-page .custom-list-collections-intro,
    .custom-list-collections-page .custom-list-collections-intro :is(p, span) {
      font-size: 16px;
    }

    .custom-list-collections-page .collection-card__content .text-block,
    .custom-list-collections-page .collection-card__content .text-block :is(p, span, a) {
      font-size: 16px;
    }

    .custom-list-collections-page .collection-card .collection-card__content.layout-panel-flex--column {
      align-items: flex-start;
    }

    .custom-list-collections-page .collection-card__content .text-block {
      align-items: flex-start;
    }

    .custom-list-collections-page .collection-card__content .text-block > * {
      text-align: left;
    }

    .custom-list-collections-page .custom-shop-by-collections__label {
      font-size: 14px;
    }

    .custom-list-collections-page .custom-list-collections-shop-all {
      margin-block-start: clamp(1.75rem, 6vw, 2.75rem);
    }

    .custom-list-collections-page .custom-list-collections-shop-all__btn {
      font-size: 0.75rem;
      padding: 0.65rem 1.25rem;
      min-width: 0;
      max-width: 11rem;
      width: fit-content;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_list",
  "class": "ui-test-collection-list",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.cards_layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        },
        {
          "value": "bento",
          "label": "t:options.bento"
        },
        {
          "value": "editorial",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "bento_gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'bento' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid'}}"
    },
    {
      "type": "range",
      "id": "max_collections",
      "label": "t:settings.collection_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type == 'editorial' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Shop by"
    },
    {
      "type": "checkbox",
      "id": "enable_shop_by",
      "label": "Enable Shop by filters",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_by_heading",
      "label": "Shop by heading",
      "default": "SHOP BY"
    },
    {
      "type": "link_list",
      "id": "shop_by_menu",
      "label": "Shop by menu",
      "info": "Parent item = filter label. Add nested links to collections to group them. Top-level collection links work as single-collection filters."
    },
    {
      "type": "textarea",
      "id": "shop_by_groups",
      "label": "Shop by groups (fallback)",
      "info": "If no menu is selected: one line per group. Format: Label|handle-one,handle-two. Handles must match collection URLs."
    },
    {
      "type": "color",
      "id": "shop_by_accent_color",
      "label": "Label and icon color",
      "default": "#4e5c2e"
    },
    {
      "type": "header",
      "content": "Shop all button"
    },
    {
      "type": "checkbox",
      "id": "enable_shop_all_button",
      "label": "Show Shop all button",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Button label",
      "default": "SHOP ALL"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Button link",
      "info": "Leave empty to use the store’s All products collection."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
