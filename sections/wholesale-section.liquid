{% schema %}
  {
    "name": "Wholesale Section",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "WhoLeSaLe"
      },
      {
        "type": "textarea",
        "id": "subtext",
        "label": "Subtext",
        "default": "Arte Sari offers wholesale partnerships for gifting, retail, and specialty collections. If you'd like to carry our products in your store or place bulk orders, we'd be delighted to work with you for bulk pricing and share Filipino artistry to your community."
      },
      {
        "type": "text",
        "id": "email_recipient",
        "label": "Recipient Email",
        "default": "artesari.wfa@gmail.com"
      },
      {
        "type": "product",
        "id": "gift_box_product",
        "label": "Gift box product",
        "info": "Image appears in the GIFT BOX accordion (featured, variant, or first gallery image). If the product has no image, use Gift box image below."
      }, {
        "type": "image_picker",
        "id": "gift_box_image",
        "label": "Gift Box Image (fallback if no product)",
        "info": "Shown when no product is selected, or the product has no image. You can use this alone without a product."
      },
      {
        "type": "checkbox",
        "id": "gift_box_hide_label",
        "label": "Hide product name under gift box image",
        "default": false,
        "info": "Turn on for image only, or when the product title includes a price you do not want shown."
      },
      {
        "type": "text",
        "id": "gift_box_custom_label",
        "label": "Custom label under image (optional)",
        "info": "Shown instead of the product title. Use for a short name with no price."
      },
      {
        "type": "header",
        "content": "Background"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "default": "#F4ECE6"
      },
      {
        "type": "checkbox",
        "id": "show_background_pattern",
        "label": "Show repeating background pattern",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Custom pattern image",
        "info": "Optional tile image. When empty, the Arte Sari default pattern asset is used."
      }
    ],
    "presets": [
      {
        "name": "Wholesale Section"
      }
    ]
  }
{% endschema %}

<style>
  .as-wholesale-section {
    background-repeat: repeat;
    background-size: auto;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    font-family: 'Georgia'
    , serif;
    position: relative;
  }

  .as-wholesale-bg-pattern {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .as-wholesale-bg-pattern svg {
    position: absolute;
    opacity: 0.18;
  }

  .as-wholesale-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1040px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .as-wholesale-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: stretch;
    width: 100%;
    gap: 28px;
    margin-bottom: 60px;
  }

  .as-wholesale-heading {
    font-size: 48px;
    letter-spacing: 2%;
    color: #686A54;
    font-weight: 400;
    text-transform: none;
    margin: 0;
    font-family: 'SS Bruney';
  }

  .as-wholesale-subtext {
    font-size: 20px;
    color: #686A54;
    text-align: center;
    max-width: 100%;
    width: 100%;
    box-sizing: border-box;
    line-height: 1.65;
    margin: 0 0 32px;
    font-family: 'Fraunces';
  }

  .as-wholesale-accordions {
    position: relative;
    width: 100%;
    margin-bottom: 28px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid #d6cfc8;
    border-radius: 4px;
    overflow: hidden;
    background: transparent;
  }

  .as-wholesale-accordions::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgba(255, 255, 255, 0.65);
    pointer-events: none;
    border-radius: inherit;
  }

  .as-wholesale-accordion {
    position: relative;
    z-index: 1;
    border-bottom: 1px solid #d6cfc8;
  }

  .as-wholesale-accordion:nth-child(odd) {
    border-right: 1px solid #d6cfc8;
  }

  .as-wholesale-accordion:nth-last-child(-n + 2) {
    border-bottom: none;
  }

  .as-wholesale-accordion-trigger {
    width: 100%;
    background: none;
    border: none;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-family: 'Agrandir';
    font-size: 20px;
    letter-spacing: 0.1em;
    color: #B7A160;
    text-transform: uppercase;
    text-align: left;
  }

  .as-wholesale-accordion-trigger span.as-wholesale-acc-icon {
    font-size: 24px;
    font-weight: 300;
    color: #686A54;
    line-height: 1;
    flex-shrink: 0;
  }

  .as-wholesale-accordion-body {
    display: none;
    padding: 4px 16px 16px;
    font-size: 13px;
    color: #686A54;
    font-family: 'Fraunces';
    line-height: 1.6;
  }

  .as-wholesale-accordion-body.open {
    display: block;
  }

  .as-wholesale-accordion-body img {
    max-width: 120px;
    margin-top: 10px;
    display: block;
    opacity: 1;
  }

  .as-wholesale-gift-box-copy {
    font-size: 16px;
    margin: 0;
  }

  .as-wholesale-gift-product {
    display: inline-block;
    margin-top: 12px;
    max-width: 200px;
    text-decoration: none;
    color: inherit;
  }

  .as-wholesale-gift-product:focus-visible {
    outline: 2px solid #B7A160;
    outline-offset: 2px;
  }

  .as-wholesale-gift-product__image {
    width: 100%;
    max-width: 120px;
    height: auto;
    display: block;
    border-radius: 4px;
    opacity: 1;
  }

  .as-wholesale-gift-product__title {
    display: block;
    margin-top: 8px;
    font-family: 'Agrandir'
    , sans-serif;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: #686A54;
    text-transform: uppercase;
    line-height: 1.35;
  }

  .as-wholesale-gift-product:hover .as-wholesale-gift-product__title {
    color: #B7A160;
  }

  #gift-box .price,
  #gift-box product-price,
  #gift-box .price__container,
  #gift-box .product-card__price {
    display: none !important;
  }

  .as-wholesale-card {
    background: rgba(255, 255, 255, 0.65);
    border-radius: 4px;
    padding: 36px 40px 40px;
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
    box-shadow: 0 2px 16px rgba(104, 106, 84, 0.07);
    box-sizing: border-box;
  }

  .as-wholesale-field {
    margin-bottom: 18px;
    display: flex;
    flex-direction: column;
  }

  .as-wholesale-field label {
    font-size: 16px;
    color: #1e1e1e;
    margin-bottom: 6px;
    font-family: 'Agrandir';
    font-weight: 400;
  }

  .as-wholesale-field input,
  .as-wholesale-field select,
  .as-wholesale-field textarea {
    border: 1px solid #d6cfc8;
    border-radius: 3px;
    padding: 10px 14px;
    font-size: 14px;
    color: #686A54;
    font-family: 'Fraunces';
    background-color: #FFF;
    background-image: none;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
    box-sizing: border-box;
    appearance: none;
    -webkit-appearance: none;
  }

  .as-wholesale-field input:-webkit-autofill,
  .as-wholesale-field input:-webkit-autofill:hover,
  .as-wholesale-field input:-webkit-autofill:focus,
  .as-wholesale-field textarea:-webkit-autofill,
  .as-wholesale-field textarea:-webkit-autofill:hover,
  .as-wholesale-field textarea:-webkit-autofill:focus {
    -webkit-text-fill-color: #686A54;
    -webkit-box-shadow: 0 0 0 1000px #FFF inset;
    transition: background-color 5000s ease-in-out 0s;
  }

  .as-wholesale-field input::placeholder,
  .as-wholesale-field textarea::placeholder {
    color: #969696;
    font-size: 14px;
  }

  .as-wholesale-field input:focus,
  .as-wholesale-field select:focus,
  .as-wholesale-field textarea:focus {
    border-color: #B7A160;
  }

  .as-wholesale-field textarea {
    resize: vertical;
    min-height: 110px;
  }

  .as-wholesale-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 18px;
  }

  .as-wholesale-row .as-wholesale-field {
    margin-bottom: 0;
  }

  .as-wholesale-item-list-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }

  .as-wholesale-item-list-label span:first-child {
    font-size: 16px;
    color: #686A54;
    font-family: 'Agrandir';
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .as-wholesale-item-list-label span:last-child {
    font-size: 16px;
    color: #686A54;
    font-family: 'Agrandir';
  }

  .as-wholesale-item-row {
    display: grid;
    grid-template-columns: 1fr 120px;
    gap: 10px;
    align-items: start;
    margin-bottom: 14px;
  }

  .as-wholesale-item-cell {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .as-wholesale-item-field-label {
    font-family: 'Agrandir'
    , sans-serif;
    font-size: 16px;
    color: #1E1E1E;
    font-weight: 400;
    line-height: 1.2;
  }

  .as-wholesale-item-row input[type="text"] {
    border: 1px solid #d6cfc8;
    border-radius: 3px;
    padding: 10px 14px;
    font-size: 14px;
    color: #969696;
    font-family: 'Georgia'
    , serif;
    background-color: #FFF;
    background-image: none;
    outline: none;
    width: 100%;
    box-sizing: border-box;
  }

  .as-wholesale-item-row input[type="text"]::placeholder {
    color: #969696;
    font-size: 14px;
  }

  .as-wholesale-item-row input[type="text"]:focus {
    border-color: #B7A160;
  }

  .as-wholesale-qty-wrap {
    display: flex;
    align-items: center;
    border: 1px solid #d6cfc8;
    border-radius: 3px;
    overflow: hidden;
    background-color: #FFF;
  }

  .as-wholesale-qty-btn {
    background: none;
    border: none;
    width: 32px;
    height: 38px;
    font-size: 18px;
    color: #686A54;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.15s;
  }

  .as-wholesale-qty-btn:hover {
    background: #f4ece6;
  }

  .as-wholesale-qty-input {
    width: 40px;
    text-align: center;
    border: none;
    font-size: 14px;
    color: #686A54;
    font-family: 'Georgia'
    , serif;
    padding: 0;
    height: 38px;
    box-sizing: border-box;
    outline: none;
    background-color: #FFF;
    background-image: none;
    -moz-appearance: textfield;
  }

  .as-wholesale-qty-input::-webkit-outer-spin-button,
  .as-wholesale-qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .as-wholesale-add-item {
    background: none;
    border: none;
    color: #686A54;
    font-size: 13px;
    font-family: 'Agrandir';
    cursor: pointer;
    padding: 4px 0;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    text-decoration: none;
  }

  .as-wholesale-add-item:hover {
    color: #B7A160;
  }

  .as-wholesale-submit-wrap {
    display: flex;
    justify-content: center;
    margin-top: 8px;
  }

  .as-wholesale-submit {
    background: #B7A160;
    color: #fff;
    border: none;
    padding: 13px 52px;
    font-size: 13px;
    letter-spacing: 0.12em;
    font-family: 'Agrandir';
    cursor: pointer;
    border-radius: 2px;
    text-transform: uppercase;
    transition: background 0.2s;
  }

  .as-wholesale-submit:hover {
    background: #9e8b52;
  }

  .as-wholesale-success {
    display: none;
    background: #f0ebe3;
    border: 1px solid #B7A160;
    color: #686A54;
    padding: 14px 20px;
    border-radius: 3px;
    font-size: 14px;
    text-align: center;
    margin-top: 16px;
    font-family: 'Georgia'
    , serif;
  }

  @media (max-width: 600px) {
    .as-wholesale-section {
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      padding: 40px max(16px, env(safe-area-inset-left)) 40px;
      box-sizing: border-box;
    }

    .as-wholesale-inner {
      max-width: 100%;
      width: 100%;
    }

    .as-wholesale-card {
      max-width: none;
      width: 100%;
    }

    .as-wholesale-intro {
      gap: 22px;
    }

    .as-wholesale-heading {
      font-size: 32px;
    }

    .as-wholesale-subtext {
      font-size: 16px;
    }

    .as-wholesale-accordions {
      grid-template-columns: 1fr;
    }

    .as-wholesale-accordion-trigger {
      font-size: 16px;
    }

    .as-wholesale-accordion-trigger span.as-wholesale-acc-icon {
      font-size: 20px;
    }

    .as-wholesale-gift-box-copy {
      font-size: 14px;
    }

    .as-wholesale-accordion:nth-child(odd) {
      border-right: none;
    }

    .as-wholesale-accordion:nth-last-child(-n + 2) {
      border-bottom: 1px solid #d6cfc8;
    }

    .as-wholesale-accordion:last-child {
      border-bottom: none;
    }

    .as-wholesale-card {
      padding: 24px 18px 28px;
    }

    .as-wholesale-row {
      grid-template-columns: 1fr;
      gap: 0;
      margin-bottom: 0;
    }

    .as-wholesale-row .as-wholesale-field {
      margin-bottom: 18px;
    }

    .as-wholesale-item-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .as-wholesale-item-row .as-wholesale-qty-wrap {
      max-width: 120px;
    }

    .as-wholesale-field label {
      font-size: 14px;
    }

    .as-wholesale-item-field-label {
      font-size: 14px;
    }

    .as-wholesale-item-list-label span:first-child,
    .as-wholesale-item-list-label span:last-child {
      font-size: 14px;
    }
  }
</style>

{%- liquid
  assign ws_bg_color = section.settings.background_color
  if ws_bg_color == blank
    assign ws_bg_color = '#F4ECE6'
  endif

  assign ws_show_pattern = true
  if section.settings.show_background_pattern == false
    assign ws_show_pattern = false
  endif

  assign ws_bg_image_css = 'none'
  if ws_show_pattern
    if section.settings.background_image != blank
      assign ws_bg_url = section.settings.background_image | image_url: width: 2400
    else
      assign ws_bg_url = 'mobile-bg.png' | asset_url
    endif
    assign ws_bg_image_css = "url('" | append: ws_bg_url | append: "')"
  endif
-%}

<section
  class="as-wholesale-section"
  style="background-color: {{ ws_bg_color | escape }}; background-image: {{ ws_bg_image_css }};">
  {% comment %} <div class="as-wholesale-bg-pattern">
                                                                                        <svg width="80" height="80" style="top:20px;left:20px;" viewBox="0 0 80 80"><text x="10" y="50" font-size="38" fill="#686A54" font-family="Georgia,serif" font-style="italic">AS</text></svg>
                                                                                        <svg width="80" height="80" style="top:20px;right:20px;" viewBox="0 0 80 80"><text x="10" y="50" font-size="38" fill="#686A54" font-family="Georgia,serif" font-style="italic">AS</text></svg>
                                                                                        <svg width="80" height="80" style="top:50%;left:20px;transform:translateY(-50%);" viewBox="0 0 80 80"><text x="10" y="50" font-size="38" fill="#686A54" font-family="Georgia,serif" font-style="italic">AS</text></svg>
                                                                                        <svg width="80" height="80" style="top:50%;right:20px;transform:translateY(-50%);" viewBox="0 0 80 80"><text x="10" y="50" font-size="38" fill="#686A54" font-family="Georgia,serif" font-style="italic">AS</text></svg>
                                                                                        <svg width="80" height="80" style="bottom:20px;left:20px;" viewBox="0 0 80 80"><text x="10" y="50" font-size="38" fill="#686A54" font-family="Georgia,serif" font-style="italic">AS</text></svg>
                                                                                        <svg width="80" height="80" style="bottom:20px;right:20px;" viewBox="0 0 80 80"><text x="10" y="50" font-size="38" fill="#686A54" font-family="Georgia,serif" font-style="italic">AS</text></svg>
                                                                                        <svg width="60" height="120" style="top:10%;left:50%;transform:translateX(-50%);" viewBox="0 0 60 120">
                                                                                          <line x1="30" y1="0" x2="30" y2="120" stroke="#686A54" stroke-width="1"/>
                                                                                          <ellipse cx="30" cy="20" rx="12" ry="18" fill="none" stroke="#686A54" stroke-width="1"/>
                                                                                          <ellipse cx="15" cy="55" rx="10" ry="15" fill="none" stroke="#686A54" stroke-width="1" transform="rotate(-30 15 55)"/>
                                                                                          <ellipse cx="45" cy="55" rx="10" ry="15" fill="none" stroke="#686A54" stroke-width="1" transform="rotate(30 45 55)"/>
                                                                                        </svg>
                                            </div> {% endcomment %}

  <div class="as-wholesale-inner">
    <div class="as-wholesale-intro">
      <h2 class="as-wholesale-heading">{{ section.settings.heading }}</h2>
      <p class="as-wholesale-subtext">{{ section.settings.subtext }}</p>
    </div>

    <div class="as-wholesale-accordions">
      <div class="as-wholesale-accordion">
        <button
          type="button"
          class="as-wholesale-accordion-trigger"
          data-acc="wholesale-discount">
          WHOLESALE DISCOUNT:
          <span class="as-wholesale-acc-icon">+</span>
        </button>
        <div class="as-wholesale-accordion-body" id="wholesale-discount">
          Enjoy tiered wholesale pricing based on your order volume.
        </div>
      </div>
      <div class="as-wholesale-accordion">
        <button
          type="button"
          class="as-wholesale-accordion-trigger"
          data-acc="product-customization">
          PRODUCT CUSTOMIZATION:
          <span class="as-wholesale-acc-icon">+</span>
        </button>
        <div class="as-wholesale-accordion-body" id="product-customization">
          We offer product customization for bulk orders. Contact us for details.
        </div>
      </div>
      <div class="as-wholesale-accordion">
        <button
          type="button"
          class="as-wholesale-accordion-trigger"
          data-acc="leadtime-to-ship">
          LEADTIME TO SHIP:
          <span class="as-wholesale-acc-icon">+</span>
        </button>
        <div class="as-wholesale-accordion-body" id="leadtime-to-ship">
          Standard lead time is 2–3 weeks depending on order size and customization.
        </div>
      </div>
      <div class="as-wholesale-accordion">
        <button
          type="button"
          class="as-wholesale-accordion-trigger"
          data-acc="gift-box">
          GIFT BOX:
          <span class="as-wholesale-acc-icon">–</span>
        </button>
        <div class="as-wholesale-accordion-body open" id="gift-box">
          <p class="as-wholesale-gift-box-copy">All orders will be beautifully packaged in our Arte Sari gift boxes.</p>
          {%- liquid
            assign gift_box_product = section.settings.gift_box_product
            assign gift_box_image_setting = section.settings.gift_box_image
            assign gift_show_image = nil

            if gift_box_product != blank
              if gift_box_product.featured_image != blank
                assign gift_show_image = gift_box_product.featured_image
              elsif gift_box_product.selected_or_first_available_variant.featured_image != blank
                assign gift_show_image = gift_box_product.selected_or_first_available_variant.featured_image
              elsif gift_box_product.media.size > 0
                assign gift_show_image = gift_box_product.media.first.preview_image
              endif
            endif

            if gift_show_image == blank and gift_box_image_setting != blank
              assign gift_show_image = gift_box_image_setting
            endif

            if gift_show_image != blank
              assign gift_alt = gift_show_image.alt | default: 'Gift box packaging'
            endif

            assign gift_box_label_hidden = section.settings.gift_box_hide_label
            assign gift_box_label_text = section.settings.gift_box_custom_label | strip
            if gift_box_product != blank and gift_box_label_hidden != true
              if gift_box_label_text == blank
                assign gift_box_label_text = gift_box_product.title
              endif
            endif
          -%}
          {%- if gift_box_product != blank and gift_show_image != blank -%}
            <a class="as-wholesale-gift-product" href="{{ gift_box_product.url }}">
              {{ gift_show_image | image_url: width: 480 | image_tag: class: 'as-wholesale-gift-product__image', loading: 'lazy', alt: gift_alt, sizes: '120px', widths: '120, 240, 360, 480' }}
              {%- if gift_box_label_hidden != true and gift_box_label_text != blank -%}
                <span class="as-wholesale-gift-product__title">{{ gift_box_label_text | escape }}</span>
              {%- endif -%}
            </a>
          {%- elsif gift_box_product != blank -%}
            <a class="as-wholesale-gift-product" href="{{ gift_box_product.url }}">
              {%- if gift_box_label_hidden != true and gift_box_label_text != blank -%}
                <span class="as-wholesale-gift-product__title">{{ gift_box_label_text | escape }}</span>
              {%- endif -%}
            </a>
          {%- elsif gift_show_image != blank -%}
            {{ gift_show_image | image_url: width: 480 | image_tag: class: 'as-wholesale-gift-product__image as-wholesale-gift-product__image--standalone', loading: 'lazy', alt: gift_alt, sizes: '120px', widths: '120, 240, 360, 480' }}
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="as-wholesale-card">
      {%- form 'contact'
        , id: 'as-wholesale-form' -%}
        <input
          type="hidden"
          name="contact[tags]"
          value="wholesale">

        <div class="as-wholesale-field">
          <label for="as-ws-fullname">Full Name</label>
          <input
            type="text"
            id="as-ws-fullname"
            name="contact[name]"
            placeholder="Ex. Juan Dela Cruz"
            required>
        </div>

        <div class="as-wholesale-field">
          <label for="as-ws-business">Business</label>
          <input
            type="text"
            id="as-ws-business"
            name="contact[business]"
            placeholder="Enter your business name">
        </div>

        <div class="as-wholesale-field">
          <label for="as-ws-address">Delivery Address</label>
          <input
            type="text"
            id="as-ws-address"
            name="contact[delivery_address]"
            placeholder="Enter your delivery address">
        </div>

        <div class="as-wholesale-row">
          <div class="as-wholesale-field">
            <label for="as-ws-contact">Contact</label>
            <input
              type="tel"
              id="as-ws-contact"
              name="contact[contact]"
              placeholder="+">
          </div>
          <div class="as-wholesale-field">
            <label for="as-ws-email">Email</label>
            <input
              type="email"
              id="as-ws-email"
              name="contact[email]"
              placeholder="Ex. juandelacruz@gmail.com"
              required>
          </div>
        </div>

        <div class="as-wholesale-field">
          <label for="as-ws-purpose">Purpose of wholesale order</label>
          <input
            type="text"
            id="as-ws-purpose"
            name="contact[purpose]"
            placeholder="Enter your purpose of wholesale order">
        </div>

        <div class="as-wholesale-field">
          <label for="as-ws-date">Date Needed</label>
          <input
            type="text"
            id="as-ws-date"
            name="contact[date_needed]"
            placeholder="MM-DD-YYYY">
        </div>

        <div class="as-wholesale-item-list-label">
          <span>ITEM LIST</span>
          <span>Min. no. of items: 5</span>
        </div>

        <div id="as-wholesale-items">
          <div class="as-wholesale-item-row">
            <div class="as-wholesale-item-cell">
              <span class="as-wholesale-item-field-label">Item</span>
              <input
                type="text"
                name="contact[item_1]"
                placeholder="Enter Item Name">
            </div>
            <div class="as-wholesale-item-cell as-wholesale-item-cell--qty">
              <span class="as-wholesale-item-field-label">Qty</span>
              <div class="as-wholesale-qty-wrap">
                <button
                  type="button"
                  class="as-wholesale-qty-btn"
                  onclick="asWsQty(this,-1)">−</button>
                <input
                  type="number"
                  class="as-wholesale-qty-input"
                  name="contact[qty_1]"
                  value="5"
                  min="1">
                <button
                  type="button"
                  class="as-wholesale-qty-btn"
                  onclick="asWsQty(this,1)">+</button>
              </div>
            </div>
          </div>
          <div class="as-wholesale-item-row">
            <div class="as-wholesale-item-cell">
              <span class="as-wholesale-item-field-label">Item</span>
              <input
                type="text"
                name="contact[item_2]"
                placeholder="Enter Item Name">
            </div>
            <div class="as-wholesale-item-cell as-wholesale-item-cell--qty">
              <span class="as-wholesale-item-field-label">Qty</span>
              <div class="as-wholesale-qty-wrap">
                <button
                  type="button"
                  class="as-wholesale-qty-btn"
                  onclick="asWsQty(this,-1)">−</button>
                <input
                  type="number"
                  class="as-wholesale-qty-input"
                  name="contact[qty_2]"
                  value="5"
                  min="1">
                <button
                  type="button"
                  class="as-wholesale-qty-btn"
                  onclick="asWsQty(this,1)">+</button>
              </div>
            </div>
          </div>
          <div class="as-wholesale-item-row">
            <div class="as-wholesale-item-cell">
              <span class="as-wholesale-item-field-label">Item</span>
              <input
                type="text"
                name="contact[item_3]"
                placeholder="Enter Item Name">
            </div>
            <div class="as-wholesale-item-cell as-wholesale-item-cell--qty">
              <span class="as-wholesale-item-field-label">Qty</span>
              <div class="as-wholesale-qty-wrap">
                <button
                  type="button"
                  class="as-wholesale-qty-btn"
                  onclick="asWsQty(this,-1)">−</button>
                <input
                  type="number"
                  class="as-wholesale-qty-input"
                  name="contact[qty_3]"
                  value="5"
                  min="1">
                <button
                  type="button"
                  class="as-wholesale-qty-btn"
                  onclick="asWsQty(this,1)">+</button>
              </div>
            </div>
          </div>
        </div>

        <button
          type="button"
          class="as-wholesale-add-item"
          id="as-ws-add-item">+ ADD ANOTHER ITEM</button>

        <div class="as-wholesale-field">
          <label for="as-ws-message">Message</label>
          <textarea
            id="as-ws-message"
            name="contact[body]"
            placeholder="Write your inquiry or a collaboration idea here..."></textarea>
        </div>

        <div class="as-wholesale-submit-wrap">
          <button type="submit" class="as-wholesale-submit">SUBMIT</button>
        </div>

        {%- if form.posted_successfully? -%}
          <div class="as-wholesale-success" style="display:block;">Thank you! Your wholesale inquiry has been sent.</div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

<script>
  (function() {
    var accTriggers = document.querySelectorAll('.as-wholesale-accordion-trigger');
    accTriggers.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var id = btn.getAttribute('data-acc');
        var body = document.getElementById(id);
        var icon = btn.querySelector('.as-wholesale-acc-icon');
        if (body.classList.contains('open')) {
          body.classList.remove('open');
          icon.textContent = '+';
        } else {
          body.classList.add('open');
          icon.textContent = '–';
        }
      });
    });
  
    var itemCount = 3;
    var addBtn = document.getElementById('as-ws-add-item');
    if (addBtn) {
      addBtn.addEventListener('click', function() {
        itemCount++;
        var container = document.getElementById('as-wholesale-items');
        var row = document.createElement('div');
        row.className = 'as-wholesale-item-row';
        row.innerHTML =
          '<div class="as-wholesale-item-cell">' +
            '<span class="as-wholesale-item-field-label">Item</span>' +
            '<input type="text" name="contact[item_' + itemCount + ']" placeholder="Enter Item Name">' +
          '</div>' +
          '<div class="as-wholesale-item-cell as-wholesale-item-cell--qty">' +
            '<span class="as-wholesale-item-field-label">Qty</span>' +
            '<div class="as-wholesale-qty-wrap">' +
              '<button type="button" class="as-wholesale-qty-btn" onclick="asWsQty(this,-1)">−</button>' +
              '<input type="number" class="as-wholesale-qty-input" name="contact[qty_' + itemCount + ']" value="5" min="1">' +
              '<button type="button" class="as-wholesale-qty-btn" onclick="asWsQty(this,1)">+</button>' +
            '</div>' +
          '</div>';
        container.appendChild(row);
      });
    }
  })();
  
  function asWsQty(btn, delta) {
    var input = btn.parentElement.querySelector('.as-wholesale-qty-input');
    var val = parseInt(input.value) || 1;
    val = Math.max(1, val + delta);
    input.value = val;
  }
</script>