    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Font Size",
      "min": 12,
      "max": 30,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "text_font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "bold", "label": "Bold" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" }
      ],
      "default": "normal"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "text_line_height",
      "label": "Line Height",
      "min": 1.2,
      "max": 2.0,
      "step": 0.1,
      "default": 1.7
    },
    {
      "type": "range",
      "id": "text_margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Bullets"
    },
    {
      "type": "range",
      "id": "bullets_columns",
      "label": "Number of Columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
