{% liquid
  assign bg_image = section.settings.background_image
%}

<section class="join-store" style="background-color: {{ section.settings.section_bg_color }};">
  <div class="join-store__bg">
    {% if bg_image != blank %}
      <img 
        src="{{ bg_image | image_url: width: 2000 }}" 
        alt="Background"
        class="join-store__bg-img"
        loading="lazy"
      >
    {% endif %}
  </div>

  <div class="join-store__container {% if section.settings.layout_order == 'text-first' %}join-store__container--text-first{% endif %}">

    <div class="join-store__media">
      {% if section.settings.image != blank %}
        <img 
          src="{{ section.settings.image | image_url: width: 900 }}" 
          alt="Join Store"
          class="join-store__image"
          loading="lazy"
        >
      {% endif %}
    </div>

    <div class="join-store__content">

      {% if section.settings.eyebrow != blank %}
        <p class="join-store__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="join-store__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="join-store__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      <div class="join-store__bullets">
        {% for block in section.blocks %}
          {% if block.type == 'bullet' %}
            <div class="join-store__bullet" {{ block.shopify_attributes }}>
              {{ block.settings.bullet_symbol }} {{ block.settings.text }}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="join-store__button">
          {{ section.settings.button_label }}
        </a>
      {% endif %}

    </div>

  </div>
</section>

{% style %}
.join-store {
  position: relative;
  width: 100%;
  padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
  overflow: hidden;
  background-color: {{ section.settings.section_bg_color }};
}

.join-store__bg {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.join-store__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.join-store__container {
  position: relative;
  z-index: 2;
  max-width: {{ section.settings.container_max_width }}px;
  margin: 0 auto;
  padding: 0 24px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: {{ section.settings.columns_gap }}px;
  align-items: center;
}

.join-store__container--text-first .join-store__media {
  order: 2;
}

.join-store__container--text-first .join-store__content {
  order: 1;
}

.join-store__media {
  width: 100%;
}

.join-store__image {
  width: 100%;
  height: auto;
  display: block;
  border-radius: {{ section.settings.image_border_radius }}px;
}

.join-store__content {
  max-width: {{ section.settings.content_max_width }}px;
}

.join-store__eyebrow {
  font-family: {{ section.settings.eyebrow_font_family }};
  font-size: {{ section.settings.eyebrow_font_size }}px;
  font-weight: {{ section.settings.eyebrow_font_weight }};
  color: {{ section.settings.eyebrow_color }};
  letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
  margin-bottom: {{ section.settings.eyebrow_margin_bottom }}px;
  text-transform: {{ section.settings.eyebrow_text_transform }};
}

.join-store__heading {
  font-family: {{ section.settings.heading_font_family }};
  font-size: {{ section.settings.heading_font_size }}px;
  font-weight: {{ section.settings.heading_font_weight }};
  color: {{ section.settings.heading_color }};
  line-height: {{ section.settings.heading_line_height }};
  margin-bottom: {{ section.settings.heading_margin_bottom }}px;
}

.join-store__text {
  font-family: {{ section.settings.text_font_family }};
  font-size: {{ section.settings.text_font_size }}px;
  font-weight: {{ section.settings.text_font_weight }};
  color: {{ section.settings.text_color }};
  line-height: {{ section.settings.text_line_height }};
  margin-bottom: {{ section.settings.text_margin_bottom }}px;
}

.join-store__bullets {
  display: grid;
  grid-template-columns: repeat({{ section.settings.bullets_columns }}, 1fr);
  gap: {{ section.settings.bullets_gap_y }}px {{ section.settings.bullets_gap_x }}px;
  margin-bottom: {{ section.settings.bullets_margin_bottom }}px;
}

.join-store__bullet {
  font-family: {{ section.settings.bullet_font_family }};
  font-size: {{ section.settings.bullet_font_size }}px;
  font-weight: {{ section.settings.bullet_font_weight }};
  color: {{ section.settings.bullet_color }};
  line-height: {{ section.settings.bullet_line_height }};
}

.join-store__button {
  display: inline-block;
  padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
  background-color: {{ section.settings.button_bg_color }};
  color: {{ section.settings.button_text_color }};
  text-decoration: none;
  font-family: {{ section.settings.button_font_family }};
  font-size: {{ section.settings.button_font_size }}px;
  font-weight: {{ section.settings.button_font_weight }};
  letter-spacing: {{ section.settings.button_letter_spacing }}px;
  border-radius: {{ section.settings.button_border_radius }}px;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.join-store__button:hover {
  background-color: {{ section.settings.button_hover_bg_color }};
  color: {{ section.settings.button_hover_text_color }};
}

@media screen and (max-width: 900px) {
  .join-store__container {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  
  .join-store__container--text-first .join-store__media,
  .join-store__container--text-first .join-store__content {
    order: unset;
  }

  .join-store__content {
    max-width: 100%;
  }

  .join-store__heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
  }

}
{% endstyle %}

{% schema %}
{
  "name": "Join Our Store",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_order",
