      "id": "bullets_gap_x",
      "label": "Horizontal Gap",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "bullets_gap_y",
      "label": "Vertical Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "bullets_margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "bullet_font_family",
      "label": "Font Family",
