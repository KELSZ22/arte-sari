

<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<blog-posts-list section-id="{{ section.id }}">
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="
      section
      color-{{ section.settings.color_scheme }}
      blog-posts
      spacing-style
      size-style
    "
    data-testid="blog-posts"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    {% liquid
      assign fallback_tags = 'ARTISAN,EVENTS,CULTURE' | split: ','
      assign available_tags = blog.all_tags
      if available_tags.size == 0
        assign available_tags = fallback_tags
      endif
    %}
    <nav
      class="blog-header-filters"
      aria-label="Blog filters"
    >
      <a
        href="{{ blog.url }}"
        class="blog-header-filters__link{% if current_tags == blank %} is-active{% endif %}"
      >
        ALL
      </a>
      {% for tag in available_tags %}
        <a
          href="{{ blog.url }}/tagged/{{ tag | handleize }}"
          class="blog-header-filters__link{% if current_tags contains tag %} is-active{% endif %}"
        >
          {{ tag | upcase }}
        </a>
      {% endfor %}
    </nav>

    <div
      ref="grid"
      class="blog-posts-container"
    >
      {% for article in blog.articles %}
        <div
          class="blog-post-item"
          data-testid="blog-post-item"
          data-blog-index="{{ section.id }}-{{ forloop.index }}"
        >
          {% if article.tags.size > 0 %}
            {% assign first_tag = article.tags.first %}
            <span class="blog-post-tag blog-post-tag--{{ first_tag | handleize }}">
              {{ first_tag | upcase }}
            </span>
          {% endif %}
          {% content_for 'block', id: 'static-blog-post-card', type: '_blog-post-card', article: article %}
        </div>
      {% endfor %}
    </div>
  </div>
</blog-posts-list>

<script>
  (() => {
    const sectionRoot = document.querySelector('blog-posts-list[section-id="{{ section.id }}"] .blog-posts');
    if (!sectionRoot) return;

    const filters = sectionRoot.querySelector('.blog-header-filters');
    const headerGroup = sectionRoot.querySelector('.group-block:has(.custom-artisan-title)');

    if (!filters || !headerGroup) return;
    if (filters.nextElementSibling === headerGroup) return;

    sectionRoot.insertBefore(filters, headerGroup);
  })();
</script>

{% stylesheet %}
  /**
   * Blog posts page layout
   */
  .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    --columns-gap: 36px;
    --rows-gap: 36px;
  }

  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
  }

  /**
   * When there's no image, the blog post item has a border.
   */
  .blog-post-item {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    padding: 0 1rem 1rem;
  }

  .blog-post-item:has(.blog-post-card__image-container) {
    border: none;
    padding: 0;
  }

  .blog-post-item .blog-post-card__image-container {
    aspect-ratio: 1 / 1;
  }

  .blog-post-item .blog-post-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .blog-posts-container {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
