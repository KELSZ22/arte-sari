{% liquid
  assign selected_collection = section.settings.collection
  assign overlay_opacity = section.settings.background_overlay | divided_by: 100.0
  assign desktop_columns_minus_one = section.settings.columns | minus: 1
  assign desktop_overflow_divisor = desktop_columns_minus_one | times: 5
  assign heading_font_family = section.settings.heading_font_family
  assign subheading_font_family = section.settings.subheading_font_family

  if heading_font_family == 'agrandir'
    assign heading_font_family_value = 'Agrandir'
  elsif heading_font_family == 'ss-bruney'
    assign heading_font_family_value = 'SS Bruney'
  elsif heading_font_family == 'facelio'
    assign heading_font_family_value = 'Facelio'
  elsif heading_font_family == 'fraunces'
    assign heading_font_family_value = 'var(--font-heading-family)'
  else
    assign heading_font_family_value = 'inherit'
  endif

  if subheading_font_family == 'agrandir'
    assign subheading_font_family_value = 'Agrandir'
  elsif subheading_font_family == 'ss-bruney'
    assign subheading_font_family_value = 'SS Bruney'
  elsif subheading_font_family == 'facelio'
    assign subheading_font_family_value = 'Facelio'
  elsif subheading_font_family == 'fraunces'
    assign subheading_font_family_value = 'var(--font-heading-family)'
  else
    assign subheading_font_family_value = 'inherit'
  endif
%}

<div class="  ccs section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="hero-zoom-pop section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} custom-collection-showcase spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --custom-collection-columns: {{ section.settings.columns }};
    --custom-collection-overlay-opacity: {{ overlay_opacity }};
    --custom-collection-bg-size: {{ section.settings.background_size }};
    --custom-collection-bg-position: {{ section.settings.background_position }};
    --custom-collection-card-radius: {{ section.settings.card_border_radius }}px;
    --custom-collection-text-align: {{ section.settings.text_alignment }};
    --custom-collection-products-padding-top: {{ section.settings.products_padding_top }}px;
    --custom-collection-products-padding-bottom: {{ section.settings.products_padding_bottom }}px;
    --custom-collection-products-padding-left: {{ section.settings.products_padding_left }}px;
    --custom-collection-products-padding-right: {{ section.settings.products_padding_right }}px;
    --custom-collection-products-gap: 16px;
    --custom-collection-height: {{ section.settings.section_height }}px;
    --heading-font-family: {{ heading_font_family_value }};
    --subheading-font-family: {{ subheading_font_family_value }};
    {% if section.settings.background_image != blank %}
      --custom-collection-bg-image: url('{{ section.settings.background_image | image_url: width: 2800 }}');
    {% else %}
      --custom-collection-bg-image: none;
    {% endif %}
    {% if section.settings.background_image_mobile != blank %}
      --custom-collection-bg-image-mobile: url('{{ section.settings.background_image_mobile | image_url: width: 1200 }}');
    {% elsif section.settings.background_image != blank %}
      --custom-collection-bg-image-mobile: url('{{ section.settings.background_image | image_url: width: 1200 }}');
    {% else %}
      --custom-collection-bg-image-mobile: none;
    {% endif %}
  "
>
  <div class="custom-collection-showcase__background"></div>

  <div class="custom-collection-showcase__content">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="custom-collection-showcase__header">
        {% if section.settings.heading != blank %}
          <h2
            class="custom-collection-showcase__title"
            style="
              font-family: var(--heading-font-family);
              font-size: {{ section.settings.heading_font_size }}px;
              font-weight: {{ section.settings.heading_font_weight }};
              {% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}
            "
          >
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p
            class="custom-collection-showcase__subtitle"
            style="
              font-family: var(--subheading-font-family);
              font-size: {{ section.settings.subheading_font_size }}px;
              font-weight: {{ section.settings.subheading_font_weight }};
              {% if section.settings.subheading_color != blank %}color: {{ section.settings.subheading_color }};{% endif %}
            "
          >
            {{ section.settings.subheading }}
          </p>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="custom-collection-showcase__products-wrap">
    <ul class="custom-collection-showcase__products slide-up-animation" role="list">
      {% if selected_collection != blank and selected_collection.products_count > 0 %}
        {% for product in selected_collection.products limit: section.settings.products_to_show %}
          <li class="custom-collection-showcase__item">
            {% # theme-check-disable UniqueStaticBlockId %}
            {% capture card_markup %}
              {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
            {% endcapture %}
            {% # theme-check-enable UniqueStaticBlockId %}
            {% if card_markup != blank %}
              {{ card_markup }}
            {% else %}
              <a href="{{ product.url }}" class="custom-collection-showcase__fallback-card">
                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag: class: 'custom-collection-showcase__fallback-image', loading: 'lazy'
                  }}
                {% endif %}
                <span class="custom-collection-showcase__fallback-title">{{ product.title }}</span>
                <span class="custom-collection-showcase__fallback-price">{{ product.price | money }}</span>
              </a>
            {% endif %}
          </li>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          <li class="custom-collection-showcase__item">
            {% # theme-check-disable UniqueStaticBlockId %}
            {% capture card_markup %}
              {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
            {% endcapture %}
            {% # theme-check-enable UniqueStaticBlockId %}
            {% if card_markup != blank %}
              {{ card_markup }}
            {% else %}
              <div class="custom-collection-showcase__fallback-card custom-collection-showcase__fallback-card--placeholder">
                <div class="custom-collection-showcase__fallback-image custom-collection-showcase__fallback-image--placeholder"></div>
                <span class="custom-collection-showcase__fallback-title">Product title</span>
                <span class="custom-collection-showcase__fallback-price">{{ 1999 | money }}</span>
              </div>
            {% endif %}
          </li>
        {% endfor %}
      {% endif %}
    </ul>
  </div>
</section>

{% stylesheet %}
.product-title .text-block p {
  font-size: 20px;
}
.paragraph.price>* {
  font-size: 16px;
}
  @font-face {
    font-family: 'Agrandir';
    src: url('https://cdn.shopify.com/s/files/1/0728/1321/5942/files/Agrandir-Regular.woff2?v=1771643523') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'SS Bruney';
    src: url('https://cdn.shopify.com/s/files/1/0728/1321/5942/files/SS_Bruney.woff2?v=1771643523') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Facelio';
    src: url('https://cdn.shopify.com/s/files/1/0728/1321/5942/files/Facelio.woff2?v=1771643523') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  .custom-collection-showcase {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: var(--custom-collection-height);
  }

  .custom-collection-showcase__background {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--custom-collection-bg-image);
    background-size: var(--custom-collection-bg-size);
    background-position: var(--custom-collection-bg-position);
    background-repeat: no-repeat;
  }

  .custom-collection-showcase__background::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--custom-collection-overlay-opacity));
  }

  .custom-collection-showcase__content {
    position: relative;
    z-index: 1;
  }

  .custom-collection-showcase__header {
    margin-bottom: 24px;
    text-align: var(--custom-collection-text-align);
  }

  .custom-collection-showcase__title {
    margin: 0;
  }

  .custom-collection-showcase__subtitle {
    margin: 8px 0 0;
  }

  .custom-collection-showcase__products-wrap {
    width: 100%;
    overflow: hidden;
  }

  .custom-collection-showcase__products {
    margin: 0;
    padding: 0;
    list-style: none;
    padding-top: var(--custom-collection-products-padding-top);
    padding-bottom: var(--custom-collection-products-padding-bottom);
    display: flex;
    gap: var(--custom-collection-products-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
    user-select: none;
  }

  .custom-collection-showcase__products::-webkit-scrollbar {
    display: none;
  }

  .custom-collection-showcase__products.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .custom-collection-showcase__products.is-dragging * {
    pointer-events: none;
  }

  .custom-collection-showcase__item {
    min-width: 0;
    flex-shrink: 0;
    border-radius: var(--custom-collection-card-radius);
    overflow: hidden;
    scroll-snap-align: start;
    width: calc((100% / 2.3));
  }

  .custom-collection-showcase__fallback-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .custom-collection-showcase__fallback-image {
    width: 100%;
    height: auto;
    display: block;
    background: rgba(255, 255, 255, 0.2);
  }

  .custom-collection-showcase__fallback-image--placeholder {
    aspect-ratio: 3 / 4;
  }

  .custom-collection-showcase__fallback-title,
  .custom-collection-showcase__fallback-price {
    display: block;
    line-height: 1.3;
  }
  @media screen and (max-width: 767px){
      h2.custom-collection-showcase__title {
    font-size: 28px !important;
}
  }
  @media screen and (max-width: 749px) {
    .custom-collection-showcase__background {
      background-image: var(--custom-collection-bg-image-mobile);
    }
    .custom-collection-showcase__content {
      margin-top: 15vw;
    }
  
  }

  @media screen and (min-width: 750px) {
    .custom-collection-showcase__products-wrap {
      overflow: hidden;
      width: 100%;
    }

    .custom-collection-showcase__products {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-left: var(--custom-collection-products-padding-left);
      padding-right: var(--custom-collection-products-padding-right);
    }

    .custom-collection-showcase__item {
      flex-shrink: 0;
      scroll-snap-align: start;
      width: calc((100% / 4.5) - (var(--custom-collection-products-gap) * 3.5 / 4.5));
    }
  }
{% endstylesheet %}

<script>
  (function () {
    function shouldIgnoreDragStart(target) {
      if (!(target instanceof Element)) return false;
      return Boolean(
        target.closest(
          'a, button, input, select, textarea, .custom-quick-view-cta, .custom-quick-view, [role="button"]'
        )
      );
    }

    function initDrag(el) {
      let isDown = false;
      let startX;
      let scrollLeft;

      el.addEventListener('mousedown', function (e) {
        if (shouldIgnoreDragStart(e.target)) return;
        isDown = true;
        el.classList.add('is-dragging');
        startX = e.pageX - el.offsetLeft;
        scrollLeft = el.scrollLeft;
      });

      el.addEventListener('mouseleave', function () {
        isDown = false;
        el.classList.remove('is-dragging');
      });

      el.addEventListener('mouseup', function () {
        isDown = false;
        el.classList.remove('is-dragging');
      });

      el.addEventListener('mousemove', function (e) {
        if (!isDown) return;
        e.preventDefault();
        var x = e.pageX - el.offsetLeft;
        var walk = (x - startX) * 1.5;
        el.scrollLeft = scrollLeft - walk;
      });
    }

    function init() {
      document.querySelectorAll('.custom-collection-showcase__products').forEach(function (el) {
        initDrag(el);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

{% schema %}
