    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Button Typography"
    },
    {
      "type": "select",
      "id": "button_font_family",
