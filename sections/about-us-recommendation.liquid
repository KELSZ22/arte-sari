{% liquid
  assign bg_image = section.settings.background_image
  assign bg_color = section.settings.background_color
%}

<section class="favorites">
  <div class="favorites__bg">
    {% if bg_image != blank %}
      <img 
        src="{{ bg_image | image_url: width: 2000 }}" 
        alt="Background"
        class="favorites__bg-img"
        loading="lazy"
      >
    {% endif %}
  </div>

  <div class="favorites__container">
    {% if section.settings.heading != blank %}
      <h2 class="favorites__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="favorites__grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
          <div class="favorites__item" {{ block.shopify_attributes }}>
            
            <a href="{{ product.url }}" class="favorites__image-wrapper">
              
              {% if product.featured_image %}
                <img 
                  src="{{ product.featured_image | image_url: width: 600 }}" 
                  alt="{{ product.title }}"
                  class="favorites__image"
                  loading="lazy"
                >
              {% endif %}

              <span class="favorites__image-border"></span>

            </a>

            <div class="favorites__info">
              <h3 class="favorites__product-title">
                {{ product.title }}
              </h3>

              <p class="favorites__price">
                {{ product.price | money }}
              </p>
            </div>

          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.button_label != blank %}
      <div class="favorites__cta">
        <a href="{{ section.settings.button_link }}" class="favorites__button">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

{% style %}
.favorites {
  position: relative;
  padding: {{ section.settings.section_padding }}px 0;
  overflow: hidden;
  background-color: {{ section.settings.background_color }};
}

.favorites__bg {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.favorites__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.favorites__container {
  position: relative;
  z-index: 2;
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
  padding: 0 24px;
  text-align: {{ section.settings.text_alignment }};
}

.favorites__heading {
  font-size: {{ section.settings.heading_font_size }}px;
  color: {{ section.settings.heading_color }};
  font-weight: {{ section.settings.heading_font_weight }};
  {% if section.settings.heading_font_family != blank %}
    font-family: {{ section.settings.heading_font_family }};
  {% endif %}
  margin-bottom: {{ section.settings.heading_margin_bottom }}px;
  letter-spacing: {{ section.settings.heading_letter_spacing }}px;
  {% if section.settings.heading_text_transform != 'none' %}
    text-transform: {{ section.settings.heading_text_transform }};
  {% endif %}
}

.favorites__grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  gap: {{ section.settings.grid_gap }}px;
  margin-bottom: {{ section.settings.grid_margin_bottom }}px;
}

.favorites__item {
  text-align: left;
}

.favorites__image-wrapper {
  position: relative;
  display: block;
}

.favorites__image {
  width: 100%;
  display: block;
  /*
  height: 340px;
  object-fit: cover;
  */
}

.favorites__image-border {
  position: absolute;
  inset: 10px;
  border: {{ section.settings.image_border_width }}px solid {{ section.settings.image_border_color }};
  pointer-events: none;
  opacity: {{ section.settings.image_border_opacity }};
}

.favorites__info {
  margin-top: {{ section.settings.product_title_margin_top }}px;
}

.favorites__product-title {
  font-size: {{ section.settings.product_title_font_size }}px;
  color: {{ section.settings.product_title_color }};
  font-weight: {{ section.settings.product_title_font_weight }};
  {% if section.settings.product_title_font_family != blank %}
    font-family: {{ section.settings.product_title_font_family }};
  {% endif %}
  margin-bottom: {{ section.settings.product_title_margin_bottom }}px;
  {% if section.settings.product_title_text_transform != 'none' %}
    text-transform: {{ section.settings.product_title_text_transform }};
  {% endif %}
}

.favorites__price {
  font-size: {{ section.settings.price_font_size }}px;
  color: {{ section.settings.price_color }};
  font-weight: {{ section.settings.price_font_weight }};
  {% if section.settings.price_font_family != blank %}
    font-family: {{ section.settings.price_font_family }};
  {% endif %}
  opacity: {{ section.settings.price_opacity }};
}

.favorites__cta {
  margin-top: {{ section.settings.button_margin_top }}px;
}

.favorites__button {
  display: inline-block;
  padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
  background-color: {{ section.settings.button_background_color }};
  color: {{ section.settings.button_text_color }};
  text-decoration: none;
  font-size: {{ section.settings.button_font_size }}px;
  font-weight: {{ section.settings.button_font_weight }};
  {% if section.settings.button_font_family != blank %}
    font-family: {{ section.settings.button_font_family }};
  {% endif %}
  letter-spacing: {{ section.settings.button_letter_spacing }}px;
  border-radius: {{ section.settings.button_border_radius }}px;
  {% if section.settings.button_text_transform != 'none' %}
    text-transform: {{ section.settings.button_text_transform }};
  {% endif %}
  transition: all 0.3s ease;
}

.favorites__button:hover {
  background-color: {{ section.settings.button_hover_background_color }};
  color: {{ section.settings.button_hover_text_color }};
}
.favorites__image-wrapper {
    position: relative;
    /*
    width: 351px;
    height: 351px;
    */
}

@media screen and (max-width: 900px) {
  .favorites__grid {
    grid-template-columns: repeat({{ section.settings.columns_tablet }}, 256px);
  }

  .favorites__heading {
    font-size: {{ section.settings.heading_font_size_tablet }}px;
  }
  
  .favorites__product-title {
    font-size: {{ section.settings.product_title_font_size_tablet }}px;
  }
  
  .favorites__price {
    font-size: {{ section.settings.price_font_size_tablet }}px;
  }
  
  .favorites__button {
    padding: {{ section.settings.button_padding_y_tablet }}px {{ section.settings.button_padding_x_tablet }}px;
    font-size: {{ section.settings.button_font_size_tablet }}px;
  }
}

@media screen and (max-width: 480px) {
  .favorites__grid {
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 256px);
  }
  
  .favorites {
    padding: {{ section.settings.section_padding_mobile }}px 0;
  }
  
  .favorites__heading {
    font-size: {{ section.settings.heading_font_size_mobile }}px;
  }
  
  .favorites__product-title {
    font-size: {{ section.settings.product_title_font_size_mobile }}px;
  }
  
  .favorites__price {
    font-size: {{ section.settings.price_font_size_mobile }}px;
  }
  
  .favorites__button {
    padding: {{ section.settings.button_padding_y_mobile }}px {{ section.settings.button_padding_x_mobile }}px;
    font-size: {{ section.settings.button_font_size_mobile }}px;
  }
}
{% endstyle %}

