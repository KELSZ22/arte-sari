{% liquid
  assign section_height = section.settings.section_height
%}

<section class="arte-sari" style="--section-height: {{ section_height }}vh;">
  <div class="arte-sari__container">

    <div class="arte-sari__block arte-sari__block--left">
      <div class="arte-sari__media">
        {% if section.settings.left_image != blank %}
          <img 
            src="{{ section.settings.left_image | image_url: width: 1500 }}" 
            alt="Left Image"
            class="arte-sari__image"
          >
        {% endif %}
      </div>

      <div class="arte-sari__content" style="
        {% if section.settings.left_bg_image != blank %}
          background-image: url('{{ section.settings.left_bg_image | image_url: width: 800 }}');
          background-size: cover;
          background-position: center;
        {% else %}
          background-color: {{ section.settings.left_bg_color }};
        {% endif %}
      ">
        <h2 class="arte-sari__title" style="
          font-size: {{ section.settings.left_title_font_size }}px;
          color: {{ section.settings.left_title_color }};
          font-weight: {{ section.settings.left_title_font_weight }};
          font-family: {{ section.settings.left_title_font_family }};
          margin-bottom: {{ section.settings.left_title_margin_bottom }}px;
        ">
          {{ section.settings.left_title }}
        </h2>
        <p class="arte-sari__text" style="
          font-size: {{ section.settings.left_text_font_size }}px;
          color: {{ section.settings.left_text_color }};
          font-weight: {{ section.settings.left_text_font_weight }};
          font-family: {{ section.settings.left_text_font_family }};
          line-height: {{ section.settings.left_text_line_height }};
        ">
          {{ section.settings.left_text }}
        </p>
      </div>
    </div>

    <div class="arte-sari__block arte-sari__block--right">
      <div class="arte-sari__media">
        {% if section.settings.right_image != blank %}
          <img 
            src="{{ section.settings.right_image | image_url: width: 1500 }}" 
            alt="Right Image"
            class="arte-sari__image"
          >
        {% endif %}
      </div>

      <div class="arte-sari__content" style="
        {% if section.settings.right_bg_image != blank %}
          background-image: url('{{ section.settings.right_bg_image | image_url: width: 800 }}');
          background-size: cover;
          background-position: center;
        {% else %}
          background-color: {{ section.settings.right_bg_color }};
        {% endif %}
      ">
        <h2 class="arte-sari__title" style="
          font-size: {{ section.settings.right_title_font_size }}px;
          color: {{ section.settings.right_title_color }};
          font-weight: {{ section.settings.right_title_font_weight }};
          font-family: {{ section.settings.right_title_font_family }};
          margin-bottom: {{ section.settings.right_title_margin_bottom }}px;
        ">
          {{ section.settings.right_title }}
        </h2>
        <p class="arte-sari__text" style="
          font-size: {{ section.settings.right_text_font_size }}px;
          color: {{ section.settings.right_text_color }};
          font-weight: {{ section.settings.right_text_font_weight }};
          font-family: {{ section.settings.right_text_font_family }};
          line-height: {{ section.settings.right_text_line_height }};
        ">
          {{ section.settings.right_text }}
        </p>
      </div>
    </div>

  </div>
</section>

<style>
    .arte-sari {
  width: 100%;
}

.arte-sari__container {
  display: flex;
}

.arte-sari__block {
  width: 50%;
  display: flex;
  flex-direction: column;
}

.arte-sari__media {
  height: var(--section-height);
  overflow: hidden;
}

.arte-sari__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.arte-sari__content {
  padding: 44px 88px 86px 110px;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

@media screen and (min-width: 769px){
  .arte-sari__content {
    justify-content: center;
    display: flex;
    flex-direction: column;
    min-height: 350px;
  }
  .arte-sari__block:first-child .arte-sari__content {
    border-right: 1px solid #686A54;
  }
}

@media screen and (max-width: 768px) {
  .arte-sari__container {
    flex-direction: column;
  }

  .arte-sari__block {
    width: 100%;
  }

  .arte-sari__media {
    height: 60vh;
  }
  
  .arte-sari__content {
    padding: 32px 24px;
  }
}
</style>

{% schema %}
{
  "name": "Arte & Sari Section",
  "settings": [
    {
      "type": "range",
      "id": "section_height",
      "label": "Image Height (vh)",
      "min": 30,
      "max": 100,
      "step": 5,
      "default": 70
    },

    {
      "type": "header",
      "content": "Left Side Settings"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "left_title",
      "label": "Left Title",
      "default": "ARTE"
    },
    {
      "type": "textarea",
      "id": "left_text",
      "label": "Left Description",
      "default": "Representing Filipino artistry..."
    },
    {
      "type": "header",
      "content": "Left Side Content Background"
    },
    {
      "type": "color",
      "id": "left_bg_color",
      "label": "Background Color",
      "default": "#f7f5f2"
    },
    {
      "type": "image_picker",
      "id": "left_bg_image",
      "label": "Background Image (overrides color)"
    },
    {
      "type": "header",
      "content": "Left Side Title Styling"
    },
    {
      "type": "range",
      "id": "left_title_font_size",
      "label": "Title Font Size (px)",
