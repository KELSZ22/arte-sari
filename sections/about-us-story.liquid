      "default": 32
    },
    {
      "type": "color",
      "id": "left_title_color",
      "label": "Title Color",
      "default": "#4a4a4a"
    },
    {
      "type": "select",
      "id": "left_title_font_weight",
      "label": "Title Font Weight",
      "options": [
        { "value": "100", "label": "Thin (100)" },
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-bold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "800", "label": "Extra-bold (800)" },
        { "value": "900", "label": "Black (900)" }
      ],
      "default": "700"
    },
    {
      "type": "text",
      "id": "left_title_font_family",
      "label": "Title Font Family",
      "default": "inherit",
      "placeholder": "e.g., 'Helvetica Neue', Arial, sans-serif"
    },
    {
      "type": "range",
      "id": "left_title_margin_bottom",
      "label": "Title Margin Bottom (px)",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 16
    },
    {
      "type": "header",
      "content": "Left Side Text Styling"
    },
    {
      "type": "range",
      "id": "left_text_font_size",
      "label": "Text Font Size (px)",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 16
    },
    {
      "type": "color",
      "id": "left_text_color",
      "label": "Text Color",
      "default": "#6b6b6b"
    },
    {
      "type": "select",
      "id": "left_text_font_weight",
      "label": "Text Font Weight",
      "options": [
        { "value": "100", "label": "Thin (100)" },
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
