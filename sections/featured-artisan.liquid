{% liquid
  assign overlay_opacity = section.settings.background_overlay | divided_by: 100.0
  assign product_1 = section.settings.product_1
  assign product_2 = section.settings.product_2

  assign subtitle_font_family = section.settings.subtitle_font_family
  assign title_font_family = section.settings.title_font_family
  assign text_font_family = section.settings.text_font_family
  assign button_font_family = section.settings.button_font_family
  assign product_title_font_family = section.settings.product_title_font_family
  assign product_price_font_family = section.settings.product_price_font_family

  assign subtitle_font = subtitle_font_family | default: 'inherit'
  assign title_font = title_font_family | default: 'inherit'
  assign text_font = text_font_family | default: 'inherit'
  assign button_font = button_font_family | default: 'inherit'
  assign product_title_font = product_title_font_family | default: 'inherit'
  assign product_price_font = product_price_font_family | default: 'inherit'

  if subtitle_font == 'agrandir'
    assign subtitle_font_value = 'Agrandir'
  elsif subtitle_font == 'ss-bruney'
    assign subtitle_font_value = 'SS Bruney'
  elsif subtitle_font == 'facelio'
    assign subtitle_font_value = 'Facelio'
  elsif subtitle_font == 'fraunces'
    assign subtitle_font_value = 'var(--font-heading-family)'
  else
    assign subtitle_font_value = 'inherit'
  endif

  if title_font == 'agrandir'
    assign title_font_value = 'Agrandir'
  elsif title_font == 'ss-bruney'
    assign title_font_value = 'SS Bruney'
  elsif title_font == 'facelio'
    assign title_font_value = 'Facelio'
  elsif title_font == 'fraunces'
    assign title_font_value = 'var(--font-heading-family)'
  else
    assign title_font_value = 'inherit'
  endif

  if text_font == 'agrandir'
    assign text_font_value = 'Agrandir'
  elsif text_font == 'ss-bruney'
    assign text_font_value = 'SS Bruney'
  elsif text_font == 'facelio'
    assign text_font_value = 'Facelio'
  elsif text_font == 'fraunces'
    assign text_font_value = 'var(--font-heading-family)'
  else
    assign text_font_value = 'inherit'
  endif

  if button_font == 'agrandir'
    assign button_font_value = 'Agrandir'
  elsif button_font == 'ss-bruney'
    assign button_font_value = 'SS Bruney'
  elsif button_font == 'facelio'
    assign button_font_value = 'Facelio'
  elsif button_font == 'fraunces'
    assign button_font_value = 'var(--font-heading-family)'
  else
    assign button_font_value = 'inherit'
  endif

  if product_title_font == 'agrandir'
    assign product_title_font_value = 'Agrandir'
  elsif product_title_font == 'ss-bruney'
    assign product_title_font_value = 'SS Bruney'
  elsif product_title_font == 'facelio'
    assign product_title_font_value = 'Facelio'
  elsif product_title_font == 'fraunces'
    assign product_title_font_value = 'var(--font-heading-family)'
  else
    assign product_title_font_value = 'inherit'
  endif

  if product_price_font == 'agrandir'
    assign product_price_font_value = 'Agrandir'
  elsif product_price_font == 'ss-bruney'
    assign product_price_font_value = 'SS Bruney'
  elsif product_price_font == 'facelio'
    assign product_price_font_value = 'Facelio'
  elsif product_price_font == 'fraunces'
    assign product_price_font_value = 'var(--font-heading-family)'
  else
    assign product_price_font_value = 'inherit'
  endif

  if section.settings.background_image_mobile != blank
    assign mobile_bg_image = section.settings.background_image_mobile | image_url: width: 1200
  elsif section.settings.background_image != blank
    assign mobile_bg_image = section.settings.background_image | image_url: width: 1200
  else
    assign mobile_bg_image = nil
  endif

  if section.settings.mobile_paper_image != blank
    assign mobile_paper_src = section.settings.mobile_paper_image | image_url: width: 800
  else
    assign mobile_paper_src = nil
  endif

  if section.settings.paper_image_desktop != blank
    assign paper_desktop_src = section.settings.paper_image_desktop | image_url: width: 1200
  else
    assign paper_desktop_src = 'paper-overlay.png' | asset_url
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="hero-zoom-pop section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} featured-artisan spacing-style" style="
    {% render 'spacing-style', settings: section.settings %}
    --featured-artisan-overlay: {{ overlay_opacity }};
    --featured-artisan-bg-size: {{ section.settings.background_size }};
    --featured-artisan-bg-position: {{ section.settings.background_position }};
    --featured-artisan-subtitle-color: {{ section.settings.subtitle_color }};
    --featured-artisan-title-color: {{ section.settings.title_color }};
    --featured-artisan-text-color: {{ section.settings.text_color }};
    --featured-artisan-button-bg: {{ section.settings.button_bg_color }};
    --featured-artisan-button-color: {{ section.settings.button_text_color }};
    --featured-artisan-subtitle-font: {{ subtitle_font_value }};
    --featured-artisan-subtitle-size: {{ section.settings.subtitle_font_size }}px;
    --featured-artisan-subtitle-size-mobile: {{ section.settings.subtitle_font_size_mobile }}px;
    --featured-artisan-subtitle-weight: {{ section.settings.subtitle_font_weight }};
    --featured-artisan-title-font: {{ title_font_value }};
    --featured-artisan-title-size: {{ section.settings.title_font_size }}px;
    --featured-artisan-title-size-mobile: {{ section.settings.title_font_size_mobile }}px;
    --featured-artisan-title-weight: {{ section.settings.title_font_weight }};
    --featured-artisan-text-font: {{ text_font_value }};
    --featured-artisan-text-size: {{ section.settings.text_font_size }}px;
    --featured-artisan-text-weight: {{ section.settings.text_font_weight }};
    --featured-artisan-button-font: {{ button_font_value }};
    --featured-artisan-button-size: {{ section.settings.button_font_size }}px;
    --featured-artisan-button-weight: {{ section.settings.button_font_weight }};
    --featured-artisan-product-title-font: {{ product_title_font_value }};
    --featured-artisan-product-title-size: {{ section.settings.product_title_font_size }}px;
    --featured-artisan-product-title-weight: {{ section.settings.product_title_font_weight }};
    --featured-artisan-product-title-color: {{ section.settings.product_title_color | default: '#5D5C5A' }};
    --featured-artisan-product-price-font: {{ product_price_font_value }};
    --featured-artisan-product-price-size: {{ section.settings.product_price_font_size }}px;
    --featured-artisan-product-price-weight: {{ section.settings.product_price_font_weight }};
    --featured-artisan-product-price-color: {{ section.settings.product_price_color | default: '#969696' }};
    --featured-artisan-products-padding-top: {{ section.settings.products_padding_top }}px;
    --featured-artisan-products-padding-bottom: {{ section.settings.products_padding_bottom }}px;
    --featured-artisan-products-padding-left: {{ section.settings.products_padding_left }}px;
    --featured-artisan-products-padding-right: {{ section.settings.products_padding_right }}px;
    --featured-artisan-mobile-paper-max-width: {{ section.settings.mobile_paper_max_width }}px;
    {% if section.settings.section_height == 'custom' %}
      --featured-artisan-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height == 'full-screen' %}
      --featured-artisan-height: 100svh;
    {% elsif section.settings.section_height != blank and section.settings.section_height != '' %}
      --featured-artisan-height: var(--section-height-{{ section.settings.section_height }});
    {% else %}
      --featured-artisan-height: auto;
    {% endif %}
    {% if section.settings.background_image != blank %}
      --featured-artisan-bg-image: url('{{ section.settings.background_image | image_url: width: 2800 }}');
    {% else %}
      --featured-artisan-bg-image: none;
    {% endif %}
    {% if mobile_bg_image != nil %}
      --featured-artisan-bg-image-mobile: url('{{ mobile_bg_image }}');
    {% else %}
      --featured-artisan-bg-image-mobile: var(--featured-artisan-bg-image);
    {% endif %}
  ">
  <div class="featured-artisan__background"></div>
  {% if paper_desktop_src != blank %}
    <div class="featured-artisan__paper" aria-hidden="true">
      <img
        class="featured-artisan__paper-image"
        src="{{ paper_desktop_src }}"
        loading="lazy"
        alt=""
        width="1200"
        height="1200">
    </div>
  {% endif %}

  <div class="featured-artisan__inner">
    <div class="featured-artisan__content">
      {% if section.settings.subtitle != blank %}
        <p class="featured-artisan__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="featured-artisan__title">{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="featured-artisan__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <div class="featured-artisan__footer">
          <a
            {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
            {% else %}
            role="link"
            aria-disabled="true"
            {% endif %}
            class="featured-artisan__button">
            {{ section.settings.button_label }}
          </a>
        </div>
      {% endif %}
    </div>

    <div class="featured-artisan__products-wrap">
      <ul class="featured-artisan__products featured-artisan__products--desktop" role="list">
        <!-- Product 1 -->
        <li class="featured-artisan__item">
          {% if product_1 != blank %}
            {% assign collection_label_1 = product_1.metafields.custom.category.value %}
            <a href="{{ product_1.url }}" class="featured-artisan__card">
              <span class="featured-artisan__card-image-wrap">
                <div class="cardGalleryBorder">
                  <div class="cardGalleryBorder2">
                    <div class="cardGalleryBorder3">
                      {% if product_1.featured_image != blank %}
                        {{
                          product_1.featured_image | image_url: width: 600 | image_tag: class: 'featured-artisan__card-image', loading: 'lazy'
                        }}
                      {% else %}
                        <span class="featured-artisan__card-image featured-artisan__card-image--placeholder"></span>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </span>
              {% if collection_label_1 != blank %}
                <span class="featured-artisan__card-collection-label">{{ collection_label_1 }}</span>
              {% endif %}
              <span class="featured-artisan__card-title">{{ product_1.title }}</span>
              <span class="featured-artisan__card-price">{{ product_1.price | money }}</span>
            </a>
          {% else %}
            <div class="featured-artisan__card featured-artisan__card--placeholder">
              <span class="featured-artisan__card-image-wrap">
                <span class="featured-artisan__card-image featured-artisan__card-image--placeholder"></span>
              </span>
              <span class="featured-artisan__card-title">Product title</span>
              <span class="featured-artisan__card-price">{{ 1999 | money }}</span>
            </div>
          {% endif %}
        </li>

        <!-- Product 2 -->
        <li class="featured-artisan__item">
          {% if product_2 != blank %}
            {% assign collection_label_2 = product_2.metafields.custom.category.value %}
            <a href="{{ product_2.url }}" class="featured-artisan__card">
              <span class="featured-artisan__card-image-wrap">
                <div class="cardGalleryBorder">
                  <div class="cardGalleryBorder2">
                    <div class="cardGalleryBorder3">
                      {% if product_2.featured_image != blank %}
                        {{
                          product_2.featured_image | image_url: width: 600 | image_tag: class: 'featured-artisan__card-image', loading: 'lazy'
                        }}
                      {% else %}
                        <span class="featured-artisan__card-image featured-artisan__card-image--placeholder"></span>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </span>
              {% if collection_label_2 != blank %}
                <span class="featured-artisan__card-collection-label">{{ collection_label_2 }}</span>
              {% endif %}
              <span class="featured-artisan__card-title">{{ product_2.title }}</span>
              <span class="featured-artisan__card-price">{{ product_2.price | money }}</span>
            </a>
          {% else %}
            <div class="featured-artisan__card featured-artisan__card--placeholder">
              <span class="featured-artisan__card-image-wrap">
                <span class="featured-artisan__card-image featured-artisan__card-image--placeholder"></span>
              </span>
              <span class="featured-artisan__card-title">Product title</span>
              <span class="featured-artisan__card-price">{{ 1999 | money }}</span>
            </div>
          {% endif %}
        </li>
      </ul>

      <!-- Mobile with Products -->
      {% if mobile_paper_src != nil %}
        <div class="featured-artisan__mobile-paper">
          <img
            src="{{ mobile_paper_src }}"
            alt=""
            class="featured-artisan__mobile-paper-image"
            loading="lazy"
            width="800"
            height="auto">
          <div class="featured-artisan__mobile-paper-content">
            <ul class="featured-artisan__products featured-artisan__products--mobile" role="list">
              <!-- Product 1 (mobile) -->
              <li class="featured-artisan__item">
                {% if product_1 != blank %}
                  {% assign collection_label_1 = product_1.metafields.custom.collection.value %}
                  <a href="{{ product_1.url }}" class="featured-artisan__card">
                    <span class="featured-artisan__card-image-wrap">
                      <div class="cardGalleryBorder">
                        <div class="cardGalleryBorder2">
                          <div class="cardGalleryBorder3">
                            {% if product_1.featured_image != blank %}
                              {{
                                product_1.featured_image | image_url: width: 600 | image_tag: class: 'featured-artisan__card-image', loading: 'lazy'
                              }}
                            {% else %}
                              <span class="featured-artisan__card-image featured-artisan__card-image--placeholder"></span>
                            {% endif %}
                          </div>
                        </div>
                      </div>
                    </span>
                    {% if collection_label_1 != blank %}
                      <span class="featured-artisan__card-collection-label">{{ collection_label_1 }}</span>
                    {% endif %}
                    <span class="featured-artisan__card-title">{{ product_1.title }}</span>
                    <span class="featured-artisan__card-price">{{ product_1.price | money }}</span>
                  </a>
                {% else %}
                  <div class="featured-artisan__card featured-artisan__card--placeholder">
                    <span class="featured-artisan__card-image-wrap">
                      <span class="featured-artisan__card-image featured-artisan__card-image--placeholder"></span>
                    </span>
                    <span class="featured-artisan__card-title">Product title</span>
                    <span class="featured-artisan__card-price">{{ 1999 | money }}</span>
                  </div>
                {% endif %}
              </li>

              <!-- Product 2 (mobile) -->
              <li class="featured-artisan__item">
                {% if product_2 != blank %}
                  {% assign collection_label_2 = product_2.metafields.custom.collection.value %}
                  <a href="{{ product_2.url }}" class="featured-artisan__card">
                    <span class="featured-artisan__card-image-wrap">
                      <div class="cardGalleryBorder">
                        <div class="cardGalleryBorder2">
                          <div class="cardGalleryBorder3">
                            {% if product_2.featured_image != blank %}
                              {{
                                product_2.featured_image | image_url: width: 600 | image_tag: class: 'featured-artisan__card-image', loading: 'lazy'
                              }}
                            {% else %}
                              <span class="featured-artisan__card-image featured-artisan__card-image--placeholder"></span>
                            {% endif %}
                          </div>
                        </div>
                      </div>
                    </span>
                    {% if collection_label_2 != blank %}
                      <span class="featured-artisan__card-collection-label">{{ collection_label_2 }}</span>
                    {% endif %}
                    <span class="featured-artisan__card-title">{{ product_2.title }}</span>
                    <span class="featured-artisan__card-price">{{ product_2.price | money }}</span>
                  </a>
                {% else %}
                  <div class="featured-artisan__card featured-artisan__card--placeholder">
                    <span class="featured-artisan__card-image-wrap">
                      <span class="featured-artisan__card-image featured-artisan__card-image--placeholder"></span>
                    </span>
                    <span class="featured-artisan__card-title">Product title</span>
                    <span class="featured-artisan__card-price">{{ 1999 | money }}</span>
                  </div>
                {% endif %}
              </li>
            </ul>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  @font-face {
    font-family: 'Agrandir';
    src: url('https://cdn.shopify.com/s/files/1/0728/1321/5942/files/Agrandir-Regular.woff2?v=1771643523') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'SS Bruney';
    src: url('https://cdn.shopify.com/s/files/1/0728/1321/5942/files/SS_Bruney.woff2?v=1771643523') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Facelio';
    src: url('https://cdn.shopify.com/s/files/1/0728/1321/5942/files/Facelio.woff2?v=1771643523') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  .featured-artisan {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: var(--featured-artisan-height);
  }

  .featured-artisan__background {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    z-index: -1;
    background-image: var(--featured-artisan-bg-image);
    background-size: var(--featured-artisan-bg-size);
    background-position: var(--featured-artisan-bg-position);
    background-repeat: no-repeat;
  }

  .featured-artisan__background::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--featured-artisan-overlay));
  }

  .featured-artisan__paper {
    position: absolute;
    left: -50px;
    bottom: -70px;
    z-index: 0;
    width: 800px;
    pointer-events: none;
  }

  .featured-artisan__paper-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .featured-artisan__inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto 0 0;
    padding: 40px 24px 48px 48px;
    flex-direction: column;
    gap: 150px;
  }

  .featured-artisan__content {
    max-width: 560px;
    margin-bottom: 32px;
  }

  .featured-artisan__subtitle {
    margin: 0 0 8px;
    font-family: var(--featured-artisan-subtitle-font);
    font-size: var(--featured-artisan-subtitle-size);
    font-weight: var(--featured-artisan-subtitle-weight);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--featured-artisan-subtitle-color);
  }

  .featured-artisan__title {
    margin: 0 0 16px;
    font-family: var(--featured-artisan-title-font);
    font-size: var(--featured-artisan-title-size);
    font-weight: var(--featured-artisan-title-weight);
    line-height: 1.2;
    color: var(--featured-artisan-title-color);
  }
  @media screen and (max-width: 750px) {
    .featured-artisan__title {
      font-size: var(--featured-artisan-title-size-mobile);
    }
    .featured-artisan__subtitle {
      font-size: var(--featured-artisan-subtitle-size-mobile);
    }
  }
  .featured-artisan__text {
    margin: 0 0 24px;
    font-family: var(--featured-artisan-text-font);
    font-size: var(--featured-artisan-text-size);
    font-weight: var(--featured-artisan-text-weight);
    line-height: 1.6;
    color: var(--featured-artisan-text-color);
  }

  .featured-artisan__text p {
    margin: 0 0 0.5em;
  }

  .featured-artisan__text p:last-child {
    margin-bottom: 0;
  }

  .featured-artisan__footer {
    margin-top: 24px;
  }

  .featured-artisan__button {
    display: inline-flex;
    width: 220px;
    height: 47px;
    padding: 0 16px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    background: var(--featured-artisan-button-bg);
    color: var(--featured-artisan-button-color);
    border: 0;
    border-radius: 0;
    font-family: var(--featured-artisan-button-font);
    font-size: var(--featured-artisan-button-size);
    font-weight: var(--featured-artisan-button-weight);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .featured-artisan__button:hover {
    opacity: 0.9;
  }

  .featured-artisan__products-wrap {
    margin-top: 60px;
    padding: var(--featured-artisan-products-padding-top) var(--featured-artisan-products-padding-right) var(--featured-artisan-products-padding-bottom) var(--featured-artisan-products-padding-left);
  }

  .featured-artisan__products {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(2, minmax(0, 256px));
    max-width: 536px;
  }

  .featured-artisan__products--mobile {
    display: none;
  }

  .featured-artisan__item {
    min-width: 0;
  }

  .featured-artisan__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    max-width: 256px;
  }

  .featured-artisan__card-image-wrap {
    display: block;
    border: 1px solid rgba(104, 106, 84, 0.4);
    overflow: hidden;
  }

  .featured-artisan__card-image {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: rgba(255, 255, 255, 0.15);
  }

  .featured-artisan__card-image--placeholder {
    aspect-ratio: 1;
    display: block;
    background: #f5f5f5;
  }

  .featured-artisan__card-collection-label {
    color: #969696;
    font-family: Agrandir;
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    text-transform: uppercase;
    letter-spacing: 0.08em;

    display: none;
  }

  .featured-artisan__card-title {
    font-family: var(--featured-artisan-product-title-font);
    font-size: var(--featured-artisan-product-title-size);
    font-weight: var(--featured-artisan-product-title-weight);
    line-height: 1.3;
    color: var(--featured-artisan-product-title-color);
  }

  .featured-artisan__card-price {
    font-family: 'Agrandir';
    font-size: var(--featured-artisan-product-price-size);
    font-weight: var(--featured-artisan-product-price-weight);
    line-height: 1.3;
    color: var(--featured-artisan-product-price-color);
  }

  .featured-artisan__mobile-paper {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .featured-artisan__background {
      background-position: var(--featured-artisan-bg-position);
    }
  }

  @media screen and (max-width: 749px) {
    .featured-artisan {
      min-height: auto;
    }

    .featured-artisan__background {
      left: 0;
      width: 100%;
      margin-left: 0;
      background-size: cover;
      background-position: top center;
    }

    .featured-artisan__button {
      width: 180px;
    }

    .featured-artisan__inner {
      padding: 24px 16px 32px;
      gap: 12px;
      max-width: 100%;
    }

    .featured-artisan__paper {
      left: -60px;
      transform: none;
      bottom: 0;
      width: 760px;
    }

    .featured-artisan__paper-image {
      display: block;
      width: 56%;
      height: 250px;
    }

    .featured-artisan__mobile-paper {
      display: none;
    }

    .featured-artisan__content {
      padding: 180px 0 0;
      max-width: 55%;
      width: 75%;
    }

    .featured-artisan__text {
      margin-bottom: 12px;
    }

    .featured-artisan__footer {
      margin-top: 8px;
    }

    .featured-artisan__text p {
      font-size: 14px;
    }

    .featured-artisan__products-wrap {
      margin-top: 0;
      padding-top: 0;
    }

    .featured-artisan__products {
      justify-content: space-between;
      display: flex
    }
    span.featured-artisan__card-title {
    font-size: 16px;
}
span.featured-artisan__card-price {
    font-size: 14px;
}
    .featured-artisan__card {
      max-width: 160px;
    }
  }


  .featured-artisan__card-image-wrap .cardGalleryBorder,
  .featured-artisan__card-image-wrap .cardGalleryBorder3 {
    border: 10px solid #686A54;
  }
  .featured-artisan__card-image-wrap .cardGalleryBorder2 {
    border: 1px solid #ffffff;
  }
  @media screen and (max-width: 750px) {
    .featured-artisan__card-image-wrap .cardGalleryBorder,
    .featured-artisan__card-image-wrap .cardGalleryBorder3 {
      border: 5px solid #686A54;
    }
  }

  @media screen and (max-width: 480px) {
    .featured-artisan__mobile-paper-content {
      margin-top: -50px;
    }
  }
{% endstylesheet %}

<!-- Create a snippet for the product card to avoid duplication -->
{% comment %}
  Create a file called "featured-artisan-product-card.liquid" in the snippets folder with this content:
  {% assign product = product %}
  {% if product != blank %}
  {% assign collection_label = product.metafields.custom.collection.value %}
  <li class="featured-artisan__item">
  <a href="{{ product.url }}" class="featured-artisan__card">
  <span class="featured-artisan__card-image-wrap">
  {% if product.featured_image != blank %}
  {{
  product.featured_image
  | image_url: width: 600
  | image_tag: class: 'featured-artisan__card-image', loading: 'lazy'
  }}
  {% else %}
  <span class="featured-artisan__card-image featured-artisan__card-image--placeholder"></span>
  {% endif %}
  </span>
  {% if collection_label != blank %}
  <span class="featured-artisan__card-collection-label">{{ collection_label }}</span>
  {% endif %}
  <span class="featured-artisan__card-title">{{ product.title }}</span>
  <span class="featured-artisan__card-price">{{ product.price | money }}</span>
  </a>
  </li>
  {% else %}
  <li class="featured-artisan__item">
  <div class="featured-artisan__card featured-artisan__card--placeholder">
  <span class="featured-artisan__card-image-wrap">
  <span class="featured-artisan__card-image featured-artisan__card-image--placeholder"></span>
  </span>
  <span class="featured-artisan__card-title">Product title</span>
  <span class="featured-artisan__card-price">{{ 1999 | money }}</span>
  </div>
  </li>
  {% endif %}
{% endcomment %}

