{% liquid
  assign bg_image = section.settings.background_image
%}

<section class="values" 
  style="
    {% if bg_image != blank %}
      background-image: url({{ bg_image | image_url: width: 2000 }});
    {% endif %}
  "
>
  <div class="values__container">

    <div class="values__header">
      <h2 class="values__heading" style="
        color: {{ section.settings.heading_color }};
        font-size: {{ section.settings.heading_font_size }}px;
        font-weight: {{ section.settings.heading_font_weight }};
        font-family: {{ section.settings.heading_font_family }};
        letter-spacing: {{ section.settings.heading_letter_spacing }}px;
      ">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="values__grid" style="
      justify-content: center;
      grid-template-columns: repeat({{ section.blocks.size }}, minmax(200px, 280px));
    ">
      {% for block in section.blocks %}
        <div class="values__item" {{ block.shopify_attributes }}>

          {% if block.settings.icon != blank %}
            <div 
              class="values__icon"
              style="
                height: {{ section.settings.icon_area_height }}px;
                margin-bottom: {{ section.settings.icon_spacing_bottom }}px;
              "
            >
              <img 
                src="{{ block.settings.icon | image_url: width: 400 }}" 
                alt="{{ block.settings.title | escape }}"
                style="
                  width: {{ block.settings.icon_width }}px;
                  max-width: 100%;
                "
              >
            </div>
          {% endif %}

          <h3 class="values__title" style="
            color: {{ block.settings.title_color }};
            font-size: {{ block.settings.title_font_size }}px;
            font-weight: {{ block.settings.title_font_weight }};
            font-family: {{ block.settings.title_font_family }};
            letter-spacing: {{ block.settings.title_letter_spacing }}px;
          ">
            {{ block.settings.title }}
          </h3>

          <p class="values__text" style="
            color: {{ block.settings.text_color }};
            font-size: {{ block.settings.text_font_size }}px;
            font-weight: {{ block.settings.text_font_weight }};
            font-family: {{ block.settings.text_font_family }};
            line-height: {{ block.settings.text_line_height }};
          ">
            {{ block.settings.text }}
          </p>

        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
.values {
  background-size: cover;
  background-position: center;
  padding: 80px 20px;
}

.values__container {
  max-width: 1440px;
  margin: 0 auto;
  text-align: center;
}

.values__header {
  margin-bottom: 60px;
}

.values__grid {
  display: grid;
  gap: 40px;
  margin: 0 auto;
}

.values__item {
  padding: 0 20px;
  position: relative;
}

.values__item:not(:last-child)::after {
  content: "";
  position: absolute;
  top: 10%;
  right: 0;
  width: 1px;
  height: 80%;
  background: rgba(0,0,0,0.08);
}

.values__icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.values__icon img {
  height: 100%;
  max-height: 100%;
  object-fit: contain;
  display: block;
  margin: 0 auto;
}

.values__title {
  margin: 0 0 16px;
}

.values__text {
  margin: 0;
}

@media screen and (max-width: 1024px) {
  .values__grid {
    grid-template-columns: repeat(2, minmax(200px, 280px)) !important;
    gap: 30px;
  }

  .values__item::after {
    display: none;
  }
}

@media screen and (max-width: 600px) {
  .values__grid {
    grid-template-columns: minmax(200px, 280px) !important;
  }
}
</style>

{% schema %}
{
  "name": "Values Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHAT WE STAND FOR"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "header",
      "content": "Heading Style"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#5b5b4f"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading Font Size (px)",
      "min": 12,
      "max": 100,
      "step": 1,
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_font_weight",
      "label": "Heading Font Weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 400
    },
    {
      "type": "text",
      "id": "heading_font_family",
      "label": "Heading Font Family",
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading Letter Spacing (px)",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 2
    },
    {
      "type": "header",
      "content": "Icon Layout"
    },
    {
      "type": "range",
      "id": "icon_area_height",
      "label": "Icon Area Height (px)",
      "min": 60,
      "max": 220,
      "step": 5,
      "default": 120
    },
    {
      "type": "range",
      "id": "icon_spacing_bottom",
      "label": "Space Below Icon (px)",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
{
  "type": "range",
  "id": "icon_width",
  "label": "Icon Width (px)",
  "min": 40,
  "max": 180,
  "step": 2,
  "default": 112
},
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Value Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Value description goes here."
        },
        {
          "type": "header",
          "content": "Title Style"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#5b5b4f"
        },
        {
          "type": "range",
          "id": "title_font_size",
          "label": "Title Font Size (px)",
          "min": 12,
          "max": 60,
          "step": 1,
          "default": 20
        },
        {
          "type": "range",
          "id": "title_font_weight",
          "label": "Title Font Weight",
          "min": 100,
          "max": 900,
          "step": 100,
          "default": 700
        },
        {
          "type": "text",
          "id": "title_font_family",
          "label": "Title Font Family",
          "default": "inherit"
        },
        {
          "type": "range",
          "id": "title_letter_spacing",
          "label": "Title Letter Spacing (px)",
          "min": 0,
          "max": 10,
          "step": 0.5,
          "default": 0
        },
        {
          "type": "header",
          "content": "Description Style"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Description Color",
          "default": "#7a7a7a"
        },
        {
          "type": "range",
          "id": "text_font_size",
          "label": "Description Font Size (px)",
          "min": 10,
          "max": 40,
          "step": 1,
          "default": 14
        },
        {
          "type": "range",
          "id": "text_font_weight",
          "label": "Description Font Weight",
          "min": 100,
          "max": 900,
          "step": 100,
          "default": 400
        },
        {
          "type": "text",
          "id": "text_font_family",
          "label": "Description Font Family",
          "default": "inherit"
        },
        {
          "type": "range",
          "id": "text_line_height",
          "label": "Description Line Height",
          "min": 1,
          "max": 3,
          "step": 0.1,
          "default": 1.6
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Values Section",
      "blocks": [
        { "type": "value" },
        { "type": "value" },
        { "type": "value" },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}