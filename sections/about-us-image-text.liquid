{% liquid
  assign section_height = section.settings.section_height
  assign section_height_mobile = section.settings.section_height_mobile
  assign layout = section.settings.layout
  assign content_width = section.settings.content_width

  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif

  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif
%}

<section class="arte-curated {% if layout == 'image_first' %}arte-curated--reverse{% endif %}"
  style="
    --section-height: {{ section_height }}vh;
    --section-height-mobile: {{ section_height_mobile }}vh;
    --heading-size: {{ section.settings.heading_size }}px;
    --heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --text-size: {{ section.settings.text_size }}px;
    --text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --icon-size: {{ section.settings.icon_size }}px;
    --icon-size-mobile: {{ section.settings.icon_size_mobile }}px;
    --heading-color: {{ section.settings.heading_color }};
    --text-color: {{ section.settings.text_color }};
    --font-heading: {{ section.settings.heading_font }};
    --font-text: {{ section.settings.text_font }};
    --content-width: {{ content_width }}%;
  "
>
  <div class="arte-curated__wrapper"
    style="
      {% if section.settings.bg_image != blank %}
        background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      {% else %}
        background-color: {{ section.settings.bg_color }};
      {% endif %}
    "
  >

    {% if has_blocks %}
      <div class="arte-curated__content {% unless has_image %}arte-curated__content--full{% endunless %}"
        style="--content-width: {{ content_width }}%;"
      >
        {% for block in section.blocks %}
          <div class="arte-curated__block">
            
            {% if block.settings.icon != blank %}
              <img 
                src="{{ block.settings.icon | image_url: width: 200 }}" 
                class="arte-curated__icon"
                alt="icon"
                loading="lazy"
              >
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2 class="arte-curated__heading">
                {{ block.settings.heading }}
              </h2>
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="arte-curated__text">
                {{ block.settings.text }}
              </p>
            {% endif %}

          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if has_image %}
      <div class="arte-curated__media {% unless has_blocks %}arte-curated__media--full{% endunless %}">
        <img 
          src="{{ section.settings.image | image_url: width: section.settings.image_width | default: 1500 }}" 
          class="arte-curated__image"
          alt="{{ section.settings.image.alt | escape }}"
          style="
            object-fit: {{ section.settings.image_fit }};
            object-position: {{ section.settings.image_position }};
          "
          loading="lazy"
        >
      </div>
    {% endif %}

  </div>
</section>

<style>
.arte-curated {
  width: 100%;
}

.arte-curated__wrapper {
  display: flex;
  align-items: center;
  min-height: var(--section-height);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.arte-curated--reverse .arte-curated__wrapper {
  flex-direction: row-reverse;
}

.arte-curated__content {
  width: var(--content-width, 50%);
  padding: 60px;
}

.arte-curated__media {
  width: calc(100% - var(--content-width, 50%));
  height: var(--section-height);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.arte-curated__media--full {
  width: 100%;
}

.arte-curated__content--full {
  width: 100%;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
}

.arte-curated__content--full .arte-curated__block {
  max-width: var(--content-width, 50%);
  margin: 0 auto;
}

.arte-curated__block {
  max-width: 100%;
  margin: 0 auto;
}

.arte-curated__icon {
  width: var(--icon-size);
  height: auto;
  margin-bottom: 16px;
  display: block;
}

.arte-curated__heading {
  font-size: var(--heading-size);
  color: var(--heading-color);
  font-family: var(--font-heading);
  margin-bottom: 16px;
  font-weight: normal;
}

.arte-curated__text {
  font-size: var(--text-size);
  color: var(--text-color);
  font-family: var(--font-text);
  line-height: 1.6;
}

.arte-curated__image {
  width: 100%;
  height: 100%;
  display: block;
}

@media screen and (max-width: 768px) {
  .arte-curated__wrapper {
    flex-direction: column;
    min-height: var(--section-height-mobile);
  }

  .arte-curated__content {
    width: 100% !important;
    padding: 32px 20px;
    text-align: center;
  }

  .arte-curated__media {
    width: 100% !important;
    height: auto;
    min-height: 300px;
  }

  .arte-curated__content--full .arte-curated__block {
    max-width: 100%;
  }

  .arte-curated__image {
    height: auto;
    max-height: 400px;
    width: 100%;
  }

  .arte-curated__icon {
    width: var(--icon-size-mobile, var(--icon-size));
  }

  .arte-curated__heading {
    font-size: var(--heading-size-mobile, var(--heading-size));
  }

  .arte-curated__text {
    font-size: var(--text-size-mobile, var(--text-size));
  }
}

@media screen and (max-width: 480px) {
  .arte-curated__content {
    padding: 24px 16px;
  }

  .arte-curated__media {
    min-height: 250px;
  }

  .arte-curated__image {
    max-height: 300px;
  }
}
</style>

{% schema %}
{
  "name": "About Us Image Text",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Height (Desktop)",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 70,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "label": "Section Height (Mobile)",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 60,
      "unit": "vh"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout Order",
      "options": [
        { "value": "text_first", "label": "Text First" },
        { "value": "image_first", "label": "Image First" }
      ],
      "default": "text_first"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content Block Width (%)",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 50,
      "info": "When an image is selected, this controls how much space the content takes. When no image is selected, this controls the max-width of the centered content."
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Image Width",
      "options": [
        { "value": "500", "label": "Small (500px)" },
        { "value": "1000", "label": "Medium (1000px)" },
        { "value": "1500", "label": "Large (1500px)" },
        { "value": "2000", "label": "Extra Large (2000px)" }
      ],
      "default": "1500"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" },
        { "value": "fill", "label": "Fill" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#8b8f78"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (overrides color)"
    },
    {
      "type": "header",
      "content": "Typography - Desktop"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size (Desktop)",
      "min": 18,
      "max": 72,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Size (Desktop)",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size (Desktop)",
      "min": 16,
      "max": 120,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography - Mobile"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size (Mobile)",
      "min": 18,
      "max": 72,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text Size (Mobile)",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Icon Size (Mobile)",
      "min": 16,
      "max": 120,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography Colors & Fonts"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f1f1f1"
    },
    {
      "type": "text",
      "id": "heading_font",
      "label": "Heading Font Family",
      "default": "Georgia, Times, serif",
      "info": "Enter the font family name (e.g., 'Arial, sans-serif' or 'Playfair Display, serif')"
    },
    {
      "type": "text",
      "id": "text_font",
      "label": "Text Font Family",
      "default": "Helvetica, Arial, sans-serif",
      "info": "Enter the font family name (e.g., 'Arial, sans-serif' or 'Open Sans, sans-serif')"
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Content Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "CURATED BY A FIRST GENERATION FILIPINA"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Your description here..."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us Image Text",
      "blocks": [
        {
          "type": "content"
        }
      ]
    }
  ]
}
{% endschema %}