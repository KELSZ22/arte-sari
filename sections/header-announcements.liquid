{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} announcement-bar--{{ section.settings.position_mode }}"
  style="
    {% render 'spacing-padding', settings: section.settings %};
    --border-bottom-width: {{ section.settings.divider_width }}px;
    {% if section.settings.position_mode == 'fixed' %}
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: var(--color-background);
      z-index: 100;
    {% elsif section.settings.position_mode == 'sticky' %}
      position: sticky;
      top: 0;
      z-index: 100;
    {% endif %}
  "
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides">
      {% content_for 'blocks' %}
    </div>
  </announcement-bar-component>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    transition: transform 0.2s ease;
  }

  .announcement-bar--sticky {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .announcement-bar--sticky.hide-on-scroll {
    transform: translateY(-100%);
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: auto;
    max-width: 680px;
    margin-inline: 0;
    order: 2;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
    display: contents;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
    position: static !important;
    transform: none !important;
  }

  .announcement-bar__slider .slideshow-control--previous {
    order: 1;
  }

  .announcement-bar__slider .slideshow-control--next {
    order: 3;
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;
    flex-shrink: 0;
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: 10px;
    height: 10px;
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper svg {
    width: 10px;
    height: 10px;
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }
{% endstylesheet %}

<script>
  (function() {
    function adjustHeaderPosition() {
      const announcementBar = document.querySelector('.announcement-bar--fixed, .announcement-bar--sticky');
      const header = document.querySelector('header, .header, [data-header]'); 
      
      if (!announcementBar || !header) return;
      
      const announcementBarHeight = announcementBar.offsetHeight;
      
      if (announcementBar.classList.contains('announcement-bar--fixed')) {

        header.style.marginTop = `${announcementBarHeight}px`;
        document.body.style.paddingTop = '0';
      } else if (announcementBar.classList.contains('announcement-bar--sticky')) {

        header.style.marginTop = '0';
        
        let lastScrollTop = 0;
        const scrollThreshold = 10;
        
        window.addEventListener('scroll', function() {
          const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
          
          if (Math.abs(lastScrollTop - scrollTop) <= scrollThreshold) return;
          
          if (scrollTop > lastScrollTop && scrollTop > announcementBarHeight) {
         
            announcementBar.classList.add('hide-on-scroll');
          } else {
            announcementBar.classList.remove('hide-on-scroll');
          }
          
          lastScrollTop = scrollTop;
        });
      }
    }
    
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', adjustHeaderPosition);
    } else {
      adjustHeaderPosition();
    }
    
    window.addEventListener('resize', adjustHeaderPosition);
  })();
</script>

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "position_mode",
      "label": "Position mode",
      "info": "Choose how the announcement bar behaves on scroll",
      "options": [
        {
          "value": "static",
          "label": "Static (scrolls with page)"
        },
        {
          "value": "sticky",
          "label": "Sticky (sticks to top, hides on scroll down)"
        },
        {
          "value": "fixed",
          "label": "Fixed (always visible at top)"
        }
      ],
      "default": "static"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-4",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}