{% liquid
  assign testimonial_blocks = section.blocks | where: 'type', 'testimonial'
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="hero-zoom-pop section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} testimonials spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --testimonials-heading-color: {{ section.settings.heading_color }};
    --testimonials-text-color: {{ section.settings.text_color }};
    --testimonials-name-color: {{ section.settings.name_color }};
    --testimonials-overlay-color: {{ section.settings.overlay_text_color }};
    --testimonials-button-bg: {{ section.settings.button_bg_color }};
    --testimonials-button-color: {{ section.settings.button_text_color }};
  "
>
  <div class="testimonials__inner">
    {% if section.settings.heading != blank %}
      <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if testimonial_blocks.size > 0 %}
      <div class="testimonials__grid slide-up-animation">
        {% for block in testimonial_blocks %}
          <div class="testimonials__item" {{ block.shopify_attributes }}>
            <div class="testimonials__card">
              {% if block.settings.image != blank %}
                <div class="testimonials__image-wrap">
                  {{
                    block.settings.image
                    | image_url: width: 400
                    | image_tag: class: 'testimonials__image', loading: 'lazy'
                  }}
                  {% if block.settings.overlay_text != blank %}
                    <span class="testimonials__overlay-text">{{ block.settings.overlay_text }}</span>
                  {% endif %}
                </div>
              {% else %}
                <div class="testimonials__image-wrap testimonials__image-wrap--placeholder">
                  <span class="testimonials__placeholder">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</span>
                </div>
              {% endif %}

              {% if block.settings.testimonial != blank %}
                <p class="testimonials__text">{{ block.settings.testimonial }}</p>
              {% endif %}

              {% if block.settings.name != blank %}
                <p class="testimonials__name">{{ block.settings.name }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <div class="testimonials__footer">
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
          class="testimonials__button"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .testimonials {
    position: relative;
  }

  .testimonials__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .testimonials__heading {
    margin: 0 0 40px;
    font-size: clamp(1.5rem, 3vw, 3rem);
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
    color: var(--testimonials-heading-color);
    font-family: 'Facelio';
  }

  .testimonials__grid {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
    margin-bottom: 48px;
  }

  .testimonials__item {
    min-width: 0;
  }

  .testimonials__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .testimonials__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.05);
  }

  .testimonials__image-wrap--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.05);
  }

  .testimonials__image {
    width: 100%;
    height: 100%;
    object-fit: fill;
    display: block;
  }

  .testimonials__placeholder {
    opacity: 0.3;
  }

  .testimonials__placeholder .placeholder-svg {
    width: 80px;
    height: 80px;
  }

  .testimonials__overlay-text {
    position: absolute;
    bottom: 12px;
    left: 12px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--testimonials-overlay-color);
    background: rgba(255, 255, 255, 0.9);
    padding: 4px 8px;
  }

  .testimonials__text {
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--testimonials-text-color);
  }

  .testimonials__name {
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--testimonials-name-color);
    font-family: 'Agrandir';
  }

  .testimonials__footer {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 32px;
  }

  .testimonials__button {
    display: flex;
    width: 220px;
    height: 47px;
    padding: 0 16px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    background: var(--testimonials-button-bg);
    color: var(--testimonials-button-color);
    border: 0;
    border-radius: 0;
    font: inherit;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    font-family: 'Agrandir';
  }

  .testimonials__button:hover {
    opacity: 0.9;
  }

  @media screen and (min-width: 750px) {
    .testimonials__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 768px) {
    .testimonials__grid {
      display: grid;
    gap: 24px;
    grid-template-columns: 2fr 2fr;
    margin-bottom: 48px;
    }
    .testimonials__button {
      width: auto;
      max-width: 100%;
      min-height: 47px;
      height: auto;
      white-space: nowrap;
      padding-left: 16px;
      padding-right: 16px;
      font-size: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "class": "testimonials-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "overlay_text",
          "label": "Overlay text on image",
          "info": "Optional text to display on the bottom-left of the image"
        },
        {
          "type": "textarea",
          "id": "testimonial",
          "label": "Testimonial",
          "default": "I super love these pearl necklaces and wear them almost everyday!"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "- Kris"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Take it from them"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#5D5C5A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Testimonial text color",
      "default": "#5D5C5A"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name color",
      "default": "#5D5C5A"
    },
    {
      "type": "color",
      "id": "overlay_text_color",
      "label": "Overlay text color",
      "default": "#5D5C5A"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#686A54"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
