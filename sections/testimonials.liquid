        "testimonial_1": {
          "type": "testimonial",
          "settings": {
            "testimonial": "I super love these pearl necklaces and wear them almost everyday!",
            "name": "- Kris"
          }
        },
        "testimonial_2": {
          "type": "testimonial",
          "settings": {
            "testimonial": "I super love these pearl necklaces and wear them almost everyday!",
            "name": "- Kris"
          }
        },
        "testimonial_3": {
          "type": "testimonial",
          "settings": {
            "testimonial": "I super love these pearl necklaces and wear them almost everyday!",
            "name": "- Kris"
          }
        },
        "testimonial_4": {
          "type": "testimonial",
          "settings": {
            "testimonial": "I super love these pearl necklaces and wear them almost everyday!",
            "name": "- Kris"
          }
        }
      },
      "block_order": ["testimonial_1", "testimonial_2", "testimonial_3", "testimonial_4"]
